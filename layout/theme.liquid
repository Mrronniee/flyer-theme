<!doctype html>
<html class="no-js" lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    {%- comment -%}
      Set before the first paint: what JavaScript will change (slideshow track,
      controls, buttons that only serve without JS) takes its final layout at
      once, so nothing jumps when the scripts run (layout shift).
    {%- endcomment -%}
    <script>
      document.documentElement.classList.replace('no-js', 'js');
    </script>
    <meta name="viewport" content="width=device-width, initial-scale=1">
    {%- assign default_scheme = settings.color_schemes | first -%}
    <meta name="theme-color" content="{{ default_scheme.settings.background }}">

    {% render 'css-variables' %}

    {%- comment -%}
      No preconnect: font_url serves the fonts from the store's own domain
      (/cdn/fonts/), and a hint to fonts.shopifycdn.com opened a connection
      that nothing used.
    {%- endcomment -%}
    {% unless settings.type_body_font.system? %}
      {{ settings.type_body_font | font_url | preload_tag: as: 'font', crossorigin: 'anonymous' }}
    {% endunless %}
    {%- comment -%}
      Headings are usually the largest contentful paint; without this preload
      the h1 waits for the heading face after the stylesheet has been parsed.
    {%- endcomment -%}
    {% unless settings.type_heading_font.system? or settings.type_heading_font == settings.type_body_font %}
      {{ settings.type_heading_font | font_url | preload_tag: as: 'font', crossorigin: 'anonymous' }}
    {% endunless %}

    {%- comment -%}
      No preload hint on the stylesheet: it is render-blocking in the <head>
      anyway, and two preloads at most (the fonts) keep the LCP image ahead.
    {%- endcomment -%}
    {{ 'critical.css' | asset_url | stylesheet_tag }}

    {% if settings.wishlist_enabled %}
      <script src="{{ 'wishlist.js' | asset_url }}" defer></script>
    {% endif %}
    {% if settings.quick_view_enabled %}
      <script src="{{ 'quick-view.js' | asset_url }}" defer></script>
    {% endif %}

    {% if settings.favicon %}
      <link rel="icon" href="{{ settings.favicon | image_url: width: 32, height: 32 }}">
    {% else %}
      {%- comment -%} Stops browsers requesting /favicon.ico (a 404 on every page). {%- endcomment -%}
      {%- assign empty_icon = 'data:,' -%}
      <link rel="icon" href="{{ empty_icon }}">
    {% endif %}

    {% render 'meta-tags' %}

    {{ content_for_header }}
  </head>

  <body{% if settings.section_numbering %} class="fl-numbered"{% endif %}>
    <a href="#MainContent" class="skip-link">{{ 'accessibility.skip_to_content' | t }}</a>

    {% sections 'header-group' %}

    <main id="MainContent" role="main" tabindex="-1">
      {{ content_for_layout }}
    </main>

    {% sections 'footer-group' %}

    {% if settings.cart_type == 'drawer' and template.name != 'cart' %}
      {% section 'cart-drawer' %}
    {% endif %}

    {% if settings.quick_view_enabled %}
      {% render 'quick-view-dialog' %}
    {% endif %}
    {% render 'autofocus-fallback' %}
    {% render 'rte-tables' %}

    {%- if request.design_mode -%}
      <script>
        // Theme editor: the block the merchant picks is shown, whatever the
        // section. A FAQ answer or a collapsible row opens (closed <details>),
        // and a rail that scrolls sideways (collections, lookbook,
        // testimonials) brings the block into view. The slideshow and the
        // announcement bar move to their own slide in their own handler.
        document.addEventListener('shopify:block:select', function (event) {
          var block = event.target;
          if (!block || !block.getElementsByTagName) return;
          if (block.tagName === 'DETAILS') block.open = true;
          Array.prototype.forEach.call(block.getElementsByTagName('details'), function (details) {
            details.open = true;
          });
          if (block.scrollIntoView) block.scrollIntoView({ block: 'nearest', inline: 'center' });
        });
      </script>
    {%- endif -%}
  </body>
</html>
