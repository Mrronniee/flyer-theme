    "faq": {
      "type": "faq",
      "blocks": {
        "faq-1": {
          "type": "question",
          "settings": {
            "question": "How long does shipping take?",
            "answer": "<p>Orders ship within 1–2 business days. Standard delivery takes 3–5 business days; express delivery arrives in 1–2. You’ll receive a tracking link by email as soon as your parcel leaves us.</p>"
          }
        },
        "faq-2": {
          "type": "question",
          "settings": {
            "question": "What is your return policy?",
            "answer": "<p>You have 30 days from delivery to return any unworn item in its original packaging. Start a return from your account page and we’ll email you a prepaid label. Refunds are issued within 5 days of receiving the parcel.</p>"
          }
        },
        "faq-3": {
          "type": "question",
          "settings": {
            "question": "How do I choose the right size?",
            "answer": "<p>Every product page has a size guide with measurements in centimetres and inches. Our pieces fit true to size; if you are between two sizes, we recommend taking the larger one.</p>"
          }
        },
        "faq-4": {
          "type": "question",
          "settings": {
            "question": "Which payment methods do you accept?",
            "answer": "<p>We accept Visa, Mastercard, American Express, PayPal, Apple Pay, Google Pay and Shop Pay. All payments are encrypted and processed securely at checkout.</p>"
          }
        },
        "faq-5": {
          "type": "question",
          "settings": {
            "question": "How can I contact you?",
            "answer": "<p>Write to us through the contact page or reply to any of our emails. We answer every message within one business day, Monday to Friday.</p>"
          }
        }
      },
      "block_order": [
        "faq-1",
        "faq-2",
        "faq-3",
        "faq-4",
        "faq-5"
      ],
      "settings": {
        "open_first": true
      }
    }
  },
  "order": [
    "banner",
    "featured",
    "trust",
    "image-with-text",
    "testimonials",
    "faq",
    "newsletter"
  ]
}