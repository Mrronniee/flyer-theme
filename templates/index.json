          "settings": {
            "heading": "New season, clean lines",
            "heading_tag": "h1",
            "heading_size": "large"
          }
        },
        "text": {
          "type": "text",
          "settings": {
            "text": "Everyday pieces made to last."
          }
        },
        "buttons": {
          "type": "buttons",
          "settings": {
            "button_label_1": "Shop all",
            "button_link_1": "shopify://collections/all"
          }
        }
      },
      "block_order": [
        "heading",
        "text",
        "buttons"
      ],
      "settings": {
        "height": "medium",
        "overlay_opacity": 20,
        "content_position": "middle-center"
      }
    },
    "featured": {
      "type": "featured-collection",
      "settings": {
        "heading": "Featured collection",
        "products_to_show": 8,
        "cols_desktop": "4",
        "show_view_all": true
      }
    },
    "image-with-text": {
      "type": "image-with-text",
      "blocks": {
        "heading": {
          "type": "heading",
          "settings": {
