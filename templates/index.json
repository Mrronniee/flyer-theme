    "testimonials": {
      "type": "testimonials",
      "blocks": {
        "testimonials-1": {
          "type": "testimonial",
          "settings": {
            "quote": "The quality is exactly what I hoped for. Delivered in three days, beautifully packed.",
            "author": "Camille R.",
            "detail": "Verified buyer, Lyon",
            "rating": 5
          }
        },
        "testimonials-2": {
          "type": "testimonial",
          "settings": {
            "quote": "I ordered the wrong size and the exchange took one email. That kind of service keeps me coming back.",
            "author": "Thomas B.",
            "detail": "Verified buyer, Brussels",
            "rating": 5
          }
        },
        "testimonials-3": {
          "type": "testimonial",
          "settings": {
            "quote": "Six months of daily wear and it still looks new. Worth every cent.",
            "author": "Ana M.",
            "detail": "Verified buyer, Lisbon",
            "rating": 4
          }
        }
      },
      "block_order": [
        "testimonials-1",
        "testimonials-2",
        "testimonials-3"
      ],
      "settings": {}
