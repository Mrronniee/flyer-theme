{
  "sections": {
    "featured": {
      "type": "featured-collection",
      "settings": {
        "products_to_show": 8,
        "cols_desktop": "4",
        "show_view_all": true,
        "layout": "grid"
      }
    },
    "image-with-text": {
      "type": "image-with-text",
      "blocks": {
        "heading": {
          "type": "heading",
          "settings": {
            "heading": "Made with care"
          }
        },
        "text": {
          "type": "text",
          "settings": {
            "text": "<p>Tell customers where your products come from, who makes them, and why that matters. A short paragraph goes a long way.</p>"
          }
        },
        "button": {
          "type": "button",
          "settings": {
            "label": "Our story",
            "style": "secondary"
          }
        }
      },
      "block_order": [
        "heading",
        "text",
        "button"
      ],
      "settings": {
        "layout": "image_first",
        "image_ratio": "adapt"
      }
    },
    "newsletter": {
      "type": "newsletter",
      "settings": {
        "heading": "Stay in the loop",
        "text": "<p>New arrivals and occasional news. No spam.</p>"
      }
    },
    "trust": {
      "type": "trust-badges",
      "blocks": {
        "trust-1": {
          "type": "badge",
          "settings": {
            "icon": "truck",
            "heading": "Shipping",
            "text": "Describe your delivery options."
          }
        },
        "trust-2": {
          "type": "badge",
          "settings": {
            "icon": "return",
            "heading": "Returns",
            "text": "Describe your returns policy."
          }
        },
        "trust-3": {
          "type": "badge",
          "settings": {
            "icon": "lock",
            "heading": "Secure checkout",
            "text": "Payments are encrypted at checkout."
          }
        },
        "trust-4": {
          "type": "badge",
          "settings": {
            "icon": "leaf",
            "heading": "Our story",
            "text": "Tell customers what makes your store different."
          }
        }
      },
      "block_order": [
        "trust-1",
        "trust-2",
        "trust-3",
        "trust-4"
      ],
      "settings": {}
    },
    "testimonials": {
      "type": "testimonials",
