    "faq": {
      "type": "faq",
      "blocks": {
        "faq-1": {
          "type": "question",
          "settings": {
            "question": "How long does shipping take?",
            "answer": "<p>Explain when orders leave and how long delivery takes, and how customers can track their parcel.</p>"
          }
        },
        "faq-2": {
          "type": "question",
          "settings": {
            "question": "What is your return policy?",
            "answer": "<p>Describe your return conditions and how customers can start a return.</p>"
          }
        },
        "faq-3": {
          "type": "question",
          "settings": {
            "question": "How do I choose the right size?",
            "answer": "<p>Every product page has a size guide with measurements in centimetres and inches. Our pieces fit true to size; if you are between two sizes, we recommend taking the larger one.</p>"
          }
        },
        "faq-4": {
          "type": "question",
          "settings": {
            "question": "Which payment methods do you accept?",
            "answer": "<p>List the payment methods your store accepts at checkout.</p>"
          }
        },
        "faq-5": {
          "type": "question",
          "settings": {
            "question": "How can I contact you?",
            "answer": "<p>Tell customers how to reach you and when they can expect a reply.</p>"
          }
        }
      },
      "block_order": [
        "faq-1",
        "faq-2",
        "faq-3",
        "faq-4",
        "faq-5"
      ],
      "settings": {
        "open_first": true
      }
    },
    "hero": {
      "type": "hero-split",
      "settings": {
