{% doc %}
  Full-screen search overlay (top sheet) with predictive search results.
  Custom element <fl-search> fetches the Predictive Search JSON API
  (products, pages, articles, query suggestions) and renders grouped
  results with product thumbnails and prices.

  Theme settings honoured:
  - Search > Enable search suggestions — when off, no JSON request is ever
    made and the overlay is just a field that submits to the search page.
  - Search > Show vendor / Show price — what each product result shows.

  Opening: any element with [data-search-open] anywhere in the document
  opens the overlay (delegated click listener). Focus is trapped while
  open; ESC, the close button, or the scrim close it.

  No-JS fallback: the header's [data-search-open] trigger is a button that
  is hidden without JS, where a real link to routes.search_url stands in;
  the input lives in a GET form pointing to the search page.

  @example
  {% render 'search-overlay' %}
{% enddoc %}

{%- liquid
  assign predictive = settings.predictive_search_enabled
  # Same resolution as snippets/price.liquid: suggestion prices must match
  # the server-rendered cards when "Show currency codes" is on. A sample
  # amount (1,234,567.89) goes through the same money filter, so it carries
  # the currency the visitor browses in (symbol, code, separators, decimals);
  # shop.money_format is the store currency's format, which put the store
  # symbol next to amounts converted for another market.
  if settings.currency_code_enabled
    assign money_sample = 123456789 | money_with_currency | strip_html
  else
    assign money_sample = 123456789 | money | strip_html
  endif
-%}

<fl-search
  class="fl-search"
  data-search-url="{{ routes.search_url }}"
  {% if predictive %}
    data-predictive="true"
    data-predictive-url="{{ routes.predictive_search_url }}"
    data-currency="{{ cart.currency.iso_code }}"
    data-money-sample="{{ money_sample | escape_once }}"
    data-label-loading="{{ 'accessibility.loading' | t }}"
    data-label-empty="{{ 'search.no_results_html' | t: terms: '%TERMS%' }}"
    data-label-results-one="{{ 'search.results_for_html' | t: count: 1, terms: '%TERMS%' | replace: '1', '%COUNT%' }}"
    data-label-results="{{ 'search.results_for_html' | t: count: 2, terms: '%TERMS%' | replace: '2', '%COUNT%' }}"
    data-label-from="{{ 'products.card.from' | t }}"
    data-label-suggestions="{{ 'search.suggestions' | t }}"
    data-label-products="{{ 'search.products' | t }}"
    data-label-pages="{{ 'search.pages' | t }}"
    data-label-articles="{{ 'search.articles' | t }}"
    data-label-error="{{ 'search.suggestions_error' | t }}"
    {% if settings.predictive_search_show_vendor %}
      data-show-vendor="true"
    {% endif %}
    {% if settings.predictive_search_show_price %}
      data-show-price="true"
    {% endif %}
  {% endif %}
>
  <div
    class="fl-search__overlay"
    id="FlSearchOverlay"
    role="dialog"
    aria-modal="true"
    aria-label="{{ 'search.title' | t }}"
    data-search-overlay
    hidden
  >
    <div class="fl-search__scrim" data-search-close></div>
    {%- comment -%}
      .fl-popup wires this surface to the Popups theme settings (border,
      radius, shadow), which previously drove nothing in the theme.
    {%- endcomment -%}
    <div class="fl-search__panel fl-popup" tabindex="-1">
      <div class="fl-search__container">
        <div class="fl-search__bar">
          <form class="fl-search__form" action="{{ routes.search_url }}" method="get" role="search">
            <svg class="fl-search__icon" width="20" height="20" viewBox="0 0 20 20" fill="none" aria-hidden="true" focusable="false">
              <circle cx="9" cy="9" r="5.5" stroke="currentColor" stroke-width="1.5"/>
              <path d="m13.5 13.5 3.5 3.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
            </svg>
            <label class="visually-hidden" for="FlSearchOverlayInput">{{ 'search.title' | t }}</label>
            <input
              id="FlSearchOverlayInput"
              class="fl-search__input"
              type="search"
              name="q"
              data-search-input
              placeholder="{{ 'search.placeholder' | t }}"
              {% if predictive %}
                role="combobox"
                aria-autocomplete="list"
                aria-expanded="false"
                aria-controls="FlSearchResults"
              {% endif %}
              autocomplete="off"
              autocorrect="off"
              autocapitalize="off"
              spellcheck="false"
              enterkeyhint="search"
            >
            <button type="button" class="fl-search__clear" data-search-clear>
              <svg width="16" height="16" viewBox="0 0 20 20" fill="none" aria-hidden="true" focusable="false">
                <path d="m5 5 10 10M15 5 5 15" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
              </svg>
              <span class="visually-hidden">{{ 'search.clear' | t }}</span>
            </button>
            {%- unless predictive -%}
              {%- comment -%}
                Without suggestions the overlay is a plain form, so it needs a
                visible way to submit on touch keyboards that hide the Go key.
              {%- endcomment -%}
              <button type="submit" class="fl-search__submit">
                {{- 'search.submit' | t -}}
              </button>
            {%- endunless -%}
          </form>
          <button type="button" class="fl-search__close" data-search-close>
            {{ 'accessibility.close' | t }}
          </button>
        </div>

        {%- if predictive -%}
          <p class="fl-search__status" data-search-status role="status" aria-live="polite"></p>
          <div
            class="fl-search__groups"
            id="FlSearchResults"
            role="listbox"
            aria-label="{{ 'search.suggestions' | t }}"
            data-search-results
          ></div>
          <a class="fl-search__viewall" data-search-viewall href="{{ routes.search_url }}" hidden>
            {{- 'search.view_all' | t -}}
          </a>
        {%- endif -%}
      </div>
    </div>
  </div>
</fl-search>

{% stylesheet %}
  .fl-search {
    display: contents;
  }

  .fl-search__overlay {
    position: fixed;
    inset: 0;
    z-index: 70;
  }

  .fl-search__overlay[hidden] {
    display: none;
  }

  .fl-search__scrim {
    position: absolute;
    inset: 0;
    background: rgb(0 0 0 / 40%);
    opacity: 0;
    transition: opacity 0.25s ease;
  }

  .fl-search__overlay.is-open .fl-search__scrim {
    opacity: 1;
  }

  /* Background, border and shadow come from .fl-popup (Popups theme settings).
     The panel drops from the very top of the viewport, so its top corners stay
     square whatever radius the merchant picks. */
  .fl-search__panel {
    position: relative;
    max-height: 88dvh;
    overflow-y: auto;
    border-start-start-radius: 0;
    border-start-end-radius: 0;
    opacity: 0;
    transform: translateY(-10px);
    transition: opacity 0.25s ease, transform 0.25s ease;
  }

  .fl-search__overlay.is-open .fl-search__panel {
    opacity: 1;
    transform: none;
  }

  .fl-search__container {
    max-width: var(--page-width);
    margin-inline: auto;
    padding: 24px var(--page-margin) 36px;
  }

  .fl-search__bar {
    display: flex;
    align-items: center;
    gap: 20px;
  }

  .fl-search__form {
    flex: 1 1 auto;
    display: flex;
    align-items: center;
    gap: 12px;
    min-width: 0;
    border-bottom: 1px solid var(--color-ink);
  }

  /* The field has no border of its own: the line belongs to the form. The
     thickening on focus is a bonus — the visible indicator is the theme's own
     2px ring, which this field used to remove. */
  .fl-search__form:focus-within {
    box-shadow: 0 1px 0 var(--color-ink);
  }

  .fl-search__icon {
    flex: 0 0 auto;
    color: var(--color-muted);
  }

  .fl-search__input {
    flex: 1 1 auto;
    min-width: 0;
    min-height: 48px;
    padding: 8px 0;
    border: 0;
    background: transparent;
    color: var(--color-ink);
    font-size: 1.25em;
  }

  .fl-search__input::placeholder {
    color: var(--color-muted);
  }

  .fl-search__input::-webkit-search-cancel-button {
    display: none;
  }

  .fl-search__clear {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex: 0 0 auto;
    width: 44px;
    height: 44px;
    padding: 0;
    border: 0;
    background: none;
    color: var(--color-muted);
    cursor: pointer;
  }

  .fl-search__clear:hover {
    color: var(--color-ink);
  }

  .fl-search__form:has(.fl-search__input:placeholder-shown) .fl-search__clear {
    visibility: hidden;
  }

  .fl-search__close,
  .fl-search__submit {
    flex: 0 0 auto;
    min-height: 44px;
    padding: 10px 4px;
    border: 0;
    background: none;
    font: inherit;
    font-size: 0.875em;
    color: var(--color-muted);
    cursor: pointer;
  }

  .fl-search__close:hover,
  .fl-search__submit:hover {
    color: var(--color-ink);
  }

  .fl-search__submit {
    padding-inline: 8px;
    font-weight: 500;
    color: var(--color-ink);
  }

  .fl-search__status {
    margin: 18px 0 0;
    font-size: 0.875em;
    color: var(--color-muted);
  }

  .fl-search__status:empty {
    display: none;
  }

  .fl-search__groups {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 28px 40px;
    margin-top: 24px;
  }

  .fl-search__groups:empty {
    display: none;
    margin: 0;
  }

  .fl-search__group {
    min-width: 0;
  }

  .fl-search__group--products {
    grid-column: 1 / -1;
  }

  .fl-search__list {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .fl-search__list--products {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(230px, 1fr));
    gap: 8px 28px;
  }

  .fl-search__link {
    display: flex;
    align-items: center;
    min-height: 44px;
    padding: 2px 0;
    color: var(--color-ink);
    text-decoration: none;
  }

  .fl-search__link:hover {
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  .fl-search__product {
    display: grid;
    grid-template-columns: 56px minmax(0, 1fr);
    gap: 14px;
    align-items: center;
    padding: 6px 0;
    color: inherit;
    text-decoration: none;
  }

  .fl-search__thumb {
    display: block;
    width: 56px;
    aspect-ratio: var(--card-ratio);
    object-fit: cover;
    border-radius: var(--radius-btn);
    background: var(--color-surface);
  }

  .fl-search__product-info {
    display: flex;
    flex-direction: column;
    gap: 2px;
    min-width: 0;
  }

  .fl-search__product-title {
    font-weight: 500;
    font-size: 0.9375em;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  /* The suggestion picked with the arrow keys (aria-activedescendant): focus
     stays in the field, so the ring is drawn here. */
  .fl-search__link.is-active,
  .fl-search__product.is-active {
    outline: 2px solid var(--color-ink);
    outline-offset: 2px;
  }

  .fl-search__product:hover .fl-search__product-title {
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  .fl-search__product-price,
  .fl-search__product-vendor {
    font-size: 0.875em;
    color: var(--color-muted);
  }

  .fl-search__product-vendor {
    overflow: hidden;
    font-size: 0.75em;
    letter-spacing: 0.08em;
    text-overflow: ellipsis;
    text-transform: uppercase;
    white-space: nowrap;
  }

  .fl-search__viewall {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    margin-top: 20px;
    color: var(--color-ink);
  }

  .fl-search__viewall[hidden] {
    display: none;
  }

  @media (max-width: 749px) {
    .fl-search__container {
      padding: 16px var(--page-margin) 28px;
    }

    .fl-search__groups {
      gap: 24px;
    }

    .fl-search__input {
      font-size: 1.0625em;
    }
  }
{% endstylesheet %}

{% javascript %}
  class FlSearch extends HTMLElement {
    connectedCallback() {
      this.overlay = this.querySelector('[data-search-overlay]');
      this.input = this.querySelector('[data-search-input]');
      this.results = this.querySelector('[data-search-results]');
      this.status = this.querySelector('[data-search-status]');
      this.viewAll = this.querySelector('[data-search-viewall]');
      this.lastFocus = null;
      this.controller = null;
      this.debounceId = null;

      // Theme setting: Search > Enable search suggestions. When off, the
      // element never touches the JSON API and the form submits normally.
      this.predictive = this.dataset.predictive === 'true';
      this.showVendor = this.dataset.showVendor === 'true';
      this.showPrice = this.dataset.showPrice === 'true';

      // Both come from the routes object (locale- and market-aware); the
      // predictive one is only written, and only read, when predictive is on.
      this.predictiveUrl = this.dataset.predictiveUrl;
      this.searchUrl = this.dataset.searchUrl;
      this.currency = this.dataset.currency || 'USD';
      this.moneySample = this.dataset.moneySample || '';
      this.labels = {
        loading: this.dataset.labelLoading || 'Loading',
        empty: this.dataset.labelEmpty || 'No results for %TERMS%',
        results: this.dataset.labelResults || '%COUNT% results for %TERMS%',
        resultsOne: this.dataset.labelResultsOne || '%COUNT% result for %TERMS%',
        from: this.dataset.labelFrom || 'From',
        suggestions: this.dataset.labelSuggestions || 'Suggestions',
        products: this.dataset.labelProducts || 'Products',
        pages: this.dataset.labelPages || 'Pages',
        articles: this.dataset.labelArticles || 'Articles',
        error: this.dataset.labelError || ''
      };
      this.activeIndex = -1;

      this._onDocClick = (event) => {
        const opener = event.target && event.target.closest ? event.target.closest('[data-search-open]') : null;
        if (opener) {
          event.preventDefault();
          this.open(opener);
        }
      };
      document.addEventListener('click', this._onDocClick);

      this.querySelectorAll('[data-search-close]').forEach((el) => {
        el.addEventListener('click', () => this.close());
      });

      const clearBtn = this.querySelector('[data-search-clear]');
      if (clearBtn) {
        clearBtn.addEventListener('click', () => {
          this.input.value = '';
          this.renderEmpty();
          this.input.focus();
        });
      }

      // Bound on document only while the overlay is open: a click on a
      // non-interactive part of the panel moves focus to <body>, which is
      // outside <fl-search>, so an element-level listener stopped seeing
      // ESC and Tab entirely.
      this._onKeydown = (event) => {
        if (!this.isOpen()) return;
        if (event.key === 'Escape') {
          event.preventDefault();
          this.close();
        } else if (event.key === 'Tab') {
          this.trapFocus(event);
        }
      };

      if (this.input && this.predictive) {
        // Combobox: focus stays in the field, the arrows move the active
        // suggestion (aria-activedescendant) and Enter follows it.
        this.input.addEventListener('keydown', (event) => {
          const options = this.options();
          if (event.key === 'ArrowDown' || event.key === 'ArrowUp') {
            if (!options.length) return;
            event.preventDefault();
            if (event.key === 'ArrowDown') {
              this.setActive((this.activeIndex + 1) % options.length);
            } else {
              this.setActive(this.activeIndex <= 0 ? options.length - 1 : this.activeIndex - 1);
            }
          } else if (event.key === 'Enter' && this.activeIndex > -1 && options[this.activeIndex]) {
            event.preventDefault();
            options[this.activeIndex].click();
          }
        });
        this.input.addEventListener('input', () => {
          clearTimeout(this.debounceId);
          this.debounceId = setTimeout(() => this.search(this.input.value.trim()), 250);
        });
      }
    }

    disconnectedCallback() {
      document.removeEventListener('click', this._onDocClick);
      document.removeEventListener('keydown', this._onKeydown);
      document.documentElement.style.overflow = '';
    }

    isOpen() {
      return this.overlay && !this.overlay.hidden;
    }

    open(opener) {
      if (!this.overlay || this.isOpen()) return;
      this.lastFocus = opener || document.activeElement;
      document.addEventListener('keydown', this._onKeydown);
      this.overlay.hidden = false;
      void this.overlay.offsetWidth;
      this.overlay.classList.add('is-open');
      document.documentElement.style.overflow = 'hidden';
      document.querySelectorAll('[data-search-open]').forEach((btn) => {
        btn.setAttribute('aria-expanded', 'true');
      });
      if (this.input) {
        this.input.focus();
        this.input.select();
      }
    }

    close() {
      if (!this.overlay || !this.isOpen()) return;
      document.removeEventListener('keydown', this._onKeydown);
      this.overlay.classList.remove('is-open');
      document.documentElement.style.overflow = '';
      document.querySelectorAll('[data-search-open]').forEach((btn) => {
        btn.setAttribute('aria-expanded', 'false');
      });
      const hide = () => {
        this.overlay.hidden = true;
        this.overlay.removeEventListener('transitionend', hide);
      };
      this.overlay.addEventListener('transitionend', hide);
      setTimeout(() => {
        if (!this.overlay.classList.contains('is-open')) this.overlay.hidden = true;
      }, 400);
      if (this.lastFocus && this.lastFocus.focus) this.lastFocus.focus();
    }

    trapFocus(event) {
      const nodes = this.overlay.querySelectorAll('a[href], button:not([disabled]), input:not([disabled])');
      const focusables = Array.prototype.filter.call(nodes, (el) => el.getClientRects().length > 0);
      if (!focusables.length) return;
      const first = focusables[0];
      const last = focusables[focusables.length - 1];
      // Focus fell outside the dialog (e.g. onto <body>): pull it back in
      // instead of letting Tab reach the page behind the modal.
      if (!this.overlay.contains(document.activeElement)) {
        event.preventDefault();
        if (event.shiftKey) {
          last.focus();
        } else {
          first.focus();
        }
        return;
      }
      if (event.shiftKey && document.activeElement === first) {
        event.preventDefault();
        last.focus();
      } else if (!event.shiftKey && document.activeElement === last) {
        event.preventDefault();
        first.focus();
      }
    }

    setStatus(message) {
      if (this.status) this.status.textContent = message || '';
    }

    renderEmpty() {
      if (this.results) this.results.innerHTML = '';
      this.setStatus('');
      if (this.viewAll) this.viewAll.hidden = true;
      this.setExpanded(false);
    }

    options() {
      return this.results ? Array.from(this.results.querySelectorAll('[role="option"]')) : [];
    }

    setExpanded(expanded) {
      if (!this.input) return;
      this.input.setAttribute('aria-expanded', expanded ? 'true' : 'false');
      if (!expanded) this.setActive(-1);
    }

    setActive(index) {
      const options = this.options();
      this.activeIndex = index;
      options.forEach((option, i) => {
        const active = i === index;
        option.setAttribute('aria-selected', active ? 'true' : 'false');
        option.classList.toggle('is-active', active);
        if (active) option.scrollIntoView({ block: 'nearest' });
      });
      if (!this.input) return;
      if (index > -1 && options[index]) {
        this.input.setAttribute('aria-activedescendant', options[index].id);
      } else {
        this.input.removeAttribute('aria-activedescendant');
      }
    }

    async search(query) {
      if (!this.predictive) return;
      // Abort first, unconditionally: bailing out early on a short query used to
      // leave the previous request in flight, so stale results landed after the
      // field was cleared.
      if (this.controller) this.controller.abort();
      if (!query || query.length < 2) {
        this.renderEmpty();
        return;
      }
      this.controller = new AbortController();
      this.setStatus(this.labels.loading);
      const endpoint =
        this.predictiveUrl +
        '.json?q=' +
        encodeURIComponent(query) +
        '&resources[type]=query,product,page,article&resources[limit]=8&resources[limit_scope]=each';
      try {
        const res = await fetch(endpoint, {
          signal: this.controller.signal,
          headers: { Accept: 'application/json' }
        });
        if (!res.ok) throw new Error('HTTP ' + res.status);
        const data = await res.json();
        const found = (data && data.resources && data.resources.results) || {};
        this.render(found.queries || [], found.products || [], found.pages || [], found.articles || [], query);
      } catch (err) {
        if (err && err.name === 'AbortError') return;
        // Said in the status region (role=status) and the field stays usable:
        // Enter still submits the full search.
        this.renderEmpty();
        this.setStatus(this.labels.error);
      }
    }

    render(queries, products, pages, articles, query) {
      if (!this.results) return;
      this.results.innerHTML = '';
      const total = queries.length + products.length + pages.length + articles.length;

      if (total === 0) {
        this.setStatus(this.labels.empty.replace('%TERMS%', query));
        if (this.viewAll) this.viewAll.hidden = true;
        this.setExpanded(false);
        return;
      }

      const frag = document.createDocumentFragment();
      if (queries.length) frag.appendChild(this.buildTextGroup('suggestions', this.labels.suggestions, queries));
      if (products.length) frag.appendChild(this.buildProductGroup(products));
      if (pages.length) frag.appendChild(this.buildTextGroup('pages', this.labels.pages, pages));
      if (articles.length) frag.appendChild(this.buildTextGroup('articles', this.labels.articles, articles));
      this.results.appendChild(frag);
      this.options().forEach((option, i) => {
        option.id = 'FlSearchOption-' + i;
      });
      this.setExpanded(true);

      // The plural form of the page language (French "one" covers 0 and 1).
      let plural = 'other';
      try {
        plural = new Intl.PluralRules(document.documentElement.lang || 'en').select(total);
      } catch (err) {
        plural = 'other';
      }
      const resultsLabel = plural === 'one' ? this.labels.resultsOne : this.labels.results;
      this.setStatus(resultsLabel.replace('%COUNT%', total).replace('%TERMS%', query));
      if (this.viewAll) {
        this.viewAll.href = this.searchUrl + '?q=' + encodeURIComponent(query);
        this.viewAll.hidden = false;
      }
    }

    buildGroup(key, label, modifier) {
      const wrap = document.createElement('div');
      wrap.className = 'fl-search__group' + (modifier ? ' fl-search__group--' + modifier : '');
      const title = document.createElement('p');
      title.className = 'fl-eyebrow fl-search__group-title';
      title.id = 'FlSearchGroup-' + key;
      title.textContent = label;
      wrap.setAttribute('role', 'group');
      wrap.setAttribute('aria-labelledby', title.id);
      const list = document.createElement('ul');
      list.className = 'fl-search__list' + (modifier ? ' fl-search__list--' + modifier : '');
      list.setAttribute('role', 'presentation');
      wrap.appendChild(title);
      wrap.appendChild(list);
      return { wrap: wrap, list: list };
    }

    buildTextGroup(key, label, items) {
      const group = this.buildGroup(key, label, null);
      items.forEach((item) => {
        const text = item.text || item.title || '';
        const li = document.createElement('li');
        li.setAttribute('role', 'presentation');
        const link = document.createElement('a');
        link.className = 'fl-search__link';
        link.setAttribute('role', 'option');
        link.setAttribute('aria-selected', 'false');
        link.tabIndex = -1;
        link.href = item.url || this.searchUrl + '?q=' + encodeURIComponent(text);
        link.textContent = text;
        link.addEventListener('click', () => this.close());
        li.appendChild(link);
        group.list.appendChild(li);
      });
      return group.wrap;
    }

    buildProductGroup(products) {
      const group = this.buildGroup('products', this.labels.products, 'products');
      products.forEach((product) => {
        const li = document.createElement('li');
        li.setAttribute('role', 'presentation');
        const link = document.createElement('a');
        link.className = 'fl-search__product';
        link.setAttribute('role', 'option');
        link.setAttribute('aria-selected', 'false');
        link.tabIndex = -1;
        link.href = product.url || '#';
        link.addEventListener('click', () => this.close());

        if (product.featured_image && product.featured_image.url) {
          const img = document.createElement('img');
          img.className = 'fl-search__thumb';
          img.src = this.sized(product.featured_image.url, 120);
          img.alt = '';
          img.width = 56;
          img.height = 70;
          img.loading = 'lazy';
          link.appendChild(img);
        } else {
          const placeholder = document.createElement('span');
          placeholder.className = 'fl-search__thumb';
          link.appendChild(placeholder);
        }

        const info = document.createElement('span');
        info.className = 'fl-search__product-info';
        // Theme setting: Search > Show vendor. Above the title, like the card.
        if (this.showVendor && product.vendor) {
          const vendorEl = document.createElement('span');
          vendorEl.className = 'fl-search__product-vendor';
          vendorEl.textContent = product.vendor;
          info.appendChild(vendorEl);
        }
        const title = document.createElement('span');
        title.className = 'fl-search__product-title';
        title.textContent = product.title || '';
        info.appendChild(title);
        // Theme setting: Search > Show price.
        const price = this.showPrice ? this.formatPrice(product) : '';
        if (price) {
          const priceEl = document.createElement('span');
          priceEl.className = 'fl-search__product-price';
          priceEl.textContent = price;
          info.appendChild(priceEl);
        }
        link.appendChild(info);
        li.appendChild(link);
        group.list.appendChild(li);
      });
      return group.wrap;
    }

    sized(url, width) {
      const sep = url.indexOf('?') > -1 ? '&' : '?';
      return url + sep + 'width=' + width;
    }

    formatPrice(product) {
      const rawMin = product.price_min != null ? product.price_min : product.price;
      const rawMax = product.price_max != null ? product.price_max : product.price;
      const min = parseFloat(String(rawMin).replace(',', '.'));
      const max = parseFloat(String(rawMax).replace(',', '.'));
      if (isNaN(min)) return '';
      let out = this.formatMoney(min);
      if (!isNaN(max) && max > min) out = this.labels.from + ' ' + out;
      return out;
    }

    // Rebuilds the amount inside data-money-sample, the money filter's output
    // for 1,234,567.89 ("$1,234,567.89", "1.234.567,89 €", "1'234'567.89 CHF",
    // "¥1,234,568"): its digit run is swapped for the value with the same
    // grouping mark, decimal mark and number of decimals, and the text around
    // it (symbol, currency code) is kept. Guessing with Intl produced a
    // different string from every price rendered server-side.
    formatMoney(value) {
      const sample = this.moneySample;
      const match = sample ? sample.match(/\d(?:[\d.,'\s\u00a0\u202f]*\d)?/) : null;
      if (match) {
        const run = match[0];
        // The whole part of the sample always has 7 digits (1234567, or
        // 1234568 once rounded); any extra digit is a decimal.
        const decimals = Math.max(0, run.replace(/\D/g, '').length - 7);
        const decimalMark = decimals ? run.charAt(run.length - decimals - 1) : '';
        const groupMark = /\d/.test(run.charAt(1)) ? '' : run.charAt(1);
        const parts = Number(value).toFixed(decimals).split('.');
        const whole = parts[0].replace(/\B(?=(\d{3})+(?!\d))/g, groupMark);
        const amount = decimals ? whole + decimalMark + parts[1] : whole;
        return sample.slice(0, match.index) + amount + sample.slice(match.index + run.length);
      }
      const locale = document.documentElement.lang || 'en';
      try {
        return new Intl.NumberFormat(locale, { style: 'currency', currency: this.currency }).format(value);
      } catch (err) {
        return this.currency + ' ' + value.toFixed(2);
      }
    }
  }

  if (!customElements.get('fl-search')) customElements.define('fl-search', FlSearch);
{% endjavascript %}
