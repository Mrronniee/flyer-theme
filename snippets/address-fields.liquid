  <div class="fl-field">
    <label class="fl-label" for="FlAddrZip-{{ uid }}">{{ 'customer.addresses.zip' | t }}</label>
    <input
      class="fl-input"
      type="text"
      id="FlAddrZip-{{ uid }}"
      {% if form.errors contains 'zip' %}
        aria-invalid="true"
        aria-describedby="FlAddrZip-{{ uid }}-error"
      {% endif %}
      name="address[zip]"
      value="{{ form.zip | escape_once }}"
      autocomplete="postal-code"
    >
    {%- if form.errors contains 'zip' -%}
      <p class="fl-field__error" id="FlAddrZip-{{ uid }}-error">
        {{- form.errors.translated_fields['zip'] | capitalize }} {{ form.errors.messages['zip'] -}}
      </p>
    {%- endif -%}
  </div>

  <div class="fl-field fl-account__field--full">
    <label class="fl-label" for="FlAddrCountry-{{ uid }}">{{ 'customer.addresses.country' | t }}</label>
    <select
      class="fl-select"
      id="FlAddrCountry-{{ uid }}"
      {% if form.errors contains 'country' %}
        aria-invalid="true"
        aria-describedby="FlAddrCountry-{{ uid }}-error"
      {% endif %}
      name="address[country]"
      autocomplete="country"
      data-country-select="{{ uid }}"
      data-default="{{ form.country | escape_once }}"
    >
      {{ all_country_option_tags }}
    </select>
    {%- if form.errors contains 'country' -%}
      <p class="fl-field__error" id="FlAddrCountry-{{ uid }}-error">
        {{- form.errors.translated_fields['country'] | capitalize }} {{ form.errors.messages['country'] -}}
      </p>
    {%- endif -%}
  </div>

  <div class="fl-field fl-account__field--full" data-province-wrapper="{{ uid }}" hidden>
    <label class="fl-label" for="FlAddrProvince-{{ uid }}">{{ 'customer.addresses.province' | t }}</label>
    <select
      class="fl-select"
      id="FlAddrProvince-{{ uid }}"
      {% if form.errors contains 'province' %}
        aria-invalid="true"
        aria-describedby="FlAddrProvince-{{ uid }}-error"
      {% endif %}
      name="address[province]"
      autocomplete="address-level1"
      data-default="{{ form.province | escape_once }}"
    ></select>
    {%- if form.errors contains 'province' -%}
      <p class="fl-field__error" id="FlAddrProvince-{{ uid }}-error">
        {{- form.errors.translated_fields['province'] | capitalize }} {{ form.errors.messages['province'] -}}
