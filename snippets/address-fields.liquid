{% doc %}
  Address form fields shared by the "edit" and "add" forms on the addresses page.
  The country select carries data-country-select; the province wrapper is matched
  by data-province-wrapper with the same uid, and filled by <fl-addresses>.
  A field Shopify sends back in error carries aria-invalid and points to its own
  message (the summary above the form, in sections/customer-addresses.liquid,
  links to each field).

  @param {object} form - the customer_address form object
  @param {string} uid - unique suffix for element ids (address id, or 'new')

  @example
  {% render 'address-fields', form: form, uid: address.id %}
{% enddoc %}

<div class="fl-account__grid">
  <div class="fl-field">
    <label class="fl-label" for="FlAddrFirst-{{ uid }}">{{ 'customer.addresses.first_name' | t }}</label>
    <input
      class="fl-input"
      type="text"
      id="FlAddrFirst-{{ uid }}"
      {% if form.errors contains 'first_name' %}
        aria-invalid="true"
        aria-describedby="FlAddrFirst-{{ uid }}-error"
      {% endif %}
      name="address[first_name]"
      value="{{ form.first_name | escape_once }}"
      autocomplete="given-name"
    >
    {%- if form.errors contains 'first_name' -%}
      <p class="fl-field__error" id="FlAddrFirst-{{ uid }}-error">
        {{- form.errors.translated_fields['first_name'] | capitalize }} {{ form.errors.messages['first_name'] -}}
      </p>
    {%- endif -%}
  </div>

  <div class="fl-field">
    <label class="fl-label" for="FlAddrLast-{{ uid }}">{{ 'customer.addresses.last_name' | t }}</label>
    <input
      class="fl-input"
      type="text"
      id="FlAddrLast-{{ uid }}"
      {% if form.errors contains 'last_name' %}
        aria-invalid="true"
        aria-describedby="FlAddrLast-{{ uid }}-error"
      {% endif %}
      name="address[last_name]"
      value="{{ form.last_name | escape_once }}"
      autocomplete="family-name"
    >
    {%- if form.errors contains 'last_name' -%}
      <p class="fl-field__error" id="FlAddrLast-{{ uid }}-error">
        {{- form.errors.translated_fields['last_name'] | capitalize }} {{ form.errors.messages['last_name'] -}}
      </p>
    {%- endif -%}
  </div>

  <div class="fl-field fl-account__field--full">
    <label class="fl-label" for="FlAddrCompany-{{ uid }}">{{ 'customer.addresses.company' | t }}</label>
    <input
      class="fl-input"
      type="text"
      id="FlAddrCompany-{{ uid }}"
      {% if form.errors contains 'company' %}
        aria-invalid="true"
        aria-describedby="FlAddrCompany-{{ uid }}-error"
      {% endif %}
      name="address[company]"
      value="{{ form.company | escape_once }}"
      autocomplete="organization"
    >
    {%- if form.errors contains 'company' -%}
      <p class="fl-field__error" id="FlAddrCompany-{{ uid }}-error">
        {{- form.errors.translated_fields['company'] | capitalize }} {{ form.errors.messages['company'] -}}
      </p>
    {%- endif -%}
  </div>

  <div class="fl-field fl-account__field--full">
    <label class="fl-label" for="FlAddrOne-{{ uid }}">{{ 'customer.addresses.address1' | t }}</label>
    <input
      class="fl-input"
      type="text"
      id="FlAddrOne-{{ uid }}"
      {% if form.errors contains 'address1' %}
        aria-invalid="true"
        aria-describedby="FlAddrOne-{{ uid }}-error"
      {% endif %}
      name="address[address1]"
      value="{{ form.address1 | escape_once }}"
      autocomplete="address-line1"
    >
    {%- if form.errors contains 'address1' -%}
      <p class="fl-field__error" id="FlAddrOne-{{ uid }}-error">
        {{- form.errors.translated_fields['address1'] | capitalize }} {{ form.errors.messages['address1'] -}}
      </p>
    {%- endif -%}
  </div>

  <div class="fl-field fl-account__field--full">
    <label class="fl-label" for="FlAddrTwo-{{ uid }}">{{ 'customer.addresses.address2' | t }}</label>
    <input
      class="fl-input"
      type="text"
      id="FlAddrTwo-{{ uid }}"
      {% if form.errors contains 'address2' %}
        aria-invalid="true"
        aria-describedby="FlAddrTwo-{{ uid }}-error"
      {% endif %}
      name="address[address2]"
      value="{{ form.address2 | escape_once }}"
      autocomplete="address-line2"
    >
    {%- if form.errors contains 'address2' -%}
      <p class="fl-field__error" id="FlAddrTwo-{{ uid }}-error">
        {{- form.errors.translated_fields['address2'] | capitalize }} {{ form.errors.messages['address2'] -}}
      </p>
    {%- endif -%}
  </div>

  <div class="fl-field">
    <label class="fl-label" for="FlAddrCity-{{ uid }}">{{ 'customer.addresses.city' | t }}</label>
    <input
      class="fl-input"
      type="text"
      id="FlAddrCity-{{ uid }}"
      {% if form.errors contains 'city' %}
        aria-invalid="true"
        aria-describedby="FlAddrCity-{{ uid }}-error"
      {% endif %}
      name="address[city]"
      value="{{ form.city | escape_once }}"
      autocomplete="address-level2"
    >
    {%- if form.errors contains 'city' -%}
      <p class="fl-field__error" id="FlAddrCity-{{ uid }}-error">
