{% doc %}
  Loads at once the images that the first screen shows.

  Each section decides in Liquid how its images load: eager when it opens the
  page (section.index 1), lazy lower down. Liquid cannot see the sections
  above, though: below a short text section, a featured blog or a multicolumn
  can stand in the first screen and hold its largest image while it still
  waits as lazy (measured 29/10/2026: the featured blog's first image, LCP of
  the page at 412, 1350 and 1920 px). Here, once the page is parsed, every
  lazy image shown inside the first screen switches to eager; an image kept
  out of sight (a card's hover view, a slide waiting its turn) stays lazy.
  When no image of the first screen already has fetchpriority="high" (the
  section opening the page sets it), the largest of the images switched here
  gets it, before its request starts: it is the page's largest paint, and it
  was otherwise fetched at the same rank as every other image (measured
  29/10/2026, FLYER 1.10.4: the featured blog behind the page title, at 412,
  1350 and 1920 px). A row of equal cards shares it (four at most): which of
  them the browser counts as the largest paint depends on each file's own
  resolution, unknown before it loads (measured at 1350 and 1440: the second
  card of the row). Every other hint the sections set is left as it is.

  Without JavaScript, each image keeps the loading its section gave it.

  @example
  {% render 'first-screen-images' %}
{% enddoc %}
<script>
  (function () {
    'use strict';
    var fold = window.innerHeight || document.documentElement.clientHeight;
    var edge = window.innerWidth || document.documentElement.clientWidth;
    function onScreen(img) {
      var box = img.getBoundingClientRect();
      if (!box.width || !box.height || box.top >= fold || box.bottom <= 0 || box.left >= edge || box.right <= 0) return 0;
      // A picture waiting for its turn (a card's hover view, a slide behind
      // the current one) is not on screen yet.
      var style = getComputedStyle(img);
      if (style.opacity === '0' || style.visibility === 'hidden') return 0;
      var w = Math.min(box.right, edge) - Math.max(box.left, 0);
      var h = Math.min(box.bottom, fold) - Math.max(box.top, 0);
      return w * h;
    }
    var images = document.querySelectorAll('[id^="shopify-section"] img[loading="lazy"]');
    var shown = [];
    var areas = [];
    var largestArea = 0;
    for (var i = 0; i < images.length; i++) {
      var area = onScreen(images[i]);
      if (!area) continue;
      shown.push(images[i]);
      areas.push(area);
      if (area > largestArea && images[i].getAttribute('fetchpriority') !== 'low') largestArea = area;
    }
    var ranked = false;
    var high = document.querySelectorAll('[id^="shopify-section"] img[fetchpriority="high"]');
    for (var j = 0; j < high.length; j++) {
      if (onScreen(high[j])) ranked = true;
    }
    var given = 0;
    for (var k = 0; k < shown.length; k++) {
      // Equal sizes are measured a fraction of a pixel apart: 2 % of slack.
      if (!ranked && largestArea && given < 4 && areas[k] >= largestArea * 0.98 && shown[k].getAttribute('fetchpriority') !== 'low') {
        shown[k].setAttribute('fetchpriority', 'high');
        given++;
      }
      shown[k].loading = 'eager';
    }
  })();
</script>
