{% doc %}
  Player for a product media that is not an image: Shopify-hosted video,
  YouTube or Vimeo video, or 3D model. Shared by the product page and the
  featured product section.
  - The hosted video shows its native controls, so the viewer reaches the
    captions track the merchant uploaded with it.
  - YouTube and Vimeo players keep their own controls (captions included) and
    accept the pause message the gallery sends when another media is shown
    (enablejsapi for YouTube; Vimeo listens by default).
  - When the media is the first one on screen at load (priority), its poster is
    the largest paint: it is preloaded with a high fetch priority.
  - A hosted video on a hidden slide (hidden) keeps its poster in data-poster
    AND the fallback image video_tag puts inside the <video> in data-src,
    behind a transparent placeholder src: a browser fetches both even for a
    video it never shows (228 KB on a product page, measured again on 1.10.5
    once only the poster was held back), and src is required on <img>. The
    gallery sets them when the slide is shown.

  @param {object} media - a product media whose media_type is not 'image'
  @param {boolean} [priority] - true for the first media of the first section
  @param {boolean} [hidden] - true when the media starts on a hidden slide

  @example
  {% render 'media-player', media: media, priority: true %}
{% enddoc %}

{%- liquid
  case media.media_type
    when 'video'
      assign player = media | video_tag: image_size: '1200x', controls: true, playsinline: true, preload: 'metadata'
      # video_tag turns controls into controls="controls" but copies the
      # playsinline value straight through, so the true above lands in the
      # HTML. playsinline is a boolean attribute: its only valid values are
      # the empty string and its own name.
      assign player = player | replace: ' playsinline="true"', ' playsinline="playsinline"'
    when 'external_video'
      if media.host == 'youtube'
        assign player = media | external_video_url: enablejsapi: 1 | external_video_tag: loading: 'lazy'
      else
        assign player = media | external_video_url | external_video_tag: loading: 'lazy'
      endif
    else
      assign player = media | media_tag: image_size: '1200x'
  endcase

  if hidden and media.media_type == 'video'
    assign player = player | replace: ' poster="', ' data-poster="'
    # video_tag also writes a fallback <img src> inside the <video>, for a
    # browser that cannot play it. The replace above does not reach it, and
    # it is the one that transferred the 228 KB: hold its src back too. The
    # slide is display:none until the gallery shows it, so nothing is shown
    # in the meantime either way.
    # src is required on <img>, so the held-back URL moves to data-src and
    # src keeps the 1x1 transparent GIF the cards already use: valid HTML,
    # and still not a single byte fetched.
    assign blank_pixel = 'data:image/gif;base64,R0lGODlhAQABAIAAAAAAAP///yH5BAEAAAAALAAAAAABAAEAAAIBRAA7'
    assign held_back = ' src="' | append: blank_pixel | append: '" data-src="'
    assign player_parts = player | split: '<img '
    if player_parts.size == 2
      assign player_fallback = player_parts[1] | replace_first: ' src="', held_back
      assign player = player_parts[0] | append: '<img ' | append: player_fallback
    endif
  endif

  assign poster = ''
  if priority and player contains 'poster="'
    assign poster = player | split: 'poster="' | last | split: '"' | first
  endif
-%}
{%- if poster != blank -%}
  <link rel="preload" as="image" href="{{ poster }}" fetchpriority="high">
{%- endif -%}
{{ player }}
