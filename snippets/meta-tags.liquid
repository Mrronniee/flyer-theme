{% doc %}
  Document title, canonical URL, description and social cards.

  Charset and viewport are NOT emitted here — layout/theme.liquid already sets
  them, and having both meant every page shipped them twice.

  @example
  {% render 'meta-tags' %}
{% enddoc %}

{%- liquid
  assign meta_title = page_title | default: shop.name
  assign meta_description = page_description | default: shop.description | default: shop.name
  assign meta_url = canonical_url | default: request.origin

  assign meta_type = 'website'
  case request.page_type
    when 'product'
      assign meta_type = 'product'
    when 'article'
      assign meta_type = 'article'
    when 'password'
      assign meta_url = request.origin
  endcase

  # Falls back to the merchant's brand image so shared links are never bare.
  assign share_image = page_image | default: settings.brand_image
-%}

<title>
  {{ page_title }}
  {%- if current_tags %} &ndash; {{ current_tags | join: ', ' }}{% endif -%}
  {%- if current_page != 1 %} &ndash; {{ 'general.pagination.page' | t: number: current_page }}{% endif -%}
  {%- unless page_title contains shop.name %} &ndash; {{ shop.name }}{% endunless -%}
</title>

<link rel="canonical" href="{{ canonical_url }}">

{%- if page_description -%}
  <meta name="description" content="{{ page_description | escape }}">
{%- endif -%}

<meta property="og:site_name" content="{{ shop.name }}">
<meta property="og:url" content="{{ meta_url }}">
<meta property="og:title" content="{{ meta_title | escape }}">
<meta property="og:type" content="{{ meta_type }}">
<meta property="og:description" content="{{ meta_description | escape }}">

{%- if share_image -%}
  {%- assign share_src = share_image | image_url: width: 1200 -%}
  <meta property="og:image" content="https:{{ share_src }}">
  <meta property="og:image:secure_url" content="https:{{ share_src }}">
  <meta property="og:image:width" content="{{ share_image.width }}">
  <meta property="og:image:height" content="{{ share_image.height }}">
  <meta property="og:image:alt" content="{{ share_image.alt | default: meta_title | escape }}">
{%- endif -%}

{%- if request.page_type == 'product' -%}
  <meta property="og:price:amount" content="{{ product.price | money_without_currency | strip_html }}">
  <meta property="og:price:currency" content="{{ cart.currency.iso_code }}">
{%- endif -%}

<meta name="twitter:card" content="{% if share_image %}summary_large_image{% else %}summary{% endif %}">
<meta name="twitter:title" content="{{ meta_title | escape }}">
<meta name="twitter:description" content="{{ meta_description | escape }}">

{%- comment -%} Rich results for products and articles. {%- endcomment -%}
{%- if request.page_type == 'product' -%}
  <script type="application/ld+json">
    {{ product | structured_data }}
  </script>
{%- elsif request.page_type == 'article' -%}
  <script type="application/ld+json">
    {{ article | structured_data }}
  </script>
{%- endif -%}

{%- comment -%}
  Site-level and navigational structured data. Product and article bodies come
  from Shopify's structured_data filter above; this adds what it does not
  emit: the organisation, the site search action, breadcrumbs and the list of
  products shown on a collection page.
{%- endcomment -%}
{%- if request.page_type == 'index' -%}
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "Organization",
      "name": {{ shop.name | json }},
      "url": {{ request.origin | json }}
      {%- if settings.logo -%}
        , "logo": {{ settings.logo | image_url: width: 600 | prepend: 'https:' | json }}
      {%- endif -%}
      {%- assign social_urls = '' -%}
      {%- assign social_handles = 'instagram,tiktok,facebook,x,pinterest,youtube,linkedin' | split: ',' -%}
      {%- for handle in social_handles -%}
        {%- assign key = 'social_' | append: handle -%}
        {%- if settings[key] != blank -%}
          {%- assign social_urls = social_urls | append: settings[key] | append: '|' -%}
        {%- endif -%}
      {%- endfor -%}
      {%- if social_urls != blank -%}
        , "sameAs": {{ social_urls | split: '|' | json }}
      {%- endif -%}
    }
  </script>
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "WebSite",
      "name": {{ shop.name | json }},
      "url": {{ request.origin | json }},
      "potentialAction": {
        "@type": "SearchAction",
        "target": {
          "@type": "EntryPoint",
          {%- assign search_placeholder = '{' | append: 'search_term_string' | append: '}' -%}
          "urlTemplate": {{ request.origin | append: routes.search_url | append: '?q=' | append: search_placeholder | json }}
        },
        "query-input": "required name=search_term_string"
      }
    }
  </script>
{%- endif -%}

{%- liquid
  # Breadcrumb trail: Home, then the collection or blog the page belongs to.
  assign crumbs_names = ''
  assign crumbs_urls = ''
  case request.page_type
    when 'product'
      if collection
        assign crumbs_names = collection.title
        assign crumbs_urls = collection.url
      endif
      assign crumbs_names = crumbs_names | append: '|' | append: product.title
      assign crumbs_urls = crumbs_urls | append: '|' | append: product.url
    when 'collection'
      assign crumbs_names = collection.title
      assign crumbs_urls = collection.url
    when 'article'
      assign crumbs_names = blog.title | append: '|' | append: article.title
      assign crumbs_urls = blog.url | append: '|' | append: article.url
    when 'blog'
      assign crumbs_names = blog.title
      assign crumbs_urls = blog.url
    when 'page'
      assign crumbs_names = page.title
      assign crumbs_urls = page.url
  endcase
-%}
{%- if crumbs_names != blank -%}
  {%- assign crumb_names = crumbs_names | split: '|' -%}
  {%- assign crumb_urls = crumbs_urls | split: '|' -%}
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      "itemListElement": [
        {
          "@type": "ListItem",
          "position": 1,
          "name": {{ 'general.breadcrumbs.home' | t | json }},
          "item": {{ request.origin | json }}
        }
        {%- for name in crumb_names -%}
          {%- if name == blank -%}{%- continue -%}{%- endif -%}
          , {
            "@type": "ListItem",
            "position": {{ forloop.index | plus: 1 }},
            "name": {{ name | json }},
            "item": {{ request.origin | append: crumb_urls[forloop.index0] | json }}
          }
        {%- endfor -%}
      ]
    }
  </script>
{%- endif -%}

{%- if request.page_type == 'collection' and collection.products_count > 0 -%}
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "CollectionPage",
      "name": {{ collection.title | json }},
      "url": {{ request.origin | append: collection.url | json }},
      "mainEntity": {
        "@type": "ItemList",
        "numberOfItems": {{ collection.products_count }},
        "itemListElement": [
          {%- for item in collection.products limit: 12 -%}
            {%- unless forloop.first -%},{%- endunless -%}
            {
              "@type": "ListItem",
              "position": {{ forloop.index }},
              "url": {{ request.origin | append: item.url | json }},
              "name": {{ item.title | json }}
            }
          {%- endfor -%}
        ]
      }
    }
  </script>
{%- endif -%}
