<section
  class="fl-imgtext full-width color-{{ section.settings.color_scheme }}"
  {% render 'reveal' %}
  style="padding-block: {{ section.settings.padding_top }}px {{ section.settings.padding_bottom }}px;"
>
  <div class="fl-imgtext__inner">
    <div class="fl-imgtext__grid{% if section.settings.layout == 'text_first' %} fl-imgtext__grid--flip{% endif %}">
      <div class="fl-imgtext__media fl-imgtext__media--{{ section.settings.image_ratio }}">
        {%- liquid
          # First section of the page: this image is the largest paint, fetched
          # first. Lower down it waits (lazy) and leaves the bandwidth to the LCP.
          assign img_load = 'lazy'
          assign img_priority = 'auto'
          if section.index == 1
            assign img_load = 'eager'
            assign img_priority = 'high'
          endif
          # Half of the content width at most, gap deducted: the slot is one of
          # two equal columns inside the page margins, with a gap of
          # clamp(32px, 5vw, 72px). Half of the raw page width announced 640px
          # for a column that measures 582px, which fetched the 800w file
          # instead of the 600w one.
          assign page_margins = settings.min_page_margin | times: 2
          assign content_px = settings.max_page_width | minus: page_margins
          assign grid_gap = settings.max_page_width | times: 5 | divided_by: 100
          if grid_gap > 72
            assign grid_gap = 72
          elsif grid_gap < 32
            assign grid_gap = 32
          endif
          assign img_sizes_cap = content_px | minus: grid_gap | divided_by: 2
          # Between 750px and the page width the gap is 5vw, so a column is
          # 47.5vw less one page margin; past 1440px the gap is capped at 72px.
          assign wide_inset = settings.min_page_margin | plus: 36
          assign img_sizes = '(min-width: ' | append: settings.max_page_width | append: 'px) ' | append: img_sizes_cap | append: 'px, (min-width: 1440px) calc(50vw - ' | append: wide_inset | append: 'px), (min-width: 750px) calc(47.5vw - ' | append: settings.min_page_margin | append: 'px), calc(100vw - ' | append: page_margins | append: 'px)'
        -%}
        {%- if section.settings.image -%}
          {{
            section.settings.image
            | image_url: width: 1600
            | image_tag:
              widths: '400, 600, 800, 1000, 1200, 1600',
              sizes: img_sizes,
              class: 'fl-imgtext__img',
              alt: section.settings.image.alt,
              loading: img_load,
              fetchpriority: img_priority
          }}
        {%- else -%}
          {{ 'lifestyle-2' | placeholder_svg_tag: 'fl-imgtext__img fl-imgtext__img--placeholder' | replace: '<svg ', '<svg aria-hidden="true" focusable="false" ' }}
        {%- endif -%}
      </div>

      <div class="fl-imgtext__content">
        {%- for block in section.blocks -%}
          {%- case block.type -%}
            {%- when 'eyebrow' -%}
              {%- if block.settings.text != blank -%}
                <span class="fl-eyebrow" {{ block.shopify_attributes }}>{{ block.settings.text | escape }}</span>
              {%- endif -%}

            {%- when 'heading' -%}
              {%- if block.settings.heading != blank -%}
                <h2 class="fl-imgtext__heading" {{ block.shopify_attributes }}>
                  {{- block.settings.heading | escape -}}
                </h2>
              {%- endif -%}

            {%- when 'text' -%}
              {%- if block.settings.text != blank -%}
                <div class="fl-imgtext__text" {{ block.shopify_attributes }}>{{ block.settings.text }}</div>
              {%- endif -%}

            {%- when 'button' -%}
              {%- if block.settings.label != blank and block.settings.link != blank -%}
                <div class="fl-imgtext__cta" {{ block.shopify_attributes }}>
                  <a
                    class="fl-btn{% if block.settings.style == 'secondary' %} fl-btn--secondary{% endif %}"
                    href="{{ block.settings.link }}"
                  >{{ block.settings.label | escape }}</a>
                </div>
              {%- endif -%}
          {%- endcase -%}
        {%- endfor -%}
      </div>
    </div>
  </div>
</section>

{% stylesheet %}
  .fl-imgtext__inner {
    width: min(
      calc(var(--page-width) - var(--page-margin) * 2),
      calc(100% - var(--page-margin) * 2)
    );
    margin-inline: auto;
  }

  .fl-imgtext__grid {
    display: grid;
    gap: 28px;
  }

  .fl-imgtext__media {
    min-width: 0;
    overflow: hidden;
    border-radius: var(--radius-card);
    background-color: var(--color-surface);
  }

  .fl-imgtext__img {
    width: 100%;
  }

  .fl-imgtext__media--square .fl-imgtext__img {
    aspect-ratio: 1 / 1;
    object-fit: cover;
  }

  .fl-imgtext__media--portrait .fl-imgtext__img {
    aspect-ratio: 4 / 5;
    object-fit: cover;
  }

  .fl-imgtext__content {
    min-width: 0;
    max-width: 46ch;
  }

  .fl-imgtext__heading {
    margin-bottom: 16px;
  }

  .fl-imgtext__text > p + p {
    margin-top: 1em;
  }

  .fl-imgtext__cta {
    margin-top: 28px;
  }

  @media screen and (min-width: 750px) {
    .fl-imgtext__grid {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      align-items: center;
      gap: clamp(32px, 5vw, 72px);
    }

    .fl-imgtext__grid--flip .fl-imgtext__media {
      order: 2;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:names.image_with_text",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:labels.color_scheme",
      "default": "scheme-1"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "t:labels.image"
    },
    {
      "type": "select",
      "id": "layout",
      "label": "t:labels.desktop_layout",
      "options": [
        {
          "value": "image_first",
          "label": "t:labels.image_first"
        },
        {
          "value": "text_first",
          "label": "t:labels.text_first"
        }
      ],
      "default": "image_first",
      "info": "t:info.on_mobile_the_image_always_comes_first"
    },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "t:labels.image_ratio",
      "options": [
        {
          "value": "adapt",
          "label": "t:labels.adapt_to_image"
        },
        {
          "value": "square",
          "label": "t:labels.square_1_1"
        },
        {
          "value": "portrait",
          "label": "t:labels.portrait_4_5"
        }
      ],
      "default": "adapt"
    },
    {
      "type": "header",
      "content": "t:content.spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "t:labels.top_padding",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "t:labels.bottom_padding",
      "default": 48
    }
  ],
  "blocks": [
    {
      "type": "eyebrow",
      "name": "t:names.eyebrow",
      "limit": 1,
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "t:labels.eyebrow",
          "default": "Made to last"
        }
      ]
    },
    {
      "type": "heading",
      "name": "t:names.heading",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "t:labels.heading",
          "default": "Pair text with an image"
        }
      ]
    },
    {
      "type": "text",
      "name": "t:names.text",
      "settings": [
        {
          "type": "richtext",
          "id": "text",
          "label": "t:labels.text",
          "default": "<p>Use this section to describe a product, share your process, or tell the story behind your brand.</p>"
        }
      ]
    },
    {
      "type": "button",
      "name": "t:names.button",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "t:labels.button_label",
          "default": "Shop now"
        },
        {
          "type": "url",
          "id": "link",
          "label": "t:labels.button_link"
        },
        {
          "type": "select",
          "id": "style",
          "label": "t:labels.button_style",
          "options": [
            {
              "value": "primary",
              "label": "t:labels.primary"
            },
            {
              "value": "secondary",
              "label": "t:labels.secondary"
            }
          ],
          "default": "primary"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:names.image_with_text",
      "blocks": [
        {
          "type": "heading"
        },
        {
          "type": "text"
        },
        {
          "type": "button"
        }
      ]
    }
  ]
}
{% endschema %}
