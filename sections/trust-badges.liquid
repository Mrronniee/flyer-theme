{% comment %}
  Trust badges.
  Row of short reassurance items (shipping, returns, secure checkout…), each
  a 1.5px line icon beside a title and a one-line text, separated by vertical
  hairlines on desktop. Icons are inline SVG chosen from a fixed set. Row
  layout keeps everything on one centred line; grid layout stacks 2×2 on
  mobile. No JavaScript.
{% endcomment %}

{%- liquid
  assign grid = false
  if section.settings.layout == 'grid'
    assign grid = true
  endif
-%}

<section
  class="fl-trust full-width color-{{ section.settings.color_scheme }}"
  {% render 'reveal' %}
  style="padding-block: {{ section.settings.padding_top }}px {{ section.settings.padding_bottom }}px; --fl-trust-icon: {{ section.settings.icon_size }}px"
>
  <div class="fl-trust__inner">
    {%- if section.blocks.size > 0 -%}
      <ul
        class="fl-trust__list{% if grid %} fl-trust__list--grid{% else %} fl-trust__list--row{% endif %}{% if section.settings.show_dividers %} fl-trust__list--dividers{% endif %}"
      >
        {%- for block in section.blocks -%}
          {%- liquid
            assign tag = 'div'
            if block.settings.link != blank
              assign tag = 'a'
            endif
          -%}
          <li class="fl-trust__item" {{ block.shopify_attributes }}>
            <{{ tag }}
              class="fl-trust__badge"
              {% if tag == 'a' %}
                href="{{ block.settings.link }}"
              {% endif %}
            >
              <span class="fl-trust__icon" aria-hidden="true">
                <svg
                  width="24"
                  height="24"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.5"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  focusable="false"
                >
                  {%- case block.settings.icon -%}
                    {%- when 'truck' -%}
                      <path d="M3 6.5h10.5v9H3zM13.5 9.5H17l3 3v3h-6.5"/>
                      <circle cx="7" cy="17.5" r="1.75"/>
                      <circle cx="17" cy="17.5" r="1.75"/>
                    {%- when 'box' -%}
                      <path d="M12 3.5 20 7.5v9l-8 4-8-4v-9zM12 11.5l8-4M12 11.5 4 7.5M12 11.5v9"/>
                    {%- when 'return' -%}
                      <path d="M4 10.5h11a4 4 0 0 1 0 8H9M4 10.5l3.5-3.5M4 10.5 7.5 14"/>
                    {%- when 'lock' -%}
                      <rect x="5" y="10.5" width="14" height="10" rx="1.5"/>
                      <path d="M8 10.5V7.5a4 4 0 0 1 8 0v3M12 14.5v2.5"/>
                    {%- when 'card' -%}
                      <rect x="3" y="5.5" width="18" height="13" rx="1.5"/>
                      <path d="M3 9.5h18M6.5 14.5h4"/>
                    {%- when 'leaf' -%}
                      <path d="M5 19c0-8 4-13 14-14 0 9-4 14-11 14M5 19c3-4 6-7 10-9"/>
                    {%- when 'star' -%}
                      <path d="M12 3.5l2.6 5.5 6 .7-4.4 4.1 1.2 6L12 16.8l-5.4 3 1.2-6-4.4-4.1 6-.7z"/>
                    {%- when 'chat' -%}
                      <path d="M4 5.5h16v10H9l-4 3.5v-3.5H4z"/>
                      <path d="M8 10.5h8"/>
                    {%- when 'globe' -%}
                      <circle cx="12" cy="12" r="8.5"/>
                      <path d="M3.5 12h17M12 3.5c2.5 2.5 3.5 5.5 3.5 8.5s-1 6-3.5 8.5c-2.5-2.5-3.5-5.5-3.5-8.5s1-6 3.5-8.5"/>
                    {%- when 'gift' -%}
                      <rect x="3.5" y="8.5" width="17" height="4" rx="1"/>
                      <path d="M5 12.5v8h14v-8M12 8.5v12M12 8.5c-1.5-2-4-4-5-2.5s1 2.5 5 2.5c4 0 6-1 5-2.5s-3.5-.5-5 2.5"/>
                  {%- endcase -%}
                </svg>
              </span>
              <span class="fl-trust__text">
                {%- if block.settings.heading != blank -%}
                  <span class="fl-trust__heading">{{ block.settings.heading | escape }}</span>
                {%- endif -%}
                {%- if block.settings.text != blank -%}
                  <span class="fl-trust__desc">{{ block.settings.text | escape }}</span>
                {%- endif -%}
              </span>
            </{{ tag }}>
          </li>
        {%- endfor -%}
      </ul>
    {%- elsif request.design_mode -%}
      <p class="fl-editor-empty">{{ 'general.editor.empty_section' | t }}</p>
    {%- endif -%}
  </div>
</section>

{% stylesheet %}
  .fl-trust__inner {
    width: var(--content-width);
    margin-inline: auto;
  }

  .fl-trust__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 24px 16px;
  }

  .fl-trust__list--row {
    grid-template-columns: minmax(0, 1fr);
  }

  .fl-trust__list--grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .fl-trust__item {
    min-width: 0;
  }

  .fl-trust__badge {
    overflow-wrap: anywhere;
    display: flex;
    align-items: flex-start;
    gap: 14px;
    min-height: 44px;
    color: inherit;
    text-decoration: none;
  }

  a.fl-trust__badge:hover .fl-trust__heading {
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  .fl-trust__icon {
    flex: 0 0 auto;
    display: inline-flex;
    width: var(--fl-trust-icon, 24px);
    height: var(--fl-trust-icon, 24px);
    color: var(--color-ink);
  }

  .fl-trust__icon svg {
    width: 100%;
    height: 100%;
  }

  .fl-trust__text {
    display: flex;
    flex-direction: column;
    gap: 2px;
    min-width: 0;
  }

  .fl-trust__heading {
    font-size: 0.9375em;
    font-weight: 500;
    line-height: 1.35;
  }

  .fl-trust__desc {
    font-size: 0.875em;
    line-height: 1.4;
    color: var(--color-muted);
  }

  @media (min-width: 750px) {
    .fl-trust__list--row,
    .fl-trust__list--grid {
      display: flex;
      flex-wrap: wrap;
      justify-content: center;
      gap: 24px 0;
    }

    .fl-trust__item {
      /* A zero flex-basis meant four badges never wrapped, so at 175% text
         zoom the last one's text ran off the page. */
      flex: 1 1 180px;
      padding-inline: 32px;
    }

    .fl-trust__list--grid .fl-trust__item {
      flex-basis: 25%;
    }

    .fl-trust__list--dividers .fl-trust__item + .fl-trust__item {
      border-inline-start: 1px solid var(--color-line);
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:names.trust_badges",
  "max_blocks": 6,
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:labels.color_scheme",
      "default": "scheme-1"
    },
    {
      "type": "select",
      "id": "layout",
      "label": "t:labels.layout",
      "options": [
        {
          "value": "row",
          "label": "t:labels.one_row"
        },
        {
          "value": "grid",
          "label": "t:labels.grid_2_columns_on_mobile"
        }
      ],
      "default": "grid"
    },
    {
      "type": "checkbox",
      "id": "show_dividers",
      "label": "t:labels.show_dividers_on_desktop",
      "default": true
    },
    {
      "type": "range",
      "id": "icon_size",
      "min": 20,
      "max": 40,
      "step": 4,
      "unit": "px",
      "label": "t:labels.icon_size",
      "default": 24
    },
    {
      "type": "header",
      "content": "t:content.spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "t:labels.top_padding",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "t:labels.bottom_padding",
      "default": 48
    }
  ],
  "blocks": [
    {
      "type": "badge",
      "name": "t:names.badge",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "t:labels.icon",
          "options": [
            {
              "value": "truck",
              "label": "t:labels.truck"
            },
            {
              "value": "box",
              "label": "t:labels.box"
            },
            {
              "value": "return",
              "label": "t:labels.return_arrow"
            },
            {
              "value": "lock",
              "label": "t:labels.lock"
            },
            {
              "value": "card",
              "label": "t:labels.payment_card"
            },
            {
              "value": "leaf",
              "label": "t:labels.leaf"
            },
            {
              "value": "star",
              "label": "t:labels.star"
            },
            {
              "value": "chat",
              "label": "t:labels.chat_bubble"
            },
            {
              "value": "globe",
              "label": "t:labels.globe"
            },
            {
              "value": "gift",
              "label": "t:labels.gift"
            }
          ],
          "default": "truck"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "t:labels.heading",
          "default": "Shipping"
        },
        {
          "type": "text",
          "id": "text",
          "label": "t:labels.text",
          "default": "Describe your delivery options."
        },
        {
          "type": "url",
          "id": "link",
          "label": "t:labels.link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:names.trust_badges",
      "blocks": [
        {
          "type": "badge",
          "settings": {
            "icon": "truck",
            "heading": "Shipping",
            "text": "Describe your delivery options."
          }
        },
        {
          "type": "badge",
          "settings": {
            "icon": "return",
            "heading": "Returns",
            "text": "Describe your returns policy."
          }
        },
        {
          "type": "badge",
          "settings": {
            "icon": "lock",
            "heading": "Secure checkout",
            "text": "Payments are encrypted at checkout."
          }
        },
        {
          "type": "badge",
          "settings": {
            "icon": "leaf",
            "heading": "Our story",
            "text": "Tell customers what makes your store different."
          }
        }
      ]
    }
  ]
}
{% endschema %}
