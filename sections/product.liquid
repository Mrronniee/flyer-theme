{% comment %}
  Main product section (product template).
  Two columns >= 990px: gallery 55% / sticky info 45%, stacked on mobile.
  Info column is block-based (reorderable in the editor).
  <fl-product> handles gallery swap, variant selection, price/availability
  updates and add-to-cart button states. Works without JS (native form post).
{% endcomment %}

{%- liquid
  assign current_variant = product.selected_or_first_available_variant
  assign product_form_id = 'ProductForm-' | append: section.id

  # The hidden id field may only be disabled when the <noscript> select is
  # actually rendered to replace it. That select lives inside the
  # variant_picker block AND behind has_only_default_variant: on a
  # single-variant product — or if the merchant removes the block — disabling
  # the field left the native POST without any id, and Shopify answered 400.
  assign has_noscript_variant_select = false
  unless product.has_only_default_variant
    for block in section.blocks
      if block.type == 'variant_picker'
        assign has_noscript_variant_select = true
        break
      endif
    endfor
  endunless
  # Wider than the page width, the slot stops growing: cap the size so a
  # wide screen does not fetch images for a width it never gets. The gallery
  # is the 55fr column of a 55/45 grid with a 64px gap, inside the page
  # margins (CSS below): 55% of the raw page width announced 704px for a
  # column that measures 642px, and 100vw announced 412px on a phone for a
  # slot of 364px.
  assign page_margins = settings.min_page_margin | times: 2
  assign content_px = settings.max_page_width | minus: page_margins
  assign gallery_sizes_cap = content_px | minus: 64 | times: 55 | divided_by: 100
  assign gallery_inset = page_margins | plus: 64 | times: 55 | divided_by: 100
  assign gallery_sizes = '(min-width: ' | append: settings.max_page_width | append: 'px) ' | append: gallery_sizes_cap | append: 'px, (max-width: 989px) calc(100vw - ' | append: page_margins | append: 'px), calc(55vw - ' | append: gallery_inset | append: 'px)'
-%}

<fl-product
  class="fl-product"
  style="padding-block: {{ section.settings.padding_top }}px {{ section.settings.padding_bottom }}px"
  data-text-add="{{ 'products.product.add_to_cart' | t }}"
  data-text-adding="{{ 'products.product.adding' | t }}"
  data-text-added="{{ 'products.product.added_to_cart' | t }}"
  data-text-soldout="{{ 'products.product.sold_out' | t }}"
  data-text-unavailable="{{ 'products.product.unavailable' | t }}"
  data-text-regular="{{ 'products.card.regular_price' | t }}"
  data-text-sale="{{ 'products.card.sale_price' | t }}"
  data-section-id="{{ section.id }}"
>
  <div class="fl-product__grid">
    {%- comment -%} Gallery {%- endcomment -%}
    <div class="fl-product__gallery" role="group" aria-label="{{ 'products.product.media_label' | t }}">
      <div class="fl-gallery__viewer">
        {%- if product.media.size > 0 -%}
          {%- for media in product.media -%}
            <div
              class="fl-gallery__media fl-media"
              data-media-item
              data-media-id="{{ media.id }}"
              {% unless forloop.first %}
                hidden
              {% endunless %}
            >
              {%- if media.media_type == 'image' -%}
                {%- liquid
                  assign media_alt = media.alt | default: product.title | escape
                  # The first image is the one on screen at load, and the
                  # largest paint of the page: fetch it before the others.
                  assign load = 'lazy'
                  assign priority = 'auto'
                  if forloop.first
                    assign load = 'eager'
                    assign priority = 'high'
                  endif
                -%}
                {{
                  media.preview_image
                  | image_url: width: 1600
                  | image_tag: widths: '400, 600, 700, 800, 1200, 1600', sizes: gallery_sizes, alt: media_alt, loading: load, fetchpriority: priority
                }}
              {%- else -%}
                {%- liquid
                  assign media_hidden = true
                  if forloop.first
                    assign media_hidden = false
                  endif
                  render 'media-player', media: media, priority: forloop.first, hidden: media_hidden
                -%}
              {%- endif -%}
            </div>
          {%- endfor -%}
        {%- else -%}
          <div class="fl-gallery__media fl-media" data-media-item>
            {{ 'product-1' | placeholder_svg_tag: 'fl-gallery__placeholder' | replace: '<svg ', '<svg aria-hidden="true" focusable="false" ' }}
          </div>
        {%- endif -%}
      </div>

      {%- if product.media.size > 1 -%}
        <div class="fl-gallery__thumbs">
          {%- for media in product.media -%}
            {%- liquid
              case media.media_type
                when 'video', 'external_video'
                  assign media_item_key = 'products.product.media_item_video'
                when 'model'
                  assign media_item_key = 'products.product.media_item_model'
                else
                  assign media_item_key = 'products.product.media_item'
              endcase
            -%}
            <button
              type="button"
              class="fl-gallery__thumb"
              data-thumb
              data-media-id="{{ media.id }}"
              aria-label="{{ media_item_key | t: index: forloop.index, count: product.media.size }}"
              {% if forloop.first %}
                aria-current="true"
              {% endif %}
            >
              {{
                media.preview_image
                | image_url: width: 160
                | image_tag: widths: '80, 120, 160', sizes: '64px', alt: '', loading: 'lazy'
              }}
            </button>
          {%- endfor -%}
        </div>
      {%- endif -%}
    </div>

    {%- comment -%} Info column (blocks) {%- endcomment -%}
    <div class="fl-product__info">
      {%- for block in section.blocks -%}
        {%- case block.type -%}
          {%- when '@app' -%}
            {% render block %}

          {%- when 'title' -%}
            <div class="fl-product__block" {{ block.shopify_attributes }}>
              {%- if block.settings.show_vendor and product.vendor != blank -%}
                <p class="fl-product__vendor">
                  <span class="visually-hidden">{{ 'products.product.vendor' | t }}{{ 'general.colon' | t }} </span>
                  {{- product.vendor | escape -}}
                </p>
              {%- endif -%}
              {%- if settings.wishlist_enabled -%}
                <div class="fl-wishlist-row">
                  <h1 class="fl-product__title">{{ product.title | escape }}</h1>
                  {% render 'wishlist-button', product: product, class: 'fl-wishlist-btn--title' %}
                </div>
              {%- else -%}
                <h1 class="fl-product__title">{{ product.title | escape }}</h1>
              {%- endif -%}
            </div>

          {%- when 'price' -%}
            <div class="fl-product__block" {{ block.shopify_attributes }}>
              <div class="fl-product__price" data-price aria-live="polite">
                {% render 'price', product: product, variant: current_variant, show_from: false %}
              </div>
              {%- if cart.taxes_included -%}
                <p class="fl-product__tax">{{ 'products.product.taxes_included' | t }}</p>
              {%- endif -%}
            </div>

          {%- when 'variant_picker' -%}
            {%- unless product.has_only_default_variant -%}
              <div class="fl-product__block" {{ block.shopify_attributes }}>
                {%- for option in product.options_with_values -%}
                  {%- assign option_loop_index = forloop.index -%}
                  <fieldset class="fl-product__option" data-option-fieldset>
                    <legend class="fl-product__legend">
                      {{ option.name | escape }}{{ 'general.colon' | t }}
                      <span class="fl-product__legend-value" data-option-value>{{ option.selected_value | escape }}</span>
                    </legend>
                    <div class="fl-product__values">
                      {%- for value in option.values -%}
                        {%- assign input_id = 'Option-' | append: section.id | append: '-' | append: option_loop_index | append: '-' | append: forloop.index -%}
                        <input
                          type="radio"
                          id="{{ input_id }}"
                          class="visually-hidden fl-product__radio"
                          name="Option-{{ section.id }}-{{ option_loop_index }}"
                          value="{{ value | escape }}"
                          {% if option.selected_value == value %}
                            checked
                          {% endif %}
                        >
                        <label class="fl-product__value" for="{{ input_id }}">
                          {{ value | escape }}
                          <span class="visually-hidden" data-value-status></span>
                        </label>
                      {%- endfor -%}
                    </div>
                  </fieldset>
                {%- endfor -%}

                {%- comment -%}
                  Without JS the radios are decorative: they carry no name="id"
                  and the hidden id field is only rewritten by <fl-product>, so
                  submitting bought the first variant whatever was ticked.
                  This select is the real control when scripting is off.
                {%- endcomment -%}
                <noscript>
                  <div class="fl-product__nojs">
                    <label class="fl-label" for="NoJsVariant-{{ section.id }}">
                      {{ 'products.product.choose_variant' | t }}
                    </label>
                    <select
                      id="NoJsVariant-{{ section.id }}"
                      class="fl-select"
                      name="id"
                      form="{{ product_form_id }}"
                    >
                      {%- for variant in product.variants -%}
                        <option
                          value="{{ variant.id }}"
                          {% if variant == current_variant %}
                            selected
                          {% endif %}
                          {% unless variant.available %}
                            disabled
                          {% endunless %}
                        >
                          {{ variant.title }}
                          {%- unless variant.available %} — {{ 'products.card.sold_out' | t }}{% endunless -%}
                          —
                              {%- if settings.currency_code_enabled -%}
                                {{ variant.price | money_with_currency }}
                              {%- else -%}
                                {{ variant.price | money }}
                              {%- endif -%}
                        </option>
                      {%- endfor -%}
                    </select>
                  </div>
                </noscript>
              </div>
            {%- endunless -%}

          {%- when 'quantity' -%}
            <div class="fl-product__block" {{ block.shopify_attributes }}>
              <label class="fl-label" for="Quantity-{{ section.id }}">{{ 'products.product.quantity' | t }}</label>
              <div class="fl-qty">
                <button
                  type="button"
                  class="fl-qty__btn"
                  data-qty-minus
                  aria-label="{{ 'products.product.decrease_quantity' | t: title: product.title }}"
                >
                  &minus;
                </button>
                <input
                  type="number"
                  id="Quantity-{{ section.id }}"
                  class="fl-qty__input"
                  name="quantity"
                  value="1"
                  min="1"
                  inputmode="numeric"
                  autocomplete="off"
                  form="{{ product_form_id }}"
                  data-qty-input
                >
                <button
                  type="button"
                  class="fl-qty__btn"
                  data-qty-plus
                  aria-label="{{ 'products.product.increase_quantity' | t: title: product.title }}"
                >
                  +
                </button>
              </div>
            </div>

          {%- when 'buy_buttons' -%}
            <div class="fl-product__block fl-product__buy" {{ block.shopify_attributes }}>
              {% form 'product', product, id: product_form_id, data-product-form: '' %}
                {%- comment -%}
                  Disabled only when the <noscript> select really replaces it
                  (multi-variant product + variant_picker block present);
                  <fl-product> re-enables it on upgrade. Otherwise the field
                  stays enabled so the native no-JS POST carries the id.
                {%- endcomment -%}
                <input
                  type="hidden"
                  name="id"
                  value="{{ current_variant.id }}"
                  data-variant-input
                  {% if has_noscript_variant_select %}disabled{% endif %}
                >

                {%- if product.gift_card? -%}
                  {%- comment -%}
                    Gift card product: Shopify mails the card to the recipient
                    when the line carries these properties, the checkbox
                    (__shopify_send_gift_card_to_recipient) being the switch.
                    Everything is optional, so a buyer who keeps the card for
                    themselves submits as before, and it all works without
                    JavaScript: the fields belong to the product form.
                  {%- endcomment -%}
                  {%- assign gift_prefix = product_form_id | append: '-gift' -%}
                  <div class="fl-product__gift">
                    <div class="fl-product__gift-switch">
                      <input
                        type="checkbox"
                        id="{{ gift_prefix }}-send"
                        name="properties[__shopify_send_gift_card_to_recipient]"
                        value="on"
                      >
                      <label for="{{ gift_prefix }}-send">
                        {{- 'products.product.gift_card.send_to_recipient' | t -}}
                      </label>
                    </div>

                    <div class="fl-field">
                      <label class="fl-label" for="{{ gift_prefix }}-email">
                        {{- 'products.product.gift_card.recipient_email' | t -}}
                      </label>
                      <input
                        type="email"
                        id="{{ gift_prefix }}-email"
                        class="fl-input"
                        name="properties[Recipient email]"
                        autocomplete="off"
                        autocapitalize="off"
                        autocorrect="off"
                      >
                    </div>

                    <div class="fl-field">
                      <label class="fl-label" for="{{ gift_prefix }}-name">
                        {{- 'products.product.gift_card.recipient_name' | t -}}
                      </label>
                      <input
                        type="text"
                        id="{{ gift_prefix }}-name"
                        class="fl-input"
                        name="properties[Recipient name]"
                        autocomplete="off"
                      >
                    </div>

                    <div class="fl-field">
                      <label class="fl-label" for="{{ gift_prefix }}-message">
                        {{- 'products.product.gift_card.message' | t -}}
                      </label>
                      <textarea
                        id="{{ gift_prefix }}-message"
                        class="fl-textarea"
                        name="properties[Message]"
                        rows="3"
                        maxlength="200"
                        aria-describedby="{{ gift_prefix }}-message-help"
                      ></textarea>
                      <span class="fl-product__gift-help" id="{{ gift_prefix }}-message-help">
                        {{- 'products.product.gift_card.message_limit' | t -}}
                      </span>
                    </div>

                    <div class="fl-field">
                      <label class="fl-label" for="{{ gift_prefix }}-send-on">
                        {{- 'products.product.gift_card.send_on' | t -}}
                      </label>
                      <input
                        type="date"
                        id="{{ gift_prefix }}-send-on"
                        class="fl-input"
                        name="properties[Send on]"
                      >
                    </div>
                  </div>
                {%- endif -%}

                <button
                  type="submit"
                  name="add"
                  class="fl-btn fl-product__add"
                  data-add-button
                  {% unless current_variant.available %}
                    disabled
                  {% endunless %}
                >
                  <span data-add-label>
                    {%- if current_variant.available -%}
                      {{ 'products.product.add_to_cart' | t }}
                    {%- else -%}
                      {{ 'products.product.sold_out' | t }}
                    {%- endif -%}
                  </span>
                </button>
                <span class="visually-hidden" role="status" data-add-status></span>
                {%- if block.settings.show_dynamic_checkout -%}
                  {{ form | payment_button }}
                  {{ form | payment_terms }}
                {%- endif -%}
              {% endform %}
              {%- comment -%}
                In-store pickup of the selected variant (locations with local
                pickup only). Refreshed on variant change by <fl-product>
                through the Section Rendering API.
              {%- endcomment -%}
              <div class="fl-pickup" data-pickup>
                {% render 'pickup-availability', variant: current_variant %}
              </div>
            </div>

          {%- when 'description' -%}
            {%- if product.description != blank -%}
              <div class="fl-product__block fl-rte" {{ block.shopify_attributes }}>
                {{ product.description }}
              </div>
            {%- endif -%}

          {%- when 'collapsible_tab' -%}
            {%- comment -%}
              A tab whose heading and content are both empty is not rendered at
              all: an empty <summary> is a control with no accessible name, and
              the merchant sees the block in the editor either way.
            {%- endcomment -%}
            {%- if block.settings.heading != blank or block.settings.content != blank -%}
              <details class="fl-product__details" {{ block.shopify_attributes }}>
                <summary class="fl-product__summary">
                  <span>
                    {%- if block.settings.heading != blank -%}
                      {{- block.settings.heading | escape -}}
                    {%- else -%}
                      {{- 'products.product.details' | t -}}
                    {%- endif -%}
                  </span>
                  <span class="fl-product__summary-icon" aria-hidden="true"></span>
                </summary>
                {%- if block.settings.content != blank -%}
                  <div class="fl-product__details-body fl-rte">
                    {{ block.settings.content }}
                  </div>
                {%- endif -%}
              </details>
            {%- endif -%}

          {%- when 'text' -%}
            {%- if block.settings.text != blank -%}
              <p class="fl-product__text" {{ block.shopify_attributes }}>{{ block.settings.text | escape }}</p>
            {%- endif -%}

          {%- when 'custom_liquid' -%}
            {%- if block.settings.custom_liquid != blank -%}
              <div class="fl-product__block fl-product__liquid" {{ block.shopify_attributes }}>
                {{ block.settings.custom_liquid }}
              </div>
            {%- elsif request.design_mode -%}
              <p class="fl-editor-empty" {{ block.shopify_attributes }}>{{ 'general.editor.empty_block' | t }}</p>
            {%- endif -%}
        {%- endcase -%}
      {%- endfor -%}
    </div>
  </div>

  <script type="application/json" data-variants-json>
    {{ product.variants | json }}
  </script>
  {%- comment -%}
    Pre-rendered amounts injected by <fl-product> on variant change. They must
    use the SAME format as snippets/price.liquid, otherwise the currency code
    vanished as soon as a variant was picked. Liquid has no dynamic filter name,
    so the format is resolved per variant up front.
  {%- endcomment -%}
  <script type="application/json" data-money-json>
    {
      {%- for v in product.variants -%}
        {%- liquid
          if settings.currency_code_enabled
            assign v_amount = v.price | money_with_currency
            assign v_compare_amount = v.compare_at_price | money_with_currency
            assign v_unit_amount = v.unit_price | money_with_currency
          else
            assign v_amount = v.price | money
            assign v_compare_amount = v.compare_at_price | money
            assign v_unit_amount = v.unit_price | money
          endif
        -%}
        "{{ v.id }}": {
          "price": {{ v_amount | json }},
          "compare": {% if v.compare_at_price > v.price %}{{ v_compare_amount | json }}{% else %}null{% endif %},
          "available": {{ v.available | json }},
          "unit": {% if v.unit_price_measurement %}{{ v_unit_amount | json }}{% else %}null{% endif %},
          "unitRef": {% if v.unit_price_measurement %}{{ v.unit_price_measurement.reference_value | json }}{% else %}null{% endif %},
          "unitUnit": {% if v.unit_price_measurement %}{{ v.unit_price_measurement.reference_unit | json }}{% else %}null{% endif %}
        }
        {%- unless forloop.last -%},{%- endunless -%}
      {%- endfor -%}
    }
  </script>
</fl-product>

{% stylesheet %}
  .fl-product {
    display: block;
  }

  .fl-product__grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 32px;
  }

  /* --- Gallery --- */
  .fl-product__gallery {
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  /* Border, radius and shadow come from the theme settings (Media), through
     .fl-media in critical.css. */

  .fl-gallery__media img,
  .fl-gallery__media video,
  .fl-gallery__media iframe,
  .fl-gallery__media model-viewer {
    width: 100%;
  }

  .fl-gallery__placeholder {
    width: 100%;
    aspect-ratio: var(--card-ratio);
  }

  .fl-gallery__thumbs {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .fl-gallery__thumb {
    width: 64px;
    height: 64px;
    padding: 0;
    overflow: hidden;
    border: 1px solid var(--color-line);
    border-radius: var(--radius-btn);
    background: var(--color-surface);
    cursor: pointer;
    transition: border-color 0.15s ease;
  }

  .fl-gallery__thumb:hover {
    border-color: var(--color-muted);
  }

  /* 2px ring, not only a darker border: the media in view does not rest on
     colour alone (WCAG 1.4.1). */
  .fl-gallery__thumb[aria-current='true'] {
    border-color: var(--color-ink);
    box-shadow: inset 0 0 0 1px var(--color-ink);
  }

  .fl-gallery__thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* --- Info column --- */
  .fl-product__info {
    min-width: 0;
  }

  .fl-product__info > * + * {
    margin-block-start: 20px;
  }

  .fl-product__info > .fl-product__details + .fl-product__details {
    margin-block-start: 0;
  }

  .fl-product__vendor {
    margin-bottom: 6px;
    font-size: 0.8125em;
    color: var(--color-muted);
  }

  .fl-product__title {
    margin: 0;
  }

  .fl-product__price {
    font-size: 1.125em;
  }

  .fl-product__tax {
    margin-top: 4px;
    font-size: 0.8125em;
    color: var(--color-muted);
  }

  /* --- Variant picker --- */
  .fl-product__option {
    min-width: 0;
    margin: 0 0 16px;
    padding: 0;
    border: 0;
  }

  .fl-product__option:last-child {
    margin-bottom: 0;
  }

  .fl-product__legend {
    padding: 0 0 10px;
    font-size: 0.875em;
    color: var(--color-muted);
  }

  .fl-product__legend-value {
    color: var(--color-ink);
  }

  .fl-product__values {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  /* Theme settings > Variant pills drive border / radius / shadow. */
  .fl-product__value {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 44px;
    min-height: 44px;
    padding: 8px 16px;
    border: var(--pill-border-width, 1px) solid
      rgba(var(--color-ink-rgb), var(--pill-border-opacity, 0.55));
    border-radius: var(--pill-radius, 4px);
    box-shadow: var(--pill-shadow);
    background: var(--color-bg);
    cursor: pointer;
    transition: border-color 0.15s ease, background 0.15s ease, color 0.15s ease;
  }

  .fl-product__value:hover {
    border-color: var(--color-ink);
  }

  .fl-product__value.is-soldout {
    color: var(--color-muted);
    text-decoration: line-through;
  }

  .fl-product__value.is-unavailable {
    color: var(--color-muted);
    border-style: dashed;
  }

  .fl-product__radio:checked + .fl-product__value {
    border-color: var(--color-ink);
    background: var(--color-ink);
    color: var(--color-bg);
  }

  /* Chosen but sold out: no fill, so a 2px ink ring (not a shade of grey)
     tells it apart from the other sold-out values (WCAG 1.4.1). */
  .fl-product__radio:checked + .fl-product__value.is-soldout,
  .fl-product__radio:checked + .fl-product__value.is-unavailable {
    border-color: var(--color-ink);
    box-shadow: inset 0 0 0 1px var(--color-ink);
    background: transparent;
    color: var(--color-muted);
  }

  .fl-product__radio:focus-visible + .fl-product__value {
    outline: 2px solid var(--color-ink);
    outline-offset: 2px;
  }

  /* --- Quantity stepper --- */
  .fl-qty {
    display: inline-flex;
    align-items: stretch;
    overflow: hidden;
    border: 1px solid var(--color-control-border);
    border-radius: var(--radius-input);
  }

  .fl-qty__btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    min-height: 44px;
    border: 0;
    background: var(--color-bg);
    color: var(--color-ink);
    font-size: 1.125em;
    cursor: pointer;
    transition: background 0.15s ease;
  }

  .fl-qty__btn:hover {
    background: var(--color-surface);
  }

  .fl-product__gift {
    margin-bottom: 18px;
  }

  .fl-product__gift-switch {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 14px;
  }

  .fl-product__gift-help {
    display: block;
    margin-top: 4px;
    font-size: 0.8125em;
    color: var(--color-muted);
  }

  /* The stepper clips its children to its rounded border (overflow: hidden),
     which also clipped the 2px focus ring of the buttons and the field: the
     ring is drawn inside instead. */
  .fl-qty__btn:focus-visible,
  .fl-qty__input:focus-visible {
    outline-offset: -2px;
  }

  .fl-qty__input {
    width: 56px;
    min-height: 44px;
    padding: 0;
    border: 0;
    text-align: center;
    background: var(--color-bg);
    color: var(--color-ink);
    appearance: textfield;
  }

  .fl-qty__input::-webkit-outer-spin-button,
  .fl-qty__input::-webkit-inner-spin-button {
    appearance: none;
    margin: 0;
  }

  /* --- Buy buttons --- */
  .fl-product__add {
    width: 100%;
  }

  .fl-product__buy .shopify-payment-button {
    margin-top: 12px;
  }

  /* --- Collapsible rows --- */
  .fl-product__details {
    border-top: 1px solid var(--color-line);
  }

  .fl-product__details:last-of-type {
    border-bottom: 1px solid var(--color-line);
  }

  .fl-product__summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    min-height: 44px;
    padding: 12px 0;
    font-weight: 500;
    cursor: pointer;
    list-style: none;
  }

  .fl-product__summary::-webkit-details-marker {
    display: none;
  }

  .fl-product__summary-icon::after {
    content: '+';
    color: var(--color-muted);
  }

  .fl-product__details[open] > .fl-product__summary .fl-product__summary-icon::after {
    content: '−';
  }

  .fl-product__details-body {
    padding-bottom: 16px;
  }

  /* --- Text block --- */
  .fl-product__text {
    font-size: 0.9375em;
    color: var(--color-muted);
  }

  /* --- Rich text (description, tab content) --- */
  .fl-rte {
    line-height: 1.7;
  }

  .fl-rte p {
    margin-block: 0 0.9em;
  }

  .fl-rte ul,
  .fl-rte ol {
    margin-block: 0 0.9em;
    padding-inline-start: 1.2em;
  }

  .fl-rte h2,
  .fl-rte h3,
  .fl-rte h4 {
    margin-block: 1.2em 0.5em;
  }

  .fl-rte img {
    margin-block: 0.5em;
    border-radius: var(--radius-card);
  }

  /* Spacing only: the width of a rich-text table belongs to critical.css,
     which makes it as wide as its content and lets it scroll inside the text
     column. A width here would win over that rule — same specificity, and
     section stylesheets are loaded after critical.css — and the table would be
     squeezed into the column instead of scrolling (measured 525.61px at 1440
     on a twelve-column table, 1.8.20). */
  .fl-rte table {
    margin-block: 0 0.9em;
  }

  .fl-rte th,
  .fl-rte td {
    padding: 8px 10px;
    border: 1px solid var(--color-line);
    text-align: left;
  }

  .fl-rte blockquote {
    margin: 0 0 0.9em;
    padding-inline-start: 16px;
    border-inline-start: 2px solid var(--color-line);
    color: var(--color-muted);
  }

  /* --- Two columns on desktop --- */
  @media (min-width: 990px) {
    .fl-product__grid {
      grid-template-columns: minmax(0, 55fr) minmax(0, 45fr);
      gap: 64px;
      align-items: start;
    }

    .fl-product__info {
      position: sticky;
      top: var(--sticky-offset);
    }
  }
{% endstylesheet %}

{% javascript %}
  if (!customElements.get('fl-product')) {
    customElements.define(
      'fl-product',
      class extends HTMLElement {
        connectedCallback() {
          this.form = this.querySelector('[data-product-form]');
          this.variantInput = this.querySelector('[data-variant-input]');
          // Scripting is on, so this field is now the source of truth.
          if (this.variantInput) this.variantInput.disabled = false;
          this.addButton = this.querySelector('[data-add-button]');
          this.addLabel = this.querySelector('[data-add-label]');
          this.addStatus = this.querySelector('[data-add-status]');
          this.priceTarget = this.querySelector('[data-price]');

          this.variants = [];
          this.money = {};
          try {
            const variantsEl = this.querySelector('[data-variants-json]');
            const moneyEl = this.querySelector('[data-money-json]');
            if (variantsEl) this.variants = JSON.parse(variantsEl.textContent);
            if (moneyEl) this.money = JSON.parse(moneyEl.textContent);
          } catch (error) {
            this.variants = [];
            this.money = {};
          }

          this.fieldsets = Array.from(this.querySelectorAll('[data-option-fieldset]'));
          this.fieldsets.forEach((fieldset) => {
            fieldset.addEventListener('change', () => this.onOptionChange());
          });
          if (this.fieldsets.length) this.refreshCombos();

          this.initGallery();
          this.initQuantity();
          this.initFormStates();
        }

        disconnectedCallback() {
          if (this._onCartChange) document.removeEventListener('fl:cart:change', this._onCartChange);
          window.clearTimeout(this._revertTimer);
        }

        /* --- Gallery --- */
        initGallery() {
          this.thumbs = Array.from(this.querySelectorAll('[data-thumb]'));
          this.thumbs.forEach((button) => {
            button.addEventListener('click', () => this.showMedia(button.dataset.mediaId));
          });
        }

        showMedia(id) {
          const target = this.querySelector('[data-media-item][data-media-id="' + id + '"]');
          if (!target) return;
          this.querySelectorAll('[data-media-item]').forEach((item) => {
            if (item !== target && !item.hidden) this.pauseMedia(item);
            item.hidden = item !== target;
          });
          // A video on a hidden slide waits for its poster and for the
          // fallback image inside it (media-player).
          target.querySelectorAll('video[data-poster]').forEach((video) => {
            video.poster = video.dataset.poster;
            video.removeAttribute('data-poster');
          });
          target.querySelectorAll('video > img[data-src]').forEach((image) => {
            image.src = image.dataset.src;
            image.removeAttribute('data-src');
          });
          if (!this.thumbs) return;
          this.thumbs.forEach((button) => {
            if (button.dataset.mediaId === String(id)) {
              button.setAttribute('aria-current', 'true');
            } else {
              button.removeAttribute('aria-current');
            }
          });
        }

        /* A hidden media keeps playing (sound included) unless paused:
           native video, YouTube and Vimeo players, 3D model. */
        pauseMedia(item) {
          item.querySelectorAll('video').forEach((video) => video.pause());
          item.querySelectorAll('iframe').forEach((frame) => {
            const src = frame.src || '';
            if (!frame.contentWindow) return;
            if (src.includes('youtube')) {
              frame.contentWindow.postMessage('{"event":"command","func":"pauseVideo","args":""}', '*');
            } else if (src.includes('vimeo')) {
              frame.contentWindow.postMessage('{"method":"pause"}', '*');
            }
          });
          item.querySelectorAll('model-viewer').forEach((model) => {
            if (typeof model.pause === 'function') model.pause();
          });
        }

        /* --- Quantity stepper --- */
        initQuantity() {
          const input = this.querySelector('[data-qty-input]');
          if (!input) return;
          const clamp = (n) => (Number.isNaN(n) ? 1 : Math.max(1, n));
          const minus = this.querySelector('[data-qty-minus]');
          const plus = this.querySelector('[data-qty-plus]');
          if (minus) {
            minus.addEventListener('click', () => {
              input.value = clamp(parseInt(input.value, 10) - 1);
            });
          }
          if (plus) {
            plus.addEventListener('click', () => {
              input.value = clamp(parseInt(input.value, 10) + 1);
            });
          }
          input.addEventListener('change', () => {
            input.value = clamp(parseInt(input.value, 10));
          });
        }

        /* --- Variants --- */
        selectedOptions() {
          return this.fieldsets.map((fieldset) => {
            const checked = fieldset.querySelector('input:checked');
            return checked ? checked.value : null;
          });
        }

        currentVariant() {
          if (!this.variants.length) return null;
          if (!this.fieldsets.length) {
            const id = this.variantInput ? this.variantInput.value : null;
            return this.variants.find((v) => String(v.id) === String(id)) || null;
          }
          const selected = this.selectedOptions();
          return this.variants.find((v) => v.options.every((value, i) => value === selected[i])) || null;
        }

        onOptionChange() {
          const variant = this.currentVariant();
          this.refreshCombos();
          this.updatePrice(variant);
          this.updateButton(variant);
          if (!variant) return;
          if (this.variantInput) this.variantInput.value = variant.id;
          if (variant.featured_media && variant.featured_media.id) this.showMedia(variant.featured_media.id);
          this.updatePickup(variant);
          if (window.history && window.history.replaceState) {
            const url = new URL(window.location.href);
            url.searchParams.set('variant', variant.id);
            window.history.replaceState({}, '', url.toString());
          }
        }

        refreshCombos() {
          const selected = this.selectedOptions();
          this.fieldsets.forEach((fieldset, i) => {
            const checked = fieldset.querySelector('input:checked');
            const legendValue = fieldset.querySelector('[data-option-value]');
            if (legendValue && checked) legendValue.textContent = checked.value;
            fieldset.querySelectorAll('input[type="radio"]').forEach((radio) => {
              const hypothetical = selected.slice();
              hypothetical[i] = radio.value;
              const matches = this.variants.filter((v) => v.options.every((value, j) => value === hypothetical[j]));
              const label = radio.nextElementSibling;
              if (!label) return;
              const status = label.querySelector('[data-value-status]');
              label.classList.remove('is-soldout', 'is-unavailable');
              if (status) status.textContent = '';
              if (!matches.length) {
                label.classList.add('is-unavailable');
                if (status) status.textContent = ', ' + this.dataset.textUnavailable;
              } else if (!matches.some((v) => v.available)) {
                label.classList.add('is-soldout');
                if (status) status.textContent = ', ' + this.dataset.textSoldout;
              }
            });
          });
        }

        updatePrice(variant) {
          if (!this.priceTarget || !variant) return;
          const money = this.money[String(variant.id)];
          if (!money) return;
          const classes =
            'fl-price' +
            (money.compare ? ' fl-price--sale' : '') +
            (money.available === false ? ' fl-price--soldout' : '');
          let html = '<span class="' + classes + '">';
          if (money.available === false) {
            html += '<span class="visually-hidden">' + this.dataset.textSoldout + '</span>';
          }
          // Same hidden label as snippets/price.liquid, so a sale price is
          // still announced as such after a variant change.
          if (money.compare) {
            html += '<span class="visually-hidden">' + this.dataset.textSale + '</span>';
          }
          html += '<span class="fl-price__current">' + money.price + '</span>';
          if (money.compare) {
            html +=
              '<s class="fl-price__compare"><span class="visually-hidden">' +
              this.dataset.textRegular +
              '</span>' +
              money.compare +
              '</s>';
          }
          // Keep the unit price in sync; it used to be wiped on the first change.
          if (money.unit) {
            const ref = money.unitRef && money.unitRef !== 1 ? money.unitRef + ' ' : '';
            html += '<span class="fl-price__unit">' + money.unit + ' / ' + ref + money.unitUnit + '</span>';
          }
          html += '</span>';
          this.priceTarget.innerHTML = html;
        }

        /* --- In-store pickup of the selected variant --- */
        async updatePickup(variant) {
          const target = this.querySelector('[data-pickup]');
          if (!target || !this.dataset.sectionId) return;
          if (this._pickupController) this._pickupController.abort();
          this._pickupController = new AbortController();
          const url = new URL(window.location.pathname, window.location.origin);
          url.searchParams.set('variant', variant.id);
          url.searchParams.set('section_id', this.dataset.sectionId);
          try {
            const response = await fetch(url.toString(), { signal: this._pickupController.signal });
            if (!response.ok) throw new Error('HTTP ' + response.status);
            const html = new DOMParser().parseFromString(await response.text(), 'text/html');
            const fresh = html.querySelector('[data-pickup]');
            target.innerHTML = fresh ? fresh.innerHTML : '';
          } catch (error) {
            if (error && error.name === 'AbortError') return;
            // Read-only information: a stale line for another variant would
            // mislead, so it is removed rather than left in place.
            target.innerHTML = '';
          }
        }

        updateButton(variant) {
          if (!this.addButton || !this.addLabel) return;
          if (this.addStatus) this.addStatus.textContent = '';
          if (!variant) {
            if (!this.variants.length) return;
            this.addButton.setAttribute('disabled', '');
            this.addLabel.textContent = this.dataset.textUnavailable;
            return;
          }
          if (!variant.available) {
            this.addButton.setAttribute('disabled', '');
            this.addLabel.textContent = this.dataset.textSoldout;
            return;
          }
          this.addButton.removeAttribute('disabled');
          this.addLabel.textContent = this.dataset.textAdd;
        }

        /* --- Add-to-cart button states (adding / added) --- */
        initFormStates() {
          if (!this.form || !this.addButton) return;
          this._onCartChange = (event) => {
            if (!this._adding) return;
            this._adding = false;
            window.clearTimeout(this._revertTimer);
            // A refused add also re-reads the cart: the drawer shows why, so
            // the button goes back to its label instead of saying "Added".
            if (event && event.detail && event.detail.failed) {
              this.updateButton(this.currentVariant());
              return;
            }
            if (this.addLabel) this.addLabel.textContent = this.dataset.textAdded;
            if (this.addStatus) this.addStatus.textContent = this.dataset.textAdded;
            this._revertTimer = window.setTimeout(() => this.updateButton(this.currentVariant()), 2000);
          };
          document.addEventListener('fl:cart:change', this._onCartChange);
          this.form.addEventListener('submit', () => {
            this._adding = true;
            if (this.addLabel) this.addLabel.textContent = this.dataset.textAdding;
            if (this.addStatus) this.addStatus.textContent = this.dataset.textAdding;
            window.clearTimeout(this._revertTimer);
            this._revertTimer = window.setTimeout(() => {
              this._adding = false;
              this.updateButton(this.currentVariant());
            }, 8000);
          });
        }
      }
    );
  }
{% endjavascript %}

{% schema %}
{
  "name": "t:names.product",
  "settings": [
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "t:labels.top_padding",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "t:labels.bottom_padding",
      "default": 48
    }
  ],
  "blocks": [
    {
      "type": "@app"
    },
    {
      "type": "title",
      "name": "t:names.title",
      "limit": 1,
      "settings": [
        {
          "type": "checkbox",
          "id": "show_vendor",
          "label": "t:labels.show_vendor",
          "default": false
        }
      ]
    },
    {
      "type": "price",
      "name": "t:names.price",
      "limit": 1
    },
    {
      "type": "variant_picker",
      "name": "t:names.variant_picker",
      "limit": 1
    },
    {
      "type": "quantity",
      "name": "t:names.quantity_selector",
      "limit": 1
    },
    {
      "type": "buy_buttons",
      "name": "t:names.buy_buttons",
      "limit": 1,
      "settings": [
        {
          "type": "checkbox",
          "id": "show_dynamic_checkout",
          "label": "t:labels.show_dynamic_checkout_buttons",
          "default": true
        }
      ]
    },
    {
      "type": "description",
      "name": "t:names.description",
      "limit": 1
    },
    {
      "type": "collapsible_tab",
      "name": "t:names.collapsible_row",
      "limit": 4,
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "t:labels.heading",
          "info": "t:info.leave_empty_to_show_the_translated_heading"
        },
        {
          "type": "richtext",
          "id": "content",
          "label": "t:labels.content",
          "default": "<p>Share care instructions, shipping details or sizing notes.</p>"
        }
      ]
    },
    {
      "type": "text",
      "name": "t:names.text",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "t:labels.text",
          "default": "Share details about your product."
        }
      ]
    },
    {
      "type": "custom_liquid",
      "name": "t:names.custom_liquid",
      "settings": [
        {
          "type": "liquid",
          "id": "custom_liquid",
          "label": "t:labels.custom_liquid",
          "info": "t:info.add_app_snippets_or_other_liquid_code"
        }
      ]
    }
  ]
}
{% endschema %}
