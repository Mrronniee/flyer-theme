{%- liquid
  assign sort_by = collection.sort_by | default: collection.default_sort_by
  assign form_id = 'CollectionFilters-' | append: section.id

  assign active_count = 0
  for f in collection.filters
    if f.type == 'price_range'
      if f.min_value.value or f.max_value.value
        assign active_count = active_count | plus: 1
      endif
    else
      assign active_count = active_count | plus: f.active_values.size
    endif
  endfor

  # Phones: the grid sits inside the page margins, columns 12px apart
  # (critical.css), so a card is narrower than its share of the screen.
  if section.settings.cols_mobile == '1'
    assign mobile_inset = settings.min_page_margin | times: 2
    assign sizes_mobile = 'calc(100vw - ' | append: mobile_inset | append: 'px)'
  else
    assign mobile_inset = settings.min_page_margin | plus: 6
    assign sizes_mobile = 'calc(50vw - ' | append: mobile_inset | append: 'px)'
  endif
  if section.settings.cols_desktop == '3'
    assign sizes_desktop = '33vw'
    assign sizes_pct = 33
  else
    assign sizes_desktop = '25vw'
    assign sizes_pct = 25
  endif
  assign card_sizes = '(max-width: 749px) ' | append: sizes_mobile | append: ', (max-width: 989px) 33vw, ' | append: sizes_desktop
  # Wider than the page width, a contained slot stops growing: cap its size
  # so a 1440px screen does not fetch images for a 50vw it never gets.
  assign card_sizes_cap = settings.max_page_width | times: sizes_pct | divided_by: 100
  assign card_sizes = '(min-width: ' | append: settings.max_page_width | append: 'px) ' | append: card_sizes_cap | append: 'px, ' | append: card_sizes
-%}

<div
  class="fl-collection"
  style="padding-block: {{ section.settings.padding_top }}px {{ section.settings.padding_bottom }}px"
>
  <header class="fl-collection__head">
    <h1 class="fl-collection__title">{{ collection.title | escape }}</h1>
    {%- if section.settings.show_description and collection.description != blank -%}
      <div class="fl-collection__desc">{{ collection.description }}</div>
    {%- endif -%}
  </header>

  {%- liquid
    assign count_text = 'collections.general.product_count' | t: count: collection.products_count
    assign clear_url = collection.url | append: '?sort_by=' | append: sort_by
  -%}
  {% render 'facets-toolbar',
    results: collection,
    form_id: form_id,
    action: collection.url,
    count_text: count_text,
    clear_url: clear_url,
    wrapper_class: 'fl-collection__toolbar'
  %}

  {%- paginate collection.products by 24 -%}
    {%- if collection.products.size == 0 -%}
      <div class="fl-collection__empty">
        {%- if active_count > 0 -%}
          <p class="fl-collection__empty-text">{{ 'collections.filters.no_results' | t }}</p>
          <a class="fl-btn fl-btn--secondary" href="{{ collection.url }}?sort_by={{ sort_by }}">
            {{- 'collections.filters.clear_all' | t -}}
          </a>
        {%- else -%}
          <p class="fl-collection__empty-text">{{ 'collections.general.no_products' | t }}</p>
        {%- endif -%}
      </div>
    {%- else -%}
      <div
        class="fl-product-grid fl-collection__grid"
        style="--grid-cols: {{ section.settings.cols_desktop }}; --grid-cols-mobile: {{ section.settings.cols_mobile }}"
      >
        {%- comment -%}
          The first row sits above the fold and holds the LCP image, so those
          cards load eagerly; everything below stays lazy.
        {%- endcomment -%}
        {%- comment -%}
          Liquid cannot know the screen width: the first row counts the fewer
          columns of desktop and phone, so a phone (2 columns) does not fetch
          the 3rd and 4th cards eagerly, at high priority, below its first
          screen.
        {%- endcomment -%}
        {%- assign eager_count = section.settings.cols_desktop | times: 1 -%}
        {%- assign cols_mobile_count = section.settings.cols_mobile | times: 1 -%}
        {%- if cols_mobile_count < eager_count -%}
          {%- assign eager_count = cols_mobile_count -%}
        {%- endif -%}
        {%- for product in collection.products -%}
          {%- if forloop.index <= eager_count -%}
            {% render 'product-card',
              product: product,
              sizes: card_sizes,
              heading_level: 'h2',
              loading: 'eager',
              priority: true
            %}
          {%- else -%}
            {% render 'product-card', product: product, sizes: card_sizes, heading_level: 'h2' %}
          {%- endif -%}
        {%- endfor -%}
      </div>

      {%- if paginate.pages > 1 -%}
        {%- assign current_page_str = paginate.current_page | append: '' -%}
        <nav class="fl-pagination" aria-label="{{ 'general.pagination.label' | t }}">
          {%- if paginate.previous -%}
            <a class="fl-pagination__item fl-pagination__item--label" href="{{ paginate.previous.url }}">
              {{- 'general.pagination.previous' | t -}}
            </a>
          {%- endif -%}
          {%- for part in paginate.parts -%}
            {%- assign part_str = part.title | append: '' -%}
            {%- if part.is_link -%}
              <a
                class="fl-pagination__item"
                href="{{ part.url }}"
                aria-label="{{ 'general.pagination.page' | t: number: part.title }}"
              >
                {{- part.title -}}
              </a>
            {%- elsif part_str == current_page_str -%}
              <span class="fl-pagination__item fl-pagination__item--current" aria-current="page">
                <span class="visually-hidden">{{ 'general.pagination.current_page' | t: number: part.title }}</span>
                <span aria-hidden="true">{{ part.title }}</span>
              </span>
            {%- else -%}
              <span class="fl-pagination__gap" aria-hidden="true">{{ part.title }}</span>
            {%- endif -%}
          {%- endfor -%}
          {%- if paginate.next -%}
            <a class="fl-pagination__item fl-pagination__item--label" href="{{ paginate.next.url }}">
              {{- 'general.pagination.next' | t -}}
            </a>
          {%- endif -%}
        </nav>
      {%- endif -%}
    {%- endif -%}
  {%- endpaginate -%}
</div>

{% stylesheet %}
  .fl-collection__head {
    margin-block-end: 24px;
  }

  .fl-collection__desc {
    max-width: 60ch;
    margin-block-start: 12px;
    color: var(--color-muted);
  }


  fl-collection-filters {
    display: block;
  }

  .fl-toolbar {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 8px 20px;
    padding-block: 10px;
    border-block: 1px solid var(--color-line);
  }

  .fl-caret {
    flex: none;
    transition: transform 0.2s ease;
  }

  .fl-toolbar__drawer {
    min-width: 0;
  }

  .fl-toolbar__drawer-toggle {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-height: 44px;
    padding: 8px 14px;
    border: 1px solid var(--color-line);
    border-radius: var(--radius-btn);
    cursor: pointer;
    list-style: none;
    user-select: none;
  }

  .fl-toolbar__drawer-toggle::-webkit-details-marker {
    display: none;
  }

  .fl-toolbar__drawer-toggle:hover {
    border-color: var(--color-ink);
  }

  .fl-toolbar__drawer[open] > .fl-toolbar__drawer-toggle .fl-caret {
    transform: rotate(180deg);
  }

  .fl-toolbar__facets {
    position: absolute;
    top: calc(100% + 8px);
    left: 0;
    right: 0;
    z-index: 40;
    max-height: 70vh;
    max-height: 70dvh;
    overflow-y: auto;
    padding: 4px 16px 16px;
    background: var(--color-bg);
    border: 1px solid var(--color-line);
    border-radius: var(--radius-card);
    box-shadow: 0 8px 40px rgb(0 0 0 / 12%);
  }

  .fl-facet {
    border-block-end: 1px solid var(--color-line);
  }

  .fl-facet:last-of-type {
    border-block-end: 0;
  }

  .fl-facet__toggle {
    display: flex;
    align-items: center;
    gap: 8px;
    min-height: 44px;
    padding-block: 10px;
    cursor: pointer;
    list-style: none;
    user-select: none;
  }

  .fl-facet__toggle::-webkit-details-marker {
    display: none;
  }

  .fl-facet__name {
    flex: 1 1 auto;
    min-width: 0;
  }

  .fl-facet[open] > .fl-facet__toggle .fl-caret {
    transform: rotate(180deg);
  }

  .fl-facet__badge {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 18px;
    height: 18px;
    padding-inline: 5px;
    border-radius: 999px;
    background: var(--color-ink);
    color: var(--color-bg);
    font-size: 0.6875em;
    font-weight: 500;
  }

  .fl-facet__panel {
    padding-block-end: 14px;
  }

  .fl-facet__list {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .fl-facet__option {
    display: flex;
    align-items: center;
    gap: 10px;
    min-height: 44px;
    cursor: pointer;
  }

  .fl-facet__option--empty {
    color: var(--color-muted);
    cursor: default;
  }

  .fl-facet__checkbox {
    flex: none;
    width: 16px;
    height: 16px;
    margin: 0;
    accent-color: var(--color-ink);
  }

  .fl-facet__option-count {
    margin-inline-start: auto;
    font-size: 0.8125em;
    color: var(--color-muted);
  }

  .fl-facet__note {
    margin-block-end: 12px;
    font-size: 0.8125em;
    color: var(--color-muted);
  }

  .fl-facet__price-row {
    display: flex;
    gap: 12px;
  }

  .fl-facet__price-field {
    flex: 1 1 0;
    min-width: 0;
  }

  .fl-facet__price-apply {
    margin-block-start: 12px;
  }

  .fl-toolbar__apply {
    width: 100%;
    margin-block-start: 14px;
  }

  .fl-toolbar__end {
    display: flex;
    align-items: center;
    gap: 16px;
    margin-inline-start: auto;
    /* Must stay shrinkable: flex:none plus an unbounded <select> of long sort
       labels pushed the page 108px wider than the viewport. */
    flex: 0 1 auto;
    min-width: 0;
  }

  .fl-toolbar__count {
    font-size: 0.875em;
    color: var(--color-muted);
    white-space: nowrap;
  }

  .fl-toolbar__sort {
    display: flex;
    align-items: center;
    gap: 8px;
    min-width: 0;
  }

  .fl-toolbar__sort-label {
    font-size: 0.875em;
    color: var(--color-muted);
    white-space: nowrap;
  }

  /* A boxed <select> sized by its longest option ("Date, from oldest to
     newest") took 387px of the toolbar. Ruled control, capped width. */
  .fl-toolbar__sort .fl-select {
    width: auto;
    max-width: min(22ch, 100%);
    min-width: 0;
    padding: 8px 4px;
    background: transparent;
    border: 0;
    border-bottom: 1px solid var(--color-control-border);
    border-radius: 0;
    box-shadow: none;
    text-overflow: ellipsis;
  }

  .fl-toolbar__sort .fl-select:hover {
    border-bottom-color: var(--color-ink);
  }

  .fl-toolbar__sort .fl-select:focus-visible {
    border-bottom-color: var(--color-ink);
  }

  /* Desktop with JS: drawer forced open, facets as a horizontal row of dropdowns */
  .fl-toolbar__drawer--inline > .fl-toolbar__drawer-toggle {
    display: none;
  }

  /* Positioning context for the facet dropdowns: the row always starts at the
     page content edge, so a panel anchored to it can never spill out of the
     viewport, unlike one anchored to a pill sitting near the right edge. */
  .fl-toolbar__drawer--inline .fl-toolbar__facets {
    position: relative;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px;
    max-height: none;
    overflow: visible;
    padding: 0;
    background: none;
    border: 0;
    border-radius: 0;
    box-shadow: none;
  }

  .fl-toolbar__drawer--inline .fl-facet {
    border-block-end: 0;
  }

  .fl-toolbar__drawer--inline .fl-facet__toggle {
    padding: 8px 14px;
    border: 1px solid var(--color-line);
    border-radius: var(--radius-btn);
  }

  .fl-toolbar__drawer--inline .fl-facet__toggle:hover {
    border-color: var(--color-ink);
  }

  .fl-toolbar__drawer--inline .fl-facet__name {
    flex: none;
  }

  .fl-toolbar__drawer--inline .fl-facet__panel {
    position: absolute;
    top: calc(100% + 8px);
    inset-inline-start: 0;
    z-index: 30;
    width: max-content;
    min-width: 260px;
    /* Never wider than the page content box. */
    max-width: min(340px, var(--content-width, 100%));
    max-height: 340px;
    overflow-y: auto;
    padding: 6px 16px 16px;
    background: var(--color-bg);
    border: 1px solid var(--color-line);
    border-radius: var(--radius-card);
    box-shadow: 0 8px 40px rgb(0 0 0 / 12%);
  }

  .fl-active-filters {
    padding-block: 14px 0;
  }

  .fl-active-filters__list {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .fl-active-filters__pill {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-height: 44px;
    padding: 6px 16px;
    background: var(--color-surface);
    border-radius: 999px;
    font-size: 0.875em;
    text-decoration: none;
    transition: background 0.15s ease;
  }

  .fl-active-filters__pill:hover {
    background: var(--color-line);
  }

  .fl-active-filters__clear {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    margin-inline-start: 4px;
    font-size: 0.875em;
    color: var(--color-muted);
  }

  .fl-collection__grid {
    margin-block-start: 28px;
  }

  .fl-collection__empty {
    padding-block: 72px;
    text-align: center;
  }

  .fl-collection__empty-text {
    margin-block-end: 20px;
    color: var(--color-muted);
  }

  /* Phones: the product count drops under the sort list instead of being
     hidden — it exists nowhere else on the page. */
  @media (max-width: 749px) {
    .fl-toolbar__end {
      flex-wrap: wrap;
    }

    .fl-toolbar__count {
      flex-basis: 100%;
      order: 1;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:names.collection",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_description",
      "label": "t:labels.show_collection_description",
      "default": true
    },
    {
      "type": "header",
      "content": "t:content.product_grid"
    },
    {
      "type": "select",
      "id": "cols_desktop",
      "label": "t:labels.columns_on_desktop",
      "options": [
        {
          "value": "3",
          "label": "t:labels.3_columns"
        },
        {
          "value": "4",
          "label": "t:labels.4_columns"
        }
      ],
      "default": "4"
    },
    {
      "type": "select",
      "id": "cols_mobile",
      "label": "t:labels.columns_on_mobile",
      "options": [
        {
          "value": "1",
          "label": "t:labels.1_column"
        },
        {
          "value": "2",
          "label": "t:labels.2_columns"
        }
      ],
      "default": "2"
    },
    {
      "type": "header",
      "content": "t:content.spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "t:labels.top_padding",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "t:labels.bottom_padding",
      "default": 48
    }
  ]
}
{% endschema %}
