{% comment %}
  FLYER — Create account (templates/customers/register.json).
{% endcomment %}

{% render 'customer-styles' %}

<div class="fl-account">
  <div class="fl-account__inner">
    <div class="fl-account__head">
      <h1 class="fl-account__title">{{ 'customer.register.title' | t }}</h1>
    </div>

    {%- form 'create_customer', class: 'fl-account__form' -%}
      {%- comment -%}
        Errors: the summary takes focus on load and links to each field; each
        invalid field carries aria-invalid and points to its own message.
        The section is only the main section of customers/register (no
        preset), so its ids stay fixed.
      {%- endcomment -%}
      {%- if form.errors -%}
        <div id="FlRegisterErrors" class="fl-form-status fl-form-status--error" role="alert" tabindex="-1" autofocus>
          <ul class="fl-form-status__list">
            {%- for field in form.errors -%}
              {%- liquid
                case field
                  when 'first_name'
                    assign field_target = 'FlRegisterFirst'
                  when 'last_name'
                    assign field_target = 'FlRegisterLast'
                  when 'email'
                    assign field_target = 'FlRegisterEmail'
                  when 'password'
                    assign field_target = 'FlRegisterPassword'
                  else
                    assign field_target = blank
                endcase
              -%}
              <li>
                {%- if field_target != blank -%}
                  <a href="#{{ field_target }}">
                    {{- form.errors.translated_fields[field] | capitalize }} {{ form.errors.messages[field] -}}
                  </a>
                {%- else -%}
                  {{ form.errors.messages[field] }}
                {%- endif -%}
              </li>
            {%- endfor -%}
          </ul>
        </div>
      {%- endif -%}

      <p class="fl-form-note">{{ 'general.forms.required_note' | t }}</p>

      <div class="fl-field">
        <label class="fl-label" for="FlRegisterFirst">{{ 'customer.register.first_name' | t }}</label>
        <input
          class="fl-input"
          type="text"
          name="customer[first_name]"
          id="FlRegisterFirst"
          value="{{ form.first_name }}"
          data-form-echo
          autocomplete="given-name"
          {% if form.errors contains 'first_name' %}
            aria-invalid="true"
            aria-describedby="FlRegisterFirst-error"
          {% endif %}
        >
        {%- if form.errors contains 'first_name' -%}
          <p class="fl-field__error" id="FlRegisterFirst-error">
            {{- form.errors.translated_fields.first_name | capitalize }} {{ form.errors.messages.first_name -}}
          </p>
        {%- endif -%}
      </div>

      <div class="fl-field">
        <label class="fl-label" for="FlRegisterLast">{{ 'customer.register.last_name' | t }}</label>
        <input
          class="fl-input"
          type="text"
          name="customer[last_name]"
          id="FlRegisterLast"
          value="{{ form.last_name }}"
          data-form-echo
          autocomplete="family-name"
          {% if form.errors contains 'last_name' %}
            aria-invalid="true"
            aria-describedby="FlRegisterLast-error"
          {% endif %}
        >
        {%- if form.errors contains 'last_name' -%}
          <p class="fl-field__error" id="FlRegisterLast-error">
            {{- form.errors.translated_fields.last_name | capitalize }} {{ form.errors.messages.last_name -}}
          </p>
        {%- endif -%}
      </div>

      <div class="fl-field">
        <label class="fl-label" for="FlRegisterEmail">
          {{- 'customer.register.email' | t -}}
          <span class="fl-label__req" aria-hidden="true">*</span>
        </label>
        <input
          class="fl-input"
          type="email"
          name="customer[email]"
          id="FlRegisterEmail"
          value="{{ form.email }}"
          data-form-echo
          autocomplete="email"
          autocapitalize="off"
          required
          {% if form.errors contains 'email' %}
            aria-invalid="true"
            aria-describedby="FlRegisterEmail-error"
          {% endif %}
        >
        {%- if form.errors contains 'email' -%}
          <p class="fl-field__error" id="FlRegisterEmail-error">
            {{- form.errors.translated_fields.email | capitalize }} {{ form.errors.messages.email -}}
          </p>
        {%- endif -%}
      </div>

      <div class="fl-field">
        <label class="fl-label" for="FlRegisterPassword">
          {{- 'customer.register.password' | t -}}
          <span class="fl-label__req" aria-hidden="true">*</span>
        </label>
        <input
          class="fl-input"
          type="password"
          name="customer[password]"
          id="FlRegisterPassword"
          autocomplete="new-password"
          required
          {% if form.errors contains 'password' %}
            aria-invalid="true"
            aria-describedby="FlRegisterPassword-error"
          {% endif %}
        >
        {%- if form.errors contains 'password' -%}
          <p class="fl-field__error" id="FlRegisterPassword-error">
            {{- form.errors.translated_fields.password | capitalize }} {{ form.errors.messages.password -}}
          </p>
        {%- endif -%}
      </div>

      <div class="fl-account__actions">
        <button type="submit" class="fl-btn">{{ 'customer.register.submit' | t }}</button>
      </div>
    {%- endform -%}

    <p class="fl-account__aside">
      {{ 'customer.register.already_have_account' | t }}
      <a href="{{ routes.account_login_url }}">{{ 'customer.register.log_in' | t }}</a>
    </p>
  </div>
</div>

{% schema %}
{
  "name": "t:names.register",
  "tag": "section",
  "settings": []
}
{% endschema %}
