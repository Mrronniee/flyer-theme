{% comment %}
  Featured collection.
  Row header (heading + optional "View all" link) above a product grid built
  with the shared product-card snippet. Falls back to four placeholder cards
  when no collection is selected so the section previews in the editor.
{% endcomment %}

{%- liquid
  assign col = section.settings.collection
  assign limit = section.settings.products_to_show
  assign cols = section.settings.cols_desktop

  assign heading = section.settings.heading
  if heading == blank
    assign heading = col.title
  endif

  assign show_link = false
  if section.settings.show_view_all and col != blank
    assign show_link = true
  endif

  if cols == '3'
    assign cols_count = 3
  else
    assign cols_count = 4
  endif
  # Phones: two columns inside the page margins, 12px apart (critical.css).
  assign mobile_inset = settings.min_page_margin | plus: 6
  assign card_sizes_mobile = 'calc(50vw - ' | append: mobile_inset | append: 'px)'
  # Wider than the page width, a contained slot stops growing: cap its size
  # so a 1440px screen does not fetch images for a 50vw it never gets.
  # The page content stops at the page width minus its two margins
  # (critical.css, --content-width) and a card is that less the grid gaps,
  # divided by the column count: the cap follows that, not a fraction of the
  # raw page width, or a wide screen fetches what it never shows.
  assign page_margins = settings.min_page_margin | times: 2
  assign content_px = settings.max_page_width | minus: page_margins
  assign desktop_gaps = cols_count | minus: 1 | times: settings.spacing_grid_horizontal
  assign tablet_gaps = settings.spacing_grid_horizontal | times: 2
  assign card_sizes_cap = content_px | minus: desktop_gaps | divided_by: cols_count
  assign card_inset = desktop_gaps | plus: page_margins
  assign card_inset_tablet = tablet_gaps | plus: page_margins
  assign card_sizes = '(min-width: ' | append: settings.max_page_width | append: 'px) ' | append: card_sizes_cap | append: 'px, (max-width: 749px) ' | append: card_sizes_mobile | append: ', (max-width: 989px) calc((100vw - ' | append: card_inset_tablet | append: 'px) / 3), calc((100vw - ' | append: card_inset | append: 'px) / ' | append: cols_count | append: ')'
  # The editorial layout gives its first card two columns and the gap between
  # them (CSS below, .fl-product-grid--editorial): two card widths plus one
  # gap, not a bare half of the page.
  assign editorial_cap = card_sizes_cap | times: 2 | plus: settings.spacing_grid_horizontal
  assign editorial_sizes = '(min-width: ' | append: settings.max_page_width | append: 'px) ' | append: editorial_cap | append: 'px, (max-width: 749px) calc(100vw - ' | append: page_margins | append: 'px), (max-width: 989px) calc((100vw - ' | append: card_inset_tablet | append: 'px) / 3 * 2 + ' | append: settings.spacing_grid_horizontal | append: 'px), calc((100vw - ' | append: card_inset | append: 'px) / ' | append: cols_count | append: ' * 2 + ' | append: settings.spacing_grid_horizontal | append: 'px)'
-%}

{%- comment -%}
  full-width + an inner constrained to the page width, like rich-text /
  image-with-text / multicolumn: the colour scheme paints a band across the
  whole screen instead of stopping at the content column.
{%- endcomment -%}
{%- comment -%}
  Without products the section is an editor preview only (placeholder cards):
  shoppers get nothing rather than "Example product" cards.
{%- endcomment -%}
{%- if col.products.size > 0 or request.design_mode -%}
<section
  class="fl-featured full-width color-{{ section.settings.color_scheme }}"
  {% render 'reveal' %}
  style="padding-block: {{ section.settings.padding_top }}px {{ section.settings.padding_bottom }}px"
>
  <div class="fl-featured__inner">
    {%- if heading != blank or show_link -%}
      <div class="fl-featured__head">
        {%- if heading != blank -%}
          <h2 class="fl-featured__heading">{{ heading | escape }}</h2>
        {%- endif -%}
        {%- if show_link -%}
          <a class="fl-featured__viewall" href="{{ col.url }}">
            {{- 'collections.general.view_all' | t -}}
            <span class="visually-hidden"> {{ col.title | escape }}</span>
          </a>
        {%- endif -%}
      </div>
    {%- endif -%}

    {%- if col.products.size > 0 -%}
      <div
        class="fl-product-grid{% if section.settings.layout == 'editorial' %} fl-product-grid--editorial{% endif %}"
        style="--grid-cols: {{ cols }}; --grid-cols-tablet: 3; --grid-cols-mobile: 2"
      >
        {%- for product in col.products limit: limit -%}
          {%- comment -%}
            The editorial layout gives the first card two columns and two rows,
            so the uniform `sizes` made the browser pick a 540px file for a
            606px slot.
          {%- endcomment -%}
          {%- assign this_sizes = card_sizes -%}
          {%- if section.settings.layout == 'editorial' and forloop.first -%}
            {%- assign this_sizes = editorial_sizes -%}
          {%- endif -%}
          {%- comment -%}
            Only when this section OPENS the page do its first four cards hold
            the page's largest image: then they load eagerly, at high priority.
            `section.index <= 3` was too loose — behind a full-height hero, four
            cards were measured stealing about 560ms from the hero's own LCP
            (1.8.17). Anywhere else the whole grid stays lazy, as does
            everything after the first row.
          {%- endcomment -%}
          {%- comment -%}
            A phone shows two cards per row: only those two are fetched at
            high priority; the 3rd and 4th (first row on desktop, below the
            first screen on a phone) stay eager without stealing priority.
          {%- endcomment -%}
          {%- if section.index == 1 and forloop.index <= 2 -%}
            {% render 'product-card', product: product, sizes: this_sizes, loading: 'eager', priority: true %}
          {%- elsif section.index == 1 and forloop.index <= 4 -%}
            {% render 'product-card', product: product, sizes: this_sizes, loading: 'eager' %}
          {%- else -%}
            {% render 'product-card', product: product, sizes: this_sizes %}
          {%- endif -%}
        {%- endfor -%}
      </div>
    {%- else -%}
      {%- comment -%}
        Also covers a chosen but empty collection, which used to render a heading
        with nothing under it.
      {%- endcomment -%}
      <div
        class="fl-product-grid"
        style="--grid-cols: {{ cols }}; --grid-cols-tablet: 3; --grid-cols-mobile: 2"
      >
        {%- for i in (1..4) -%}
          {%- assign placeholder_name = 'product-' | append: i -%}
          <article class="fl-card">
            <div class="fl-card__media">
              {{ placeholder_name | placeholder_svg_tag: 'fl-featured__ph' | replace: '<svg ', '<svg aria-hidden="true" focusable="false" ' }}
            </div>
            <div class="fl-card__info">
              <h3 class="fl-card__title">{{ 'products.card.placeholder_title' | t }}</h3>
            </div>
          </article>
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</section>
{%- endif -%}

{% stylesheet %}
  /* Same constrained inner as the other content sections; --content-width is
     declared on .shopify-section in critical.css. */
  .fl-featured__inner {
    width: var(--content-width);
    margin-inline: auto;
  }

  .fl-featured__head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 4px 24px;
    margin-block-end: 28px;
  }

  .fl-featured__heading {
    min-width: 0;
  }

  .fl-featured__viewall {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    font-size: 0.875em;
    white-space: nowrap;
    color: var(--color-muted);
    transition: color 0.15s ease;
  }

  .fl-featured__viewall:hover {
    color: var(--color-ink);
  }

  .fl-featured__ph {
    width: 100%;
    aspect-ratio: var(--card-ratio);
    object-fit: cover;
    fill: var(--color-muted);
    opacity: 0.4;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:names.featured_collection",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:labels.color_scheme",
      "default": "scheme-1"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:labels.heading",
      "info": "t:info.leave_blank_to_use_the_collection_name"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "t:labels.collection"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "min": 2,
      "max": 12,
      "step": 1,
      "label": "t:labels.products_to_show",
      "default": 8
    },
    {
      "type": "select",
      "id": "layout",
      "label": "t:labels.layout",
      "options": [
        {
          "value": "grid",
          "label": "t:labels.uniform_grid"
        },
        {
          "value": "editorial",
          "label": "t:labels.editorial_first_product_large"
        }
      ],
      "default": "grid"
    },
    {
      "type": "select",
      "id": "cols_desktop",
      "label": "t:labels.columns_on_desktop",
      "options": [
        {
          "value": "3",
          "label": "t:labels.3_columns"
        },
        {
          "value": "4",
          "label": "t:labels.4_columns"
        }
      ],
      "default": "4"
    },
    {
      "type": "checkbox",
      "id": "show_view_all",
      "label": "t:labels.show_view_all_link",
      "default": true
    },
    {
      "type": "header",
      "content": "t:content.spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "t:labels.top_padding",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "t:labels.bottom_padding",
      "default": 48
    }
  ],
  "presets": [
    {
      "name": "t:names.featured_collection"
    }
  ]
}
{% endschema %}
