{%- comment -%}
  full-width + an inner constrained to the page width, like rich-text /
  image-with-text / multicolumn: the colour scheme paints a band across the
  whole screen instead of stopping at the content column.
{%- endcomment -%}
<div
  class="fl-custom-liquid full-width color-{{ section.settings.color_scheme }}"
  {% render 'reveal' %}
  style="padding-block: {{ section.settings.padding_top }}px {{ section.settings.padding_bottom }}px;"
>
  <div class="fl-custom-liquid__inner">
    {{ section.settings.custom_liquid }}
  </div>
</div>

{% stylesheet %}
  .fl-custom-liquid {
    min-width: 0;
  }

  /* --content-width is declared on .shopify-section in critical.css. */
  .fl-custom-liquid__inner {
    width: var(--content-width);
    min-width: 0;
    margin-inline: auto;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:names.custom_liquid",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:labels.color_scheme",
      "default": "scheme-1"
    },
    {
      "type": "liquid",
      "id": "custom_liquid",
      "label": "t:labels.custom_liquid",
      "info": "t:info.add_app_snippets_or_other_liquid_code"
    },
    {
      "type": "header",
      "content": "t:content.spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "t:labels.top_padding",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "t:labels.bottom_padding",
      "default": 48
    }
  ],
  "presets": [
    {
      "name": "t:names.custom_liquid"
    }
  ]
}
{% endschema %}
