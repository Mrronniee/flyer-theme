{% comment %}
  FLYER — Password page (templates/password.json, rendered in layout/password.liquid).
{% endcomment %}

<div class="fl-password">
  <div class="fl-password__inner">
    {%- if settings.logo -%}
      {%- assign logo_alt = shop.name | escape -%}
      {{
        settings.logo
        | image_url: width: 600
        | image_tag: widths: '150, 300, 600', sizes: '200px', alt: logo_alt, class: 'fl-password__logo'
      }}
    {%- else -%}
      <p class="fl-password__wordmark">{{ shop.name }}</p>
    {%- endif -%}

    <h1 class="fl-password__title">{{ 'password.title' | t }}</h1>

    <div class="fl-password__message fl-rte">
      {%- if shop.password_message != blank -%}
        {{ shop.password_message }}
      {%- else -%}
        <p>{{ 'password.message' | t }}</p>
      {%- endif -%}
    </div>

    {%- form 'storefront_password', class: 'fl-password__form' -%}
      {%- comment -%}
        Errors: the summary takes focus on load and links to the field; the
        invalid field carries aria-invalid and points to its own message.
        The form has a single field, so an error filed under 'form' (where
        Shopify may put a wrong password) belongs to it as much as one filed
        under 'password'.
        The section has no preset and is only the main section of
        templates/password.json, so its ids stay fixed.
      {%- endcomment -%}
      {%- liquid
        assign password_invalid = false
        if form.errors contains 'password' or form.errors contains 'form'
          assign password_invalid = true
        endif
      -%}
      {%- if form.errors -%}
        <div id="FlPasswordErrors" class="fl-form-status fl-form-status--error" role="alert" tabindex="-1" autofocus>
          <ul class="fl-form-status__list">
            {%- for field in form.errors -%}
              <li>
                {%- case field -%}
                  {%- when 'password' -%}
                    <a href="#FlStorefrontPassword">
                      {{- form.errors.translated_fields[field] | capitalize }} {{ form.errors.messages[field] -}}
                    </a>
                  {%- when 'form' -%}
                    <a href="#FlStorefrontPassword">{{ form.errors.messages[field] }}</a>
                  {%- else -%}
                    {{ form.errors.messages[field] }}
                {%- endcase -%}
              </li>
            {%- endfor -%}
          </ul>
        </div>
      {%- endif -%}

      <label class="visually-hidden" for="FlStorefrontPassword">{{ 'password.password' | t }}</label>
      <div class="fl-password__row">
        <input
          class="fl-input"
          type="password"
          id="FlStorefrontPassword"
          name="password"
          autocomplete="current-password"
          placeholder="{{ 'password.password' | t }}"
          required
          {% if password_invalid %}
            aria-invalid="true"
            aria-describedby="FlStorefrontPassword-error"
          {% endif %}
        >
        <button type="submit" class="fl-btn">{{ 'password.enter' | t }}</button>
      </div>
      {%- if password_invalid -%}
        <p class="fl-field__error" id="FlStorefrontPassword-error">
          {%- if form.errors contains 'password' -%}
            {{- form.errors.translated_fields.password | capitalize }} {{ form.errors.messages.password -}}
          {%- else -%}
            {{- form.errors.messages.form -}}
          {%- endif -%}
        </p>
      {%- endif -%}
    {%- endform -%}

    <p class="fl-password__admin">{{ 'password.admin_html' | t }}</p>
  </div>
</div>

{% stylesheet %}
  .fl-password {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 100svh;
    padding: var(--page-margin);
  }

  .fl-password__inner {
    width: min(420px, 100%);
    text-align: center;
  }

  .fl-password__logo {
    width: 200px;
    margin: 0 auto 32px;
  }

  .fl-password__wordmark {
    margin-bottom: 32px;
    font-family: var(--font-heading-family);
    font-size: 1.25em;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .fl-password__title {
    margin-bottom: 12px;
  }

  .fl-password__message {
    margin-bottom: 28px;
    color: var(--color-muted);
  }

  /* The page is centred; the error summary is a bulleted list, which reads
     wrongly centred (bullet at the left edge, text in the middle). */
  .fl-password__form .fl-form-status {
    text-align: start;
  }

  .fl-password__row {
    display: flex;
    gap: 8px;
  }

  .fl-password__row .fl-input {
    flex: 1 1 auto;
    min-width: 0;
  }

  .fl-password__admin {
    margin-top: 32px;
    font-size: 0.875em;
    color: var(--color-muted);
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:names.password",
  "tag": "section",
  "settings": []
}
{% endschema %}
