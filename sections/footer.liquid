<footer
  class="fl-footer full-width"
  style="padding-block: {{ section.settings.padding_top }}px {{ section.settings.padding_bottom }}px;{% if section.settings.background == 'surface' %} background-color: var(--color-surface);{% endif %}"
>
  <div class="fl-footer__inner">
    {%- if section.blocks.size > 0 -%}
      <div class="fl-footer__grid">
        {%- for block in section.blocks -%}
          {%- case block.type -%}
            {%- when 'menu' -%}
              <div class="fl-footer__col" {{ block.shopify_attributes }}>
                {%- if block.settings.heading != blank -%}
                  <h2 class="fl-footer__heading" id="Footer-heading-{{ block.id }}">{{ block.settings.heading | escape }}</h2>
                {%- endif -%}
                {%- if block.settings.menu != blank -%}
                  <nav
                    class="fl-footer__nav"
                    {% if block.settings.heading != blank %}
                      aria-labelledby="Footer-heading-{{ block.id }}"
                    {% else %}
                      aria-label="{{ 'general.footer.navigation' | t }}"
                    {% endif %}
                  >
                    <ul class="fl-footer__menu" role="list">
                      {%- for link in block.settings.menu.links -%}
                        <li>
                          <a class="fl-footer__link" href="{{ link.url }}">{{ link.title | escape }}</a>
                        </li>
                      {%- endfor -%}
                    </ul>
                  </nav>
                {%- endif -%}
              </div>

            {%- when 'text' -%}
              <div class="fl-footer__col" {{ block.shopify_attributes }}>
                {%- if block.settings.heading != blank -%}
                  <h2 class="fl-footer__heading">{{ block.settings.heading | escape }}</h2>
                {%- endif -%}
                {%- if block.settings.text != blank -%}
                  <div class="fl-footer__text">{{ block.settings.text }}</div>
                {%- endif -%}
              </div>

            {%- comment -%}
              Renders the theme-level "Brand information" settings, which had
              no consumer anywhere in the theme.
            {%- endcomment -%}
            {%- when 'brand' -%}
              <div class="fl-footer__col fl-footer__col--brand" {{ block.shopify_attributes }}>
                {%- if settings.brand_image -%}
                  {%- assign brand_alt = shop.name | escape -%}
                  {{
                    settings.brand_image
                    | image_url: width: 1100
                    | image_tag:
                      widths: '150, 300, 550, 1100',
                      sizes: '(max-width: 749px) 60vw, 300px',
                      alt: brand_alt,
                      class: 'fl-footer__brand-img',
                      loading: 'lazy'
                  }}
                {%- endif -%}
                {%- if settings.brand_headline != blank -%}
                  <p class="fl-footer__brand-headline">{{ settings.brand_headline }}</p>
                {%- endif -%}
                {%- if settings.brand_description != blank -%}
                  <div class="fl-footer__text">{{ settings.brand_description }}</div>
                {%- endif -%}
              </div>

            {%- when 'newsletter' -%}
              <div class="fl-footer__col fl-footer__col--news" {{ block.shopify_attributes }}>
                {%- if block.settings.heading != blank -%}
                  <h2 class="fl-footer__heading">{{ block.settings.heading | escape }}</h2>
                {%- endif -%}
                {%- if block.settings.text != blank -%}
                  <div class="fl-footer__text">{{ block.settings.text }}</div>
                {%- endif -%}
                {%- assign news_id = 'Footer-news-' | append: block.id -%}
                {%- form 'customer', id: news_id, class: 'fl-footer__news' -%}
                  <input type="hidden" name="contact[tags]" value="newsletter">
                  {%- if form.posted_successfully? -%}
                    <p
                      class="fl-form-status fl-footer__news-status"
                      aria-live="polite"
                      tabindex="-1"
                      autofocus
                    >
                      {{ 'general.newsletter.success' | t }}
                    </p>
                  {%- else -%}
                    {%- if form.errors -%}
                      <p
                        class="fl-form-status fl-form-status--error fl-footer__news-status"
                        id="{{ news_id }}-error"
                        aria-live="polite"
                      >
                        {{ 'general.newsletter.error' | t }}
                      </p>
                    {%- endif -%}
                    <div class="fl-footer__news-row">
                      <label class="visually-hidden" for="{{ news_id }}-email">{{ 'general.newsletter.label' | t }}</label>
                      <input
                        id="{{ news_id }}-email"
                        class="fl-input"
                        type="email"
                        name="contact[email]"
                        value="{{ form.email }}"
                        placeholder="{{ 'general.newsletter.placeholder' | t }}"
                        required
                        autocomplete="email"
                        autocapitalize="off"
                        autocorrect="off"
                        {% if form.errors %}
                          autofocus
                          aria-invalid="true"
                          aria-describedby="{{ news_id }}-error"
                        {% endif %}
                      >
                      <button type="submit" class="fl-btn">{{ 'general.newsletter.submit' | t }}</button>
                    </div>
                  {%- endif -%}
                {%- endform -%}
              </div>
          {%- endcase -%}
        {%- endfor -%}
      </div>
    {%- endif -%}

    <div class="fl-footer__bottom{% if section.blocks.size > 0 %} fl-footer__bottom--ruled{% endif %}">
      {%- liquid
        assign show_country = false
        if section.settings.show_country_selector and localization.available_countries.size > 1
          assign show_country = true
        endif
        assign show_language = false
        if section.settings.show_language_selector and localization.available_languages.size > 1
          assign show_language = true
        endif
        capture social_html
          render 'social-icons', class: 'fl-footer__social'
        endcapture
        assign social_html = social_html | strip
      -%}

      {%- if social_html != blank or show_country or show_language -%}
        <div class="fl-footer__utility">
          {{ social_html }}

          {%- if show_country or show_language -%}
            <div class="fl-footer__localization">
              {%- if show_country -%}
                {% render 'localization-form', kind: 'country', id_prefix: 'Footer', class_prefix: 'fl-footer__loc' %}
              {%- endif -%}

              {%- if show_language -%}
                {% render 'localization-form', kind: 'language', id_prefix: 'Footer', class_prefix: 'fl-footer__loc' %}
              {%- endif -%}
            </div>
          {%- endif -%}
        </div>
      {%- endif -%}

      <div class="fl-footer__meta">
        <div class="fl-footer__copyright">
          <span>&copy; {{ 'now' | date: '%Y' }}, {{ shop.name }}</span>
          {%- if section.settings.show_kiosk_credit -%}
            <a class="fl-footer__credit" href="https://kioskthemes.com/?utm_source=flyer&utm_medium=theme-credit" rel="noopener">{{ 'general.footer.theme_credit' | t }}</a>
          {%- endif -%}
          {%- if section.settings.legal_menu != blank -%}
            <ul class="fl-footer__legal-menu" role="list">
              {%- for link in section.settings.legal_menu.links -%}
                <li>
                  <a class="fl-footer__link fl-footer__link--legal" href="{{ link.url }}">{{ link.title | escape }}</a>
                </li>
              {%- endfor -%}
            </ul>
          {%- endif -%}
        </div>

        {%- if section.settings.show_payment_icons and shop.enabled_payment_types.size > 0 -%}
          <ul class="fl-footer__payment" role="list" aria-label="{{ 'general.payment.methods' | t }}">
            {%- for type in shop.enabled_payment_types -%}
              <li>{{ type | payment_type_svg_tag: class: 'fl-footer__payment-icon' }}</li>
            {%- endfor -%}
          </ul>
        {%- endif -%}
      </div>
    </div>
  </div>
</footer>

{% stylesheet %}
  .fl-footer {
    background-color: var(--color-bg);
    border-top: 1px solid var(--color-line);
  }

  .fl-footer__inner {
    width: min(calc(var(--page-width) - var(--page-margin) * 2), calc(100% - var(--page-margin) * 2));
    margin-inline: auto;
  }

  /* --- Blocks grid --- */
  .fl-footer__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 40px 32px;
    padding-bottom: 48px;
  }

  .fl-footer__col {
    min-width: 0;
  }

  .fl-footer__heading {
    margin-bottom: 14px;
    font-size: 1em;
    font-weight: 500;
  }

  .fl-footer__menu {
    display: flex;
    flex-direction: column;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .fl-footer__link {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    color: var(--color-muted);
    text-decoration: none;
    transition: color 0.15s ease;
  }

  .fl-footer__link:hover {
    color: var(--color-ink);
    text-decoration: underline;
  }

  .fl-footer__text {
    color: var(--color-muted);
  }

  /* --- Brand information (theme settings) --- */
  .fl-footer__brand-img {
    width: var(--brand-image-width, 100px);
    max-width: 100%;
    height: auto;
    margin-bottom: 12px;
  }

  .fl-footer__brand-headline {
    margin-bottom: 8px;
    font-weight: 500;
  }

  /* --- Newsletter --- */
  .fl-footer__news {
    margin-top: 16px;
  }

  .fl-footer__news-row {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .fl-footer__news-row .fl-input {
    flex: 1 1 180px;
    min-width: 0;
  }

  .fl-footer__news-status {
    margin-bottom: 12px;
  }

  /* --- Bottom bar --- */
  .fl-footer__bottom {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .fl-footer__bottom--ruled {
    padding-top: 24px;
    border-top: 1px solid var(--color-line);
  }

  .fl-footer__utility {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 12px 24px;
  }

  .fl-footer__localization {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px;
  }

  .fl-footer__loc-form {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .fl-footer__loc-select {
    width: auto;
    max-width: 100%;
  }

  .fl-footer__meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 8px 24px;
  }

  .fl-footer__credit {
    color: var(--color-muted);
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 4px;
  }

  .fl-footer__credit:hover {
    color: var(--color-ink);
  }

  .fl-footer__copyright {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0 20px;
    font-size: 0.8125em;
    color: var(--color-muted);
  }

  .fl-footer__legal-menu {
    display: flex;
    flex-wrap: wrap;
    gap: 0 20px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .fl-footer__link--legal {
    font-size: 1em;
  }

  .fl-footer__payment {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 6px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .fl-footer__payment-icon {
    display: block;
    width: 38px;
    height: auto;
  }

  @media (max-width: 749px) {
    .fl-footer__grid {
      gap: 32px 24px;
      padding-bottom: 40px;
    }
  }
{% endstylesheet %}

{% javascript %}
  if (!customElements.get('fl-localization')) {
    customElements.define(
      'fl-localization',
      class extends HTMLElement {
        connectedCallback() {
          const select = this.querySelector('select');
          const button = this.querySelector('[data-loc-submit]');
          if (!select) return;
          if (button) button.hidden = true;
          select.addEventListener('change', () => {
            const form = this.closest('form');
            if (form) form.submit();
          });
        }
      }
    );
  }
{% endjavascript %}

{% schema %}
{
  "name": "Footer",
  "settings": [
    {
      "type": "select",
      "id": "background",
      "label": "Background",
      "options": [
        {
          "value": "paper",
          "label": "White"
        },
        {
          "value": "surface",
          "label": "Soft gray"
        }
      ],
      "default": "paper"
    },
    {
      "type": "header",
      "content": "Bottom bar"
    },
    {
      "type": "checkbox",
      "id": "show_kiosk_credit",
      "label": "Show \"Theme by KIOSK\" credit",
      "info": "A small link next to the copyright line. Feel free to turn it off.",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_country_selector",
      "label": "Show country selector",
      "info": "Only shown when the store has multiple countries enabled.",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "show_language_selector",
      "label": "Show language selector",
      "info": "Only shown when the store has multiple languages enabled.",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "show_payment_icons",
      "label": "Show payment icons",
      "default": true
    },
    {
      "type": "link_list",
      "id": "legal_menu",
      "label": "Policies menu",
      "info": "Shown next to the copyright."
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 48
    }
  ],
  "max_blocks": 4,
  "blocks": [
    {
      "type": "menu",
      "name": "Menu",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Quick links"
        },
        {
          "type": "link_list",
          "id": "menu",
          "label": "Menu"
        }
      ]
    },
    {
      "type": "text",
      "name": "Text",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "About"
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "Text",
          "default": "<p>Share store details, announcements, or brand content with your customers.</p>"
        }
      ]
    },
    {
      "type": "brand",
      "name": "Brand information",
      "limit": 1,
      "settings": [
        {
          "type": "paragraph",
          "content": "Edit the content under Theme settings > Brand information."
        }
      ]
    },
    {
      "type": "newsletter",
      "name": "Newsletter",
      "limit": 1,
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Newsletter"
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "Text",
          "default": "<p>Subscribe for new arrivals and exclusive offers.</p>"
        }
      ]
    }
  ]
}
{% endschema %}
