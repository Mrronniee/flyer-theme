{% comment %}
  Utility section, never added to a template. Rendered through the Section
  Rendering API on a product URL (/products/<handle>?section_id=wishlist-item)
  so the wishlist page can pull one product card per saved handle.
{% endcomment %}

{%- if product -%}
  {% render 'product-card', product: product, heading_level: 'h2' %}
{%- endif -%}

{% schema %}
{
  "name": "Wishlist item"
}
{% endschema %}
