{% comment %}
  FLYER — Customer login (templates/customers/login.json).
  Two panes: sign in, and password recovery. Without JS the recovery pane is
  reached through the #recover anchor (:target); with JS the toggle links swap
  panes without a jump. Shopify re-opens the recovery pane after a submit via
  form.posted_successfully?.
{% endcomment %}

{% render 'customer-styles' %}

{%- comment -%}
  The recovery pane is captured first so the form object can flip
  `recover_posted`; the flag then drives which pane opens on load.
{%- endcomment -%}
{%- assign recover_posted = false -%}
{%- capture recover_pane -%}
  <div class="fl-login__pane fl-login__pane--recover" id="recover" data-pane="recover">
    <div class="fl-account__head">
      <h1 class="fl-account__title">{{ 'customer.recover_password.title' | t }}</h1>
      <p class="fl-account__subtext">{{ 'customer.recover_password.subtext' | t }}</p>
    </div>

    {%- form 'recover_customer_password', class: 'fl-account__form' -%}
      {%- if form.posted_successfully? -%}
        {%- assign recover_posted = true -%}
        <p class="fl-form-status" role="status">{{ 'customer.recover_password.success' | t }}</p>
      {%- endif -%}

      {%- comment -%}
        Errors: the summary takes focus on load and links to each field; each
        invalid field carries aria-invalid and points to its own message.
        The section is only the main section of customers/login (no preset),
        so its ids stay fixed.
      {%- endcomment -%}
      {%- liquid
        # A refused address comes back under 'form' (single-field form): it
        # belongs to the email field as much as an error filed under 'email'.
        assign recover_email_invalid = false
        if form.errors contains 'email' or form.errors contains 'form'
          assign recover_email_invalid = true
        endif
      -%}
      {%- if form.errors -%}
        {%- assign recover_posted = true -%}
        <div id="FlRecoverErrors" class="fl-form-status fl-form-status--error" role="alert" tabindex="-1" autofocus>
          <ul class="fl-form-status__list">
            {%- for field in form.errors -%}
              <li>
                {%- case field -%}
                  {%- when 'email' -%}
                    <a href="#FlRecoverEmail">
                      {{- form.errors.translated_fields[field] | capitalize }} {{ form.errors.messages[field] -}}
                    </a>
                  {%- when 'form' -%}
                    <a href="#FlRecoverEmail">{{ form.errors.messages[field] }}</a>
                  {%- else -%}
                    {{ form.errors.messages[field] }}
                {%- endcase -%}
              </li>
            {%- endfor -%}
          </ul>
        </div>
      {%- endif -%}

      <p class="fl-form-note">{{ 'general.forms.required_note' | t }}</p>

      <div class="fl-field">
        <label class="fl-label" for="FlRecoverEmail">
          {{- 'customer.login.email' | t -}}
          <span class="fl-label__req" aria-hidden="true">*</span>
        </label>
        <input
          class="fl-input"
          type="email"
          name="email"
          id="FlRecoverEmail"
          autocomplete="email"
          autocapitalize="off"
          required
          {% if recover_email_invalid %}
            aria-invalid="true"
            aria-describedby="FlRecoverEmail-error"
          {% endif %}
        >
        {%- if recover_email_invalid -%}
          <p class="fl-field__error" id="FlRecoverEmail-error">
            {%- if form.errors contains 'email' -%}
              {{- form.errors.translated_fields.email | capitalize }} {{ form.errors.messages.email -}}
            {%- else -%}
              {{- form.errors.messages.form -}}
            {%- endif -%}
          </p>
        {%- endif -%}
      </div>

      <div class="fl-account__actions">
        <button type="submit" class="fl-btn">{{ 'customer.recover_password.submit' | t }}</button>
        <a class="fl-account__link" href="#login" data-recover-hide>
          {{- 'customer.recover_password.cancel' | t -}}
        </a>
      </div>
    {%- endform -%}
  </div>
{%- endcapture -%}

{%- comment -%}
  The attribute is only emitted when the recovery form was posted. Rendering
  data-recover-open="false" made its CSS rule outrank the :target fallback and
  hid BOTH panes for visitors without JavaScript.
{%- endcomment -%}
<fl-login
  class="fl-account"
  {% if recover_posted %}data-recover-open="true"{% endif %}
>
  <div class="fl-account__inner">
    <div class="fl-login__pane fl-login__pane--login" id="login" data-pane="login">
      <div class="fl-account__head">
        <h1 class="fl-account__title">{{ 'customer.login.title' | t }}</h1>
      </div>

      {%- form 'customer_login', class: 'fl-account__form' -%}
        {%- if form.errors -%}
          <div id="FlLoginErrors" class="fl-form-status fl-form-status--error" role="alert" tabindex="-1" autofocus>
            <ul class="fl-form-status__list">
              {%- for field in form.errors -%}
                {%- liquid
                  case field
                    when 'email'
                      assign field_target = 'FlLoginEmail'
                    when 'password'
                      assign field_target = 'FlLoginPassword'
                    else
                      assign field_target = blank
                  endcase
                -%}
                <li>
                  {%- if field_target != blank -%}
                    <a href="#{{ field_target }}">
                      {{- form.errors.translated_fields[field] | capitalize }} {{ form.errors.messages[field] -}}
                    </a>
                  {%- else -%}
                    {{ form.errors.messages[field] }}
                  {%- endif -%}
                </li>
              {%- endfor -%}
            </ul>
          </div>
        {%- endif -%}

        <p class="fl-form-note">{{ 'general.forms.required_note' | t }}</p>

        <div class="fl-field">
          <label class="fl-label" for="FlLoginEmail">
            {{- 'customer.login.email' | t -}}
            <span class="fl-label__req" aria-hidden="true">*</span>
          </label>
          <input
            class="fl-input"
            type="email"
            name="customer[email]"
            id="FlLoginEmail"
            autocomplete="email"
            autocapitalize="off"
            required
            {% if form.errors contains 'email' %}
              aria-invalid="true"
              aria-describedby="FlLoginEmail-error"
            {% endif %}
          >
          {%- if form.errors contains 'email' -%}
            <p class="fl-field__error" id="FlLoginEmail-error">
              {{- form.errors.translated_fields.email | capitalize }} {{ form.errors.messages.email -}}
            </p>
          {%- endif -%}
        </div>

        <div class="fl-field">
          <label class="fl-label" for="FlLoginPassword">
            {{- 'customer.login.password' | t -}}
            <span class="fl-label__req" aria-hidden="true">*</span>
          </label>
          <input
            class="fl-input"
            type="password"
            name="customer[password]"
            id="FlLoginPassword"
            autocomplete="current-password"
            required
            {% if form.errors contains 'password' %}
              aria-invalid="true"
              aria-describedby="FlLoginPassword-error"
            {% endif %}
          >
          {%- if form.errors contains 'password' -%}
            <p class="fl-field__error" id="FlLoginPassword-error">
              {{- form.errors.translated_fields.password | capitalize }} {{ form.errors.messages.password -}}
            </p>
          {%- endif -%}
        </div>

        <div class="fl-account__actions">
          <button type="submit" class="fl-btn">{{ 'customer.login.submit' | t }}</button>
          <a class="fl-account__link" href="#recover" data-recover-show>
            {{- 'customer.login.forgot_password' | t -}}
          </a>
        </div>
      {%- endform -%}

      {%- if shop.customer_accounts_enabled -%}
        <p class="fl-account__aside">
          {{ 'customer.login.new_customer' | t }}
          <a href="{{ routes.account_register_url }}">{{ 'customer.login.create_account' | t }}</a>
        </p>
      {%- endif -%}
    </div>

    {{ recover_pane }}
  </div>
</fl-login>

{% stylesheet %}
  /* Sign-in pane shows by default; recovery pane is opt-in. */
  .fl-login__pane--recover {
    display: none;
  }

  /* No-JS fallback: the #recover anchor swaps the panes. */
  .fl-login__pane--recover:target {
    display: block;
  }

  .fl-account__inner:has(.fl-login__pane--recover:target) .fl-login__pane--login {
    display: none;
  }

  /* Enhanced: the custom element drives the state without an anchor jump. */
  fl-login[data-recover-open='true'] .fl-login__pane--recover {
    display: block;
  }

  fl-login[data-recover-open='true'] .fl-login__pane--login {
    display: none;
  }

{% endstylesheet %}

{% javascript %}
  if (!customElements.get('fl-login')) {
    customElements.define(
      'fl-login',
      class FlLogin extends HTMLElement {
        connectedCallback() {
          this.addEventListener('click', this._onClick);
        }

        disconnectedCallback() {
          this.removeEventListener('click', this._onClick);
        }

        // The anchors are allowed to change the hash so the :target rules stay
        // the single source of truth; JS only clears the posted-state attribute
        // and moves focus into the pane that just appeared.
        _onClick = (event) => {
          const show = event.target.closest('[data-recover-show]');
          const hide = event.target.closest('[data-recover-hide]');
          if (!show && !hide) return;
          this.removeAttribute('data-recover-open');
          const pane = this.querySelector(show ? '[data-pane="recover"]' : '[data-pane="login"]');
          window.requestAnimationFrame(() => {
            // Shopify's form tag opens with hidden form_type/utf8 inputs: skip them.
            const field = pane.querySelector('input:not([type="hidden"])');
            if (field) field.focus();
          });
        };
      }
    );
  }
{% endjavascript %}

{% schema %}
{
  "name": "Login",
  "tag": "section",
  "settings": []
}
{% endschema %}
