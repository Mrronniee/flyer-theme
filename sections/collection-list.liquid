{% comment %}
  Collection list.
  Grid of hand-picked collections, shaped by the Collection cards theme
  settings. Blocks without a collection fall back to placeholders so the
  section previews in the editor. On mobile the grid can become a swipeable
  track, built with CSS scroll snapping so it needs no JavaScript.
{% endcomment %}

{%- liquid
  assign cols_desktop = section.settings.columns_desktop
  assign cols_mobile = section.settings.columns_mobile

  assign cols_tablet = cols_desktop
  if cols_tablet > 3
    assign cols_tablet = 3
  endif

  # A card is the content width — the page width less its two margins
  # (critical.css, --content-width) — less the grid gaps, which follow the
  # merchant's horizontal spacing above 749px and are 12px on a phone (CSS
  # below), divided by the column count. A plain 100/cols fraction of the
  # viewport announced a card wider than it is and fetched a step too wide.
  assign cols_mobile_int = cols_mobile | plus: 0
  assign page_margins = settings.min_page_margin | times: 2
  assign content_px = settings.max_page_width | minus: page_margins
  assign img_gaps = cols_desktop | minus: 1 | times: settings.spacing_grid_horizontal
  assign img_inset = img_gaps | plus: page_margins
  assign img_inset_tablet = cols_tablet | minus: 1 | times: settings.spacing_grid_horizontal | plus: page_margins
  assign img_inset_mobile = cols_mobile_int | minus: 1 | times: 12 | plus: page_margins
  assign img_sizes_cap = content_px | minus: img_gaps | divided_by: cols_desktop
  assign img_sizes = '(min-width: ' | append: settings.max_page_width | append: 'px) ' | append: img_sizes_cap | append: 'px, (max-width: 749px) calc((100vw - ' | append: img_inset_mobile | append: 'px) / ' | append: cols_mobile_int | append: '), (max-width: 989px) calc((100vw - ' | append: img_inset_tablet | append: 'px) / ' | append: cols_tablet | append: '), calc((100vw - ' | append: img_inset | append: 'px) / ' | append: cols_desktop | append: ')'

  assign swipe_basis = '46%'
  if cols_mobile == '1'
    assign swipe_basis = '78%'
  endif

  assign swipe = false
  if section.settings.swipe_on_mobile and section.blocks.size > cols_mobile_int
    assign swipe = true
  endif

  case section.settings.image_ratio
    when 'portrait'
      assign ratio = '4 / 5'
    when 'landscape'
      assign ratio = '4 / 3'
    else
      assign ratio = '1 / 1'
  endcase

  assign boxed = false
  if settings.collection_card_style == 'card'
    assign boxed = true
  endif
-%}

<section
  class="fl-collist full-width color-{{ section.settings.color_scheme }}"
  {% render 'reveal' %}
  style="padding-block: {{ section.settings.padding_top }}px {{ section.settings.padding_bottom }}px"
>
  <div class="fl-collist__inner">
    {%- if section.settings.heading != blank -%}
      <div class="fl-section-head">
        <h2 class="fl-collist__heading">{{ section.settings.heading | escape }}</h2>
      </div>
    {%- endif -%}

    <ul
      class="fl-collist__grid{% if swipe %} fl-collist__grid--swipe{% endif %}"
      role="list"
      style="--grid-cols: {{ cols_desktop }}; --grid-cols-tablet: {{ cols_tablet }}; --grid-cols-mobile: {{ cols_mobile }}; --coll-ratio: {{ ratio }}; --swipe-basis: {{ swipe_basis }}"
    >
      {%- if section.blocks.size > 0 -%}
        {%- for block in section.blocks -%}
          {%- liquid
            assign col = block.settings.collection
            # A block with no collection picked is an editor preview only.
            if col == blank and request.design_mode == false
              continue
            endif
            assign placeholder_index = forloop.index0 | modulo: 4 | plus: 1
            assign placeholder_name = 'collection-' | append: placeholder_index
          -%}
          <li class="fl-collist__item" {{ block.shopify_attributes }}>
            <div class="fl-collist__card{% if boxed %} fl-collist__card--boxed color-{{ settings.collection_card_color_scheme }}{% endif %}">
              {%- if col != blank -%}
                <a class="fl-collist__link" href="{{ col.url }}">
                  <span class="fl-collist__media">
                    {%- liquid
                      # First section of the page: the first row holds the largest paint and is
                      # fetched first (high priority for its first image only). Lower down
                      # everything waits (lazy) and leaves the bandwidth to the LCP.
                      assign img_load = 'lazy'
                      assign img_priority = 'auto'
                      if section.index == 1 and forloop.index <= cols_desktop
                        assign img_load = 'eager'
                        if forloop.first
                          assign img_priority = 'high'
                        endif
                      endif
                    -%}
                    {%- if col.featured_image -%}
                      {{
                        col.featured_image
                        | image_url: width: 1200
                        | image_tag:
                          widths: '300, 450, 600, 900, 1200',
                          sizes: img_sizes,
                          alt: col.featured_image.alt,
                          loading: img_load,
                          fetchpriority: img_priority,
                          class: 'fl-collist__img'
                      }}
                    {%- elsif col.products.first.featured_image -%}
                      {{
                        col.products.first.featured_image
                        | image_url: width: 1200
                        | image_tag:
                          widths: '300, 450, 600, 900, 1200',
                          sizes: img_sizes,
                          alt: col.title,
                          loading: img_load,
                          fetchpriority: img_priority,
                          class: 'fl-collist__img'
                      }}
                    {%- else -%}
                      {{ placeholder_name | placeholder_svg_tag: 'fl-collist__ph' | replace: '<svg ', '<svg aria-hidden="true" focusable="false" ' }}
                    {%- endif -%}
                  </span>
                  <span class="fl-collist__info">
                    <span class="fl-collist__name">{{ col.title | escape }}</span>
                    {%- if section.settings.show_product_count -%}
                      <span class="fl-collist__count">
                        {{- 'collections.general.product_count' | t: count: col.products_count -}}
                      </span>
                    {%- endif -%}
                  </span>
                </a>
              {%- else -%}
                <span class="fl-collist__link">
                  <span class="fl-collist__media">
                    {{ placeholder_name | placeholder_svg_tag: 'fl-collist__ph' | replace: '<svg ', '<svg aria-hidden="true" focusable="false" ' }}
                  </span>
                  <span class="fl-collist__info">
                    <span class="fl-collist__name">
                      {{- 'collections.general.placeholder_title' | t -}}
                    </span>
                  </span>
                </span>
              {%- endif -%}
            </div>
          </li>
        {%- endfor -%}
      {%- elsif request.design_mode -%}
        {%- for i in (1..3) -%}
          {%- assign placeholder_name = 'collection-' | append: i -%}
          <li class="fl-collist__item">
            <div class="fl-collist__card{% if boxed %} fl-collist__card--boxed color-{{ settings.collection_card_color_scheme }}{% endif %}">
              <span class="fl-collist__link">
                <span class="fl-collist__media">
                  {{ placeholder_name | placeholder_svg_tag: 'fl-collist__ph' | replace: '<svg ', '<svg aria-hidden="true" focusable="false" ' }}
                </span>
                <span class="fl-collist__info">
                  <span class="fl-collist__name">{{ 'collections.general.placeholder_title' | t }}</span>
                </span>
              </span>
            </div>
          </li>
        {%- endfor -%}
      {%- endif -%}
    </ul>

    {%- if section.settings.show_view_all -%}
      <div class="fl-collist__viewall">
        <a class="fl-btn fl-btn--secondary" href="{{ routes.collections_url }}">
          {{- 'collections.general.view_all' | t -}}
          <span class="visually-hidden"> {{ 'collections.general.title' | t }}</span>
        </a>
      </div>
    {%- endif -%}
  </div>
</section>

{% stylesheet %}
  .fl-collist__inner {
    width: var(--content-width);
    margin-inline: auto;
  }

  .fl-collist__heading {
    min-width: 0;
  }

  .fl-collist__grid {
    display: grid;
    grid-template-columns: repeat(var(--grid-cols, 3), minmax(0, 1fr));
    gap: var(--grid-gap-y, 28px) var(--grid-gap-x, 20px);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .fl-collist__item {
    min-width: 0;
  }

  /* Shaped by the Collection cards theme settings. */
  .fl-collist__card {
    display: flex;
    flex-direction: column;
    min-width: 0;
    height: 100%;
    text-align: var(--coll-card-text-align, left);
    border: var(--coll-card-border-width, 0) solid
      rgba(var(--color-ink-rgb), var(--coll-card-border-opacity, 0.1));
    border-radius: var(--coll-card-radius, 8px);
    box-shadow: var(--coll-card-shadow);
  }

  .fl-collist__card--boxed {
    padding: var(--coll-card-image-padding, 0);
    background: var(--color-bg);
  }

  .fl-collist__link {
    display: flex;
    flex-direction: column;
    gap: 12px;
    min-width: 0;
    text-decoration: none;
  }

  .fl-collist__media {
    display: block;
    overflow: hidden;
    border-radius: var(--coll-card-radius, 8px);
    background: var(--color-surface);
  }

  .fl-collist__img,
  .fl-collist__ph {
    width: 100%;
    aspect-ratio: var(--coll-ratio, 1 / 1);
    object-fit: cover;
    transition: transform 0.4s ease;
  }

  .fl-collist__ph {
    fill: var(--color-muted);
    opacity: 0.35;
  }

  .fl-collist__card:hover .fl-collist__img {
    transform: scale(1.03);
  }

  .fl-collist__info {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .fl-collist__name {
    font-weight: 500;
  }

  .fl-collist__count {
    font-size: 0.875em;
    color: var(--color-muted);
  }

  .fl-collist__viewall {
    display: flex;
    justify-content: center;
    margin-block-start: 32px;
  }

  @media (max-width: 989px) {
    .fl-collist__grid {
      grid-template-columns: repeat(var(--grid-cols-tablet, 3), minmax(0, 1fr));
    }
  }

  @media (max-width: 749px) {
    .fl-collist__grid {
      grid-template-columns: repeat(var(--grid-cols-mobile, 2), minmax(0, 1fr));
      gap: 24px 12px;
    }

    .fl-collist__grid--swipe {
      position: relative;
      display: flex;
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      /* Room for the cards' focus ring, which this scrolling row would
         otherwise clip; the negative margin keeps the cards aligned. */
      margin-inline: -4px;
      padding: 4px 4px 8px;
      scroll-padding-inline: 4px;
    }

    .fl-collist__grid--swipe .fl-collist__item {
      flex: 0 0 var(--swipe-basis, 46%);
      scroll-snap-align: start;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:names.collection_list",
  "max_blocks": 15,
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "t:labels.heading",
      "default": "Shop by category",
      "info": "t:info.leave_blank_to_hide_the_heading"
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "min": 1,
      "max": 6,
      "step": 1,
      "label": "t:labels.columns_on_desktop",
      "default": 3
    },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "t:labels.image_ratio",
      "options": [
        {
          "value": "square",
          "label": "t:labels.square"
        },
        {
          "value": "portrait",
          "label": "t:labels.portrait"
        },
        {
          "value": "landscape",
          "label": "t:labels.landscape"
        }
      ],
      "default": "square"
    },
    {
      "type": "checkbox",
      "id": "show_product_count",
      "label": "t:labels.show_product_count",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "show_view_all",
      "label": "t:labels.show_view_all_button",
      "default": false
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:labels.color_scheme",
      "info": "t:info.cards_use_the_collection_cards_theme_settings",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "t:content.mobile"
    },
    {
      "type": "select",
      "id": "columns_mobile",
      "label": "t:labels.columns_on_mobile",
      "options": [
        {
          "value": "1",
          "label": "t:labels.1_column"
        },
        {
          "value": "2",
          "label": "t:labels.2_columns"
        }
      ],
      "default": "2"
    },
    {
      "type": "checkbox",
      "id": "swipe_on_mobile",
      "label": "t:labels.swipe_on_mobile",
      "default": false
    },
    {
      "type": "header",
      "content": "t:content.spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "t:labels.top_padding",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "t:labels.bottom_padding",
      "default": 48
    }
  ],
  "blocks": [
    {
      "type": "featured_collection",
      "name": "t:names.collection",
      "settings": [
        {
          "type": "collection",
          "id": "collection",
          "label": "t:labels.collection"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:names.collection_list",
      "blocks": [
        {
          "type": "featured_collection"
        },
        {
          "type": "featured_collection"
        },
        {
          "type": "featured_collection"
        }
      ]
    }
  ]
}
{% endschema %}
