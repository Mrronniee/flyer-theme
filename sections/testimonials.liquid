{% comment %}
  Testimonials.
  Short customer quotes set typographically: a large opening quote mark in
  the heading font, the quote in body text, the author as an eyebrow line.
  Grid layout separates quotes with vertical hairlines on desktop; carousel
  layout scrolls horizontally with scroll-snap and gains previous/next
  buttons once <fl-testimonials> is defined (native scrolling without JS).
{% endcomment %}

{%- liquid
  assign carousel = false
  if section.settings.layout == 'carousel'
    assign carousel = true
  endif

  assign count = section.blocks.size
  assign cols = 3
  if count == 2 or count == 4
    assign cols = 2
  endif
-%}

<section
  class="fl-testimonials full-width color-{{ section.settings.color_scheme }}"
  {% render 'reveal' %}
  style="padding-block: {{ section.settings.padding_top }}px {{ section.settings.padding_bottom }}px"
>
  <div class="fl-testimonials__inner">
    {%- if section.settings.eyebrow != blank or section.settings.heading != blank -%}
      <div class="fl-section-head fl-testimonials__head">
        {%- if section.settings.eyebrow != blank -%}
          <span class="fl-eyebrow">{{ section.settings.eyebrow | escape }}</span>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          <h2 class="fl-testimonials__heading">{{ section.settings.heading | escape }}</h2>
        {%- endif -%}
      </div>
    {%- endif -%}

    {%- if count > 0 -%}
      <fl-testimonials
        class="fl-testimonials__body{% if carousel %} fl-testimonials__body--carousel{% endif %}"
        {% if carousel %}
          role="region"
          aria-label="{{ 'accessibility.carousel' | t }}"
        {% endif %}
      >
        {%- if carousel -%}
          <div class="fl-testimonials__controls">
            <button
              type="button"
              class="fl-testimonials__nav"
              data-prev
              aria-label="{{ 'accessibility.previous' | t }}"
            >
              <svg width="20" height="20" viewBox="0 0 20 20" fill="none" aria-hidden="true" focusable="false">
                <path d="M12.5 4 6.5 10l6 6" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </button>
            <button
              type="button"
              class="fl-testimonials__nav"
              data-next
              aria-label="{{ 'accessibility.next' | t }}"
            >
              <svg width="20" height="20" viewBox="0 0 20 20" fill="none" aria-hidden="true" focusable="false">
                <path d="m7.5 4 6 6-6 6" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </button>
          </div>
        {%- endif -%}

        <ul
          class="fl-testimonials__list{% if carousel %} fl-testimonials__list--carousel{% else %} fl-testimonials__list--grid{% endif %}"
          style="--cols: {{ cols }}"
          data-track
        >
          {%- for block in section.blocks -%}
            {%- liquid
              assign rating = block.settings.rating
              assign rating_label = 'sections.testimonials.rating_label' | t: rating: rating
            -%}
            <li class="fl-testimonials__item" data-item {{ block.shopify_attributes }}>
              <figure class="fl-testimonials__figure">
                <span class="fl-testimonials__mark" aria-hidden="true">&ldquo;</span>

                {%- if section.settings.show_rating -%}
                  <div class="fl-testimonials__stars" role="img" aria-label="{{ rating_label | escape }}">
                    {%- for i in (1..5) -%}
                      <svg
                        class="fl-testimonials__star{% if i > rating %} fl-testimonials__star--empty{% endif %}"
                        width="14"
                        height="14"
                        viewBox="0 0 24 24"
                        aria-hidden="true"
                        focusable="false"
                      >
                        <path d="M12 2.5l2.9 6.2 6.8.8-5 4.7 1.3 6.8L12 17.7 6 21l1.3-6.8-5-4.7 6.8-.8z" fill="currentColor" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/>
                      </svg>
                    {%- endfor -%}
                  </div>
                {%- endif -%}

                {%- if block.settings.quote != blank -%}
                  <blockquote class="fl-testimonials__quote">
                    <p>{{ block.settings.quote | escape }}</p>
                  </blockquote>
                {%- endif -%}

                {%- if block.settings.author != blank or block.settings.detail != blank or block.settings.image != blank -%}
                  <figcaption class="fl-testimonials__author">
                    {%- if block.settings.image != blank -%}
                      {{
                        block.settings.image
                        | image_url: width: 96
                        | image_tag:
                          widths: '48, 96',
                          sizes: '48px',
                          alt: block.settings.image.alt,
                          loading: 'lazy',
                          class: 'fl-testimonials__avatar'
                      }}
                    {%- endif -%}
                    <span class="fl-testimonials__meta">
                      {%- if block.settings.author != blank -%}
                        <span class="fl-eyebrow fl-testimonials__name">{{ block.settings.author | escape }}</span>
                      {%- endif -%}
                      {%- if block.settings.detail != blank -%}
                        <span class="fl-testimonials__detail">{{ block.settings.detail | escape }}</span>
                      {%- endif -%}
                    </span>
                  </figcaption>
                {%- endif -%}
              </figure>
            </li>
          {%- endfor -%}
        </ul>
      </fl-testimonials>
    {%- endif -%}
  </div>
</section>

{% stylesheet %}
  .fl-testimonials__inner {
    width: var(--content-width);
    margin-inline: auto;
  }

  .fl-testimonials__heading {
    min-width: 0;
  }

  .fl-testimonials__body {
    display: block;
    position: relative;
  }

  .fl-testimonials__list {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .fl-testimonials__item {
    min-width: 0;
  }

  .fl-testimonials__figure {
    display: flex;
    flex-direction: column;
    gap: 14px;
    margin: 0;
    height: 100%;
  }

  .fl-testimonials__mark {
    display: block;
    font-family: var(--font-heading-family);
    font-size: 3.5em;
    line-height: 0.7;
    color: var(--color-ink);
    margin-block-end: 4px;
  }

  .fl-testimonials__stars {
    display: inline-flex;
    gap: 2px;
    color: var(--color-ink);
  }

  .fl-testimonials__star--empty {
    fill: transparent;
    color: var(--color-line);
  }

  .fl-testimonials__quote {
    margin: 0;
    font-size: 1.0625em;
    line-height: 1.55;
  }

  .fl-testimonials__author {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-block-start: auto;
    padding-block-start: 6px;
  }

  .fl-testimonials__avatar {
    flex: 0 0 auto;
    width: 48px;
    height: 48px;
    border-radius: 50%;
    object-fit: cover;
    background-color: var(--color-surface);
  }

  .fl-testimonials__meta {
    display: flex;
    flex-direction: column;
    gap: 2px;
    min-width: 0;
  }

  .fl-testimonials__name {
    margin-bottom: 0;
    color: var(--color-ink);
  }

  .fl-testimonials__detail {
    font-size: 0.875em;
    color: var(--color-muted);
  }

  /* Grid: quotes side by side, separated by vertical hairlines. */
  .fl-testimonials__list--grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 32px 0;
  }

  .fl-testimonials__list--grid .fl-testimonials__item + .fl-testimonials__item {
    border-block-start: 1px solid var(--color-line);
    padding-block-start: 32px;
  }

  /* Carousel: native horizontal scroll with snap points. */
  .fl-testimonials__list--carousel {
    display: flex;
    gap: 0;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
    -webkit-overflow-scrolling: touch;
  }

  .fl-testimonials__list--carousel::-webkit-scrollbar {
    display: none;
  }

  .fl-testimonials__list--carousel .fl-testimonials__item {
    flex: 0 0 min(100%, 360px);
    scroll-snap-align: start;
    padding-inline-end: 32px;
  }

  .fl-testimonials__list--carousel .fl-testimonials__item + .fl-testimonials__item {
    border-inline-start: 1px solid var(--color-line);
    padding-inline-start: 32px;
  }

  .fl-testimonials__controls {
    display: none;
    justify-content: flex-end;
    gap: 8px;
    margin-block-end: 24px;
  }

  .fl-testimonials__body.is-enhanced .fl-testimonials__controls {
    display: flex;
  }

  .fl-testimonials__nav {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    padding: 0;
    border: 1px solid var(--color-line);
    border-radius: var(--radius-btn);
    background: transparent;
    color: var(--color-ink);
    cursor: pointer;
    transition: border-color 0.2s ease;
  }

  .fl-testimonials__nav:hover {
    border-color: var(--color-ink);
  }

  .fl-testimonials__nav[disabled] {
    opacity: 0.35;
    cursor: default;
  }

  @media (min-width: 750px) {
    .fl-testimonials__list--grid {
      grid-template-columns: repeat(var(--cols, 3), minmax(0, 1fr));
      gap: 0;
    }

    .fl-testimonials__list--grid .fl-testimonials__item {
      padding-inline: 32px;
    }

    .fl-testimonials__list--grid .fl-testimonials__item:first-child {
      padding-inline-start: 0;
    }

    .fl-testimonials__list--grid .fl-testimonials__item:last-child {
      padding-inline-end: 0;
    }

    .fl-testimonials__list--grid .fl-testimonials__item + .fl-testimonials__item {
      border-block-start: 0;
      border-inline-start: 1px solid var(--color-line);
      padding-block-start: 0;
    }

    .fl-testimonials__list--carousel .fl-testimonials__item {
      flex-basis: min(100%, 400px);
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    .fl-testimonials__list--carousel {
      scroll-behavior: smooth;
    }
  }
{% endstylesheet %}

{% javascript %}
  if (!customElements.get('fl-testimonials')) {
    customElements.define(
      'fl-testimonials',
      class extends HTMLElement {
        connectedCallback() {
          this.track = this.querySelector('[data-track]');
          this.prev = this.querySelector('[data-prev]');
          this.next = this.querySelector('[data-next]');
          if (!this.track || !this.prev || !this.next) return;

          this.items = Array.from(this.track.querySelectorAll('[data-item]'));
          if (this.items.length < 2) return;

          this.classList.add('is-enhanced');
          this.prev.addEventListener('click', () => this.step(-1));
          this.next.addEventListener('click', () => this.step(1));
          this.track.addEventListener('scroll', () => this.update(), { passive: true });
          this.update();
        }

        step(direction) {
          const width = this.items[0].getBoundingClientRect().width || this.track.clientWidth;
          this.track.scrollBy({ left: width * direction });
        }

        update() {
          const max = this.track.scrollWidth - this.track.clientWidth - 1;
          this.prev.disabled = this.track.scrollLeft <= 0;
          this.next.disabled = this.track.scrollLeft >= max;
        }
      }
    );
  }
{% endjavascript %}

{% schema %}
{
  "name": "Testimonials",
  "max_blocks": 8,
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Colour scheme",
      "default": "scheme-1"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "What customers say"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Loved by people who wear it daily"
    },
    {
      "type": "select",
      "id": "layout",
      "label": "Layout",
      "options": [
        {
          "value": "grid",
          "label": "Grid"
        },
        {
          "value": "carousel",
          "label": "Carousel"
        }
      ],
      "default": "grid"
    },
    {
      "type": "checkbox",
      "id": "show_rating",
      "label": "Show star rating",
      "default": true
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 48
    }
  ],
  "blocks": [
    {
      "type": "testimonial",
      "name": "Testimonial",
      "settings": [
        {
          "type": "textarea",
          "id": "quote",
          "label": "Quote",
          "default": "The quality is exactly what I hoped for. Delivered in three days, beautifully packed."
        },
        {
          "type": "text",
          "id": "author",
          "label": "Author",
          "default": "Camille R."
        },
        {
          "type": "text",
          "id": "detail",
          "label": "Detail",
          "info": "For example: Verified buyer, Lyon",
          "default": "Verified buyer, Lyon"
        },
        {
          "type": "range",
          "id": "rating",
          "min": 1,
          "max": 5,
          "step": 1,
          "label": "Rating",
          "default": 5
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Portrait",
          "info": "Optional, shown as a 48px circle."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Testimonials",
      "blocks": [
        {
          "type": "testimonial",
          "settings": {
            "quote": "The quality is exactly what I hoped for. Delivered in three days, beautifully packed.",
            "author": "Camille R.",
            "detail": "Verified buyer, Lyon",
            "rating": 5
          }
        },
        {
          "type": "testimonial",
          "settings": {
            "quote": "I ordered the wrong size and the exchange took one email. That kind of service keeps me coming back.",
            "author": "Thomas B.",
            "detail": "Verified buyer, Brussels",
            "rating": 5
          }
        },
        {
          "type": "testimonial",
          "settings": {
            "quote": "Six months of daily wear and it still looks new. Worth every cent.",
            "author": "Ana M.",
            "detail": "Verified buyer, Lisbon",
            "rating": 4
          }
        }
      ]
    }
  ]
}
{% endschema %}
