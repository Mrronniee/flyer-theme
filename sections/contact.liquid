{% comment %}
  FLYER — Contact form.
  Main section of templates/page.contact.json, and addable to any template
  through its preset. Because it can sit next to a template that already has a
  main title, the heading level defaults to H2; switch it to H1 in the editor
  on the page where this section carries the main title.
  Field ids are suffixed with section.id so two instances on one page keep
  their own label/field pairing.
{% endcomment %}

{%- liquid
  assign heading_tag = section.settings.heading_tag | default: 'h2'

  assign heading = section.settings.heading | escape
  if heading == blank
    assign heading = page.title | escape
  endif
  if heading == blank
    assign heading = 'contact.form.title' | t
  endif
-%}

<div
  class="fl-contact full-width color-{{ section.settings.color_scheme }}"
  {% render 'reveal' %}
  style="padding-block: {{ section.settings.padding_top }}px {{ section.settings.padding_bottom }}px;"
>
  <div class="fl-contact__inner">
    <div class="fl-contact__head">
      <{{ heading_tag }} class="fl-contact__title">{{ heading }}</{{ heading_tag }}>

      {%- if section.settings.intro != blank -%}
        <div class="fl-contact__intro fl-rte">{{ section.settings.intro }}</div>
      {%- elsif page.content != blank -%}
        <div class="fl-contact__intro fl-rte">{{ page.content }}</div>
      {%- endif -%}
    </div>

    {%- form 'contact', class: 'fl-contact__form' -%}
      {%- liquid
        assign errors_id = 'FlContactErrors-' | append: section.id
        assign name_id = 'FlContactName-' | append: section.id
        assign email_id = 'FlContactEmail-' | append: section.id
        assign phone_id = 'FlContactPhone-' | append: section.id
        assign body_id = 'FlContactBody-' | append: section.id
      -%}

      {%- if form.posted_successfully? -%}
        <p class="fl-form-status" role="status">{{ 'contact.form.success' | t }}</p>
      {%- endif -%}

      {%- comment -%}
        Errors: the summary takes focus on load and links to each field; each
        invalid field carries aria-invalid and points to its own message.
      {%- endcomment -%}
      {%- if form.errors -%}
        <div id="{{ errors_id }}" class="fl-form-status fl-form-status--error" role="alert" tabindex="-1" autofocus>
          <p>{{ 'contact.form.error' | t }}</p>
          <ul class="fl-form-status__list">
            {%- for field in form.errors -%}
              {%- liquid
                case field
                  when 'name'
                    assign field_target = name_id
                  when 'email'
                    assign field_target = email_id
                  when 'phone'
                    assign field_target = phone_id
                  when 'body'
                    assign field_target = body_id
                  else
                    assign field_target = blank
                endcase
              -%}
              <li>
                {%- if field_target != blank -%}
                  <a href="#{{ field_target }}">
                    {{- form.errors.translated_fields[field] | capitalize }} {{ form.errors.messages[field] -}}
                  </a>
                {%- else -%}
                  {{ form.errors.messages[field] }}
                {%- endif -%}
              </li>
            {%- endfor -%}
          </ul>
        </div>
      {%- endif -%}

      <p class="fl-form-note">{{ 'general.forms.required_note' | t }}</p>

      <div class="fl-field">
        <label class="fl-label" for="{{ name_id }}">{{ 'contact.form.name' | t }}</label>
        <input
          class="fl-input"
          type="text"
          id="{{ name_id }}"
          name="contact[name]"
          value="{{ form.name | escape_once }}"
          data-form-echo
          autocomplete="name"
          {% if form.errors contains 'name' %}
            aria-invalid="true"
            aria-describedby="{{ name_id }}-error"
          {% endif %}
        >
        {%- if form.errors contains 'name' -%}
          <p class="fl-field__error" id="{{ name_id }}-error">
            {{- form.errors.translated_fields.name | capitalize }} {{ form.errors.messages.name -}}
          </p>
        {%- endif -%}
      </div>

      <div class="fl-field">
        <label class="fl-label" for="{{ email_id }}">
          {{- 'contact.form.email' | t -}}
          <span class="fl-label__req" aria-hidden="true">*</span>
        </label>
        <input
          class="fl-input"
          type="email"
          id="{{ email_id }}"
          name="contact[email]"
          value="{{ form.email | escape_once }}"
          data-form-echo
          autocomplete="email"
          autocapitalize="off"
          required
          {% if form.errors contains 'email' %}
            aria-invalid="true"
            aria-describedby="{{ email_id }}-error"
          {% endif %}
        >
        {%- if form.errors contains 'email' -%}
          <p class="fl-field__error" id="{{ email_id }}-error">
            {{- form.errors.translated_fields.email | capitalize }} {{ form.errors.messages.email -}}
          </p>
        {%- endif -%}
      </div>

      <div class="fl-field">
        <label class="fl-label" for="{{ phone_id }}">{{ 'contact.form.phone' | t }}</label>
        <input
          class="fl-input"
          type="tel"
          id="{{ phone_id }}"
          name="contact[phone]"
          value="{{ form.phone | escape_once }}"
          data-form-echo
          autocomplete="tel"
          {% if form.errors contains 'phone' %}
            aria-invalid="true"
            aria-describedby="{{ phone_id }}-error"
          {% endif %}
        >
        {%- if form.errors contains 'phone' -%}
          <p class="fl-field__error" id="{{ phone_id }}-error">
            {{- form.errors.translated_fields.phone | capitalize }} {{ form.errors.messages.phone -}}
          </p>
        {%- endif -%}
      </div>

      <div class="fl-field">
        <label class="fl-label" for="{{ body_id }}">
          {{- 'contact.form.message' | t -}}
          <span class="fl-label__req" aria-hidden="true">*</span>
        </label>
        <textarea
          class="fl-textarea"
          id="{{ body_id }}"
          name="contact[body]"
          rows="6"
          required
          {% if form.errors contains 'body' %}
            aria-invalid="true"
            aria-describedby="{{ body_id }}-error"
          {% endif %}
        >
          {{- form.body | escape_once -}}
        </textarea>
        {%- if form.errors contains 'body' -%}
          <p class="fl-field__error" id="{{ body_id }}-error">
            {{- form.errors.translated_fields.body | capitalize }} {{ form.errors.messages.body -}}
          </p>
        {%- endif -%}
      </div>

      <button type="submit" class="fl-btn">{{ 'contact.form.submit' | t }}</button>
    {%- endform -%}
  </div>
</div>

{% stylesheet %}
  .fl-contact {
    display: block;
  }

  .fl-contact__inner {
    width: min(560px, calc(100% - var(--page-margin) * 2));
    min-width: 0;
    margin-inline: auto;
  }

  .fl-contact__head {
    margin-bottom: 32px;
  }

  .fl-contact__title {
    margin: 0 0 16px;
  }

  .fl-contact__intro {
    color: var(--color-muted);
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Contact form",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "info": "Leave empty to use the page title."
    },
    {
      "type": "select",
      "id": "heading_tag",
      "label": "Heading level",
      "info": "Use H1 only when this is the main heading of the page.",
      "options": [
        {
          "value": "h1",
          "label": "H1"
        },
        {
          "value": "h2",
          "label": "H2"
        },
        {
          "value": "h3",
          "label": "H3"
        }
      ],
      "default": "h2"
    },
    {
      "type": "richtext",
      "id": "intro",
      "label": "Intro text",
      "info": "Leave empty to use the page content."
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 48
    }
  ],
  "presets": [
    {
      "name": "Contact form"
    }
  ]
}
{% endschema %}
