{%- liquid
  assign menu = section.settings.menu
  assign logo_alt = settings.logo.alt | default: shop.name | escape

  comment
    The stylesheet below publishes --sticky-offset: 88px, sized for the 64px
    wordmark bar (+1px border, +23px clearance). An image logo renders at
    settings.logo_width wide with height auto, so its height — and the bar's —
    is known here: logo_width / aspect_ratio. When that makes the bar taller
    than 64px, override the offset so sticky columns (product info, cart
    summary) still clear the header. Pure Liquid: no JS required.
  endcomment
  assign sticky_offset = 0
  if section.settings.sticky_header and settings.logo != blank and settings.logo.aspect_ratio > 0
    assign logo_h = settings.logo_width | divided_by: settings.logo.aspect_ratio | ceil
    assign bar_h = logo_h | plus: 20
    if bar_h > 64
      assign sticky_offset = bar_h | plus: 24
    endif
  endif
-%}

{%- if sticky_offset > 88 -%}
  {% style %}
    :root:has(.fl-header-section [data-sticky]) {
      --sticky-offset: {{ sticky_offset }}px;
    }
  {% endstyle %}
{%- endif -%}

<fl-header
  class="fl-header full-width"
  {% if section.settings.sticky_header %}
    data-sticky
  {% endif %}
  {%- comment -%}
    Both plural forms are exposed because a pluralised key cannot be rendered
    with a placeholder count — passing '%COUNT%' always resolves to "other".
  {%- endcomment -%}
  data-cart-label-one="{{ 'accessibility.cart_count' | t: count: 1 | replace: '1', '%COUNT%' | escape }}"
  data-cart-label-other="{{ 'accessibility.cart_count' | t: count: 2 | replace: '2', '%COUNT%' | escape }}"
>
  <div class="fl-header__bar">
    <button
      type="button"
      class="fl-header__icon-btn fl-header__burger"
      aria-expanded="false"
      aria-controls="FlMenuDrawer"
      aria-haspopup="dialog"
      data-menu-open
    >
      <svg width="20" height="20" viewBox="0 0 20 20" fill="none" aria-hidden="true" focusable="false">
        <path d="M3 5.5h14M3 10h14M3 14.5h14" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
      </svg>
      <span class="visually-hidden">{{ 'accessibility.open_menu' | t }}</span>
    </button>

    {%- comment -%}
      No-JS fallback: the burger only calls FlHeader.openDrawer(), so without
      JS it is an inert control and the mobile drawer can never open. Hide it
      and show the inline nav instead — its dropdowns are native <details>,
      which work without JS. Same pattern as the <noscript> players/buttons
      in video.liquid and collection.liquid.
    {%- endcomment -%}
    <noscript>
      <style>
        @media (max-width: 989px) {
          .fl-header__burger {
            display: none;
          }

          .fl-header__nav,
          .fl-header__account {
            display: flex;
          }
        }
      </style>
    </noscript>

    <a class="fl-header__logo" href="{{ routes.root_url }}">
      {%- if settings.logo != blank -%}
        {%- assign logo_w = settings.logo_width -%}
        {%- assign logo_w2 = logo_w | times: 2 -%}
        {%- assign logo_widths = logo_w | append: ', ' | append: logo_w2 -%}
        {%- assign logo_sizes = logo_w | append: 'px' -%}
        {%- capture logo_style -%}width: {{ logo_w }}px; height: auto;{%- endcapture -%}
        {{
          settings.logo
          | image_url: width: logo_w2
          | image_tag:
            class: 'fl-header__logo-img',
            widths: logo_widths,
            sizes: logo_sizes,
            alt: logo_alt,
            loading: 'eager',
            style: logo_style
        }}
      {%- else -%}
        <span class="fl-header__wordmark">{{ shop.name }}</span>
      {%- endif -%}
    </a>

    {%- if menu.links.size > 0 -%}
      <nav class="fl-header__nav" aria-label="{{ 'accessibility.main_menu' | t }}">
        <ul class="fl-header__menu">
          {%- for link in menu.links -%}
            <li class="fl-header__item">
              {%- if link.links.size > 0 -%}
                <details class="fl-header__dropdown" data-dropdown>
                  <summary class="fl-header__link fl-header__summary{% if link.current or link.child_active %} is-active{% endif %}">
                    <span>{{ link.title | escape }}</span>
                    <svg class="fl-header__caret" width="10" height="10" viewBox="0 0 10 10" fill="none" aria-hidden="true" focusable="false">
                      <path d="m2 3.5 3 3 3-3" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>
                  </summary>
                  <ul class="fl-header__panel{% if link.links.size > 6 %} fl-header__panel--wide{% endif %}">
                    {%- for child in link.links -%}
                      <li>
                        <a
                          class="fl-header__sublink{% if child.current %} is-active{% endif %}"
                          href="{{ child.url }}"
                          {% if child.current %}
                            aria-current="page"
                          {% endif %}
                        >{{ child.title | escape }}</a>
                        {%- if child.links.size > 0 -%}
                          <ul class="fl-header__subgroup">
                            {%- for grand in child.links -%}
                              <li>
                                <a
                                  class="fl-header__sublink fl-header__sublink--nested{% if grand.current %} is-active{% endif %}"
                                  href="{{ grand.url }}"
                                  {% if grand.current %}
                                    aria-current="page"
                                  {% endif %}
                                >{{ grand.title | escape }}</a>
                              </li>
                            {%- endfor -%}
                          </ul>
                        {%- endif -%}
                      </li>
                    {%- endfor -%}
                  </ul>
                </details>
              {%- else -%}
                <a
                  class="fl-header__link{% if link.current %} is-active{% endif %}"
                  href="{{ link.url }}"
                  {% if link.current %}
                    aria-current="page"
                  {% endif %}
                >{{ link.title | escape }}</a>
              {%- endif -%}
            </li>
          {%- endfor -%}
        </ul>
      </nav>
    {%- endif -%}

    <div class="fl-header__icons">
      {%- if section.settings.show_search -%}
        {%- comment -%}
          Real link so search stays reachable without JS; <fl-search>'s
          delegated [data-search-open] handler preventDefaults it and opens
          the overlay instead (same pattern as data-cart-open).
        {%- endcomment -%}
        <a
          class="fl-header__icon-btn"
          href="{{ routes.search_url }}"
          data-search-open
          aria-haspopup="dialog"
          aria-expanded="false"
          aria-controls="FlSearchOverlay"
        >
          <svg width="20" height="20" viewBox="0 0 20 20" fill="none" aria-hidden="true" focusable="false">
            <circle cx="9" cy="9" r="5.5" stroke="currentColor" stroke-width="1.5"/>
            <path d="m13.5 13.5 3.5 3.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
          </svg>
          <span class="visually-hidden">{{ 'accessibility.search' | t }}</span>
        </a>
      {%- endif -%}

      {%- liquid
        assign header_country = false
        if section.settings.show_country_selector and localization.available_countries.size > 1
          assign header_country = true
        endif
        assign header_language = false
        if section.settings.show_language_selector and localization.available_languages.size > 1
          assign header_language = true
        endif
      -%}
      {%- if header_country or header_language -%}
        {%- comment -%} Native <details>: opens without JS; forms post without JS. {%- endcomment -%}
        <details class="fl-header__loc">
          <summary class="fl-header__icon-btn fl-header__loc-toggle" aria-label="{{ 'general.localization.country_label' | t }}">
            <svg width="20" height="20" viewBox="0 0 20 20" fill="none" aria-hidden="true" focusable="false">
              <circle cx="10" cy="10" r="7.25" stroke="currentColor" stroke-width="1.5"/>
              <path d="M2.75 10h14.5M10 2.75c2.2 2.2 2.2 12.3 0 14.5M10 2.75c-2.2 2.2-2.2 12.3 0 14.5" stroke="currentColor" stroke-width="1.5"/>
            </svg>
            {%- if header_country -%}
              <span class="fl-header__loc-code" aria-hidden="true">{{ localization.country.iso_code }}</span>
            {%- endif -%}
          </summary>
          <div class="fl-header__loc-panel fl-box">
            {%- if header_country -%}
              {% render 'localization-form', kind: 'country', id_prefix: 'Header', class_prefix: 'fl-header__loc' %}
            {%- endif -%}
            {%- if header_language -%}
              {% render 'localization-form', kind: 'language', id_prefix: 'Header', class_prefix: 'fl-header__loc' %}
            {%- endif -%}
          </div>
        </details>
      {%- endif -%}

      {%- if settings.wishlist_enabled -%}
        <a class="fl-header__icon-btn fl-header__wishlist" href="{{ settings.wishlist_page | default: '/pages/wishlist' }}">
          <svg width="20" height="20" viewBox="0 0 20 20" fill="none" aria-hidden="true" focusable="false">
            <path d="M10 17s-6.5-4.1-6.5-8.6A3.4 3.4 0 0 1 10 6.3a3.4 3.4 0 0 1 6.5 2.1C16.5 12.9 10 17 10 17Z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/>
          </svg>
          <span class="visually-hidden">{{ 'wishlist.title' | t }}</span>
          <span class="fl-wishlist-count" data-wishlist-count aria-hidden="true" hidden>0</span>
        </a>
      {%- endif -%}

      {%- if shop.customer_accounts_enabled -%}
        <a class="fl-header__icon-btn fl-header__account" href="{{ routes.account_login_url }}">
          <svg width="20" height="20" viewBox="0 0 20 20" fill="none" aria-hidden="true" focusable="false">
            <circle cx="10" cy="6.5" r="3.25" stroke="currentColor" stroke-width="1.5"/>
            <path d="M3.75 17c.9-3 3.3-4.75 6.25-4.75S15.35 14 16.25 17" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
          </svg>
          <span class="visually-hidden">{{ 'customer.account.title' | t }}</span>
        </a>
      {%- endif -%}

      <a
        class="fl-header__icon-btn fl-header__cart"
        href="{{ routes.cart_url }}"
        aria-label="{{ 'accessibility.cart_count' | t: count: cart.item_count }}"
        {% if settings.cart_type == 'drawer' %}
          data-cart-open
        {% endif %}
        data-cart-link
      >
        <svg width="20" height="20" viewBox="0 0 20 20" fill="none" aria-hidden="true" focusable="false">
          <path d="M4 6.5h12l-.8 9.25a1.5 1.5 0 0 1-1.5 1.37H6.3a1.5 1.5 0 0 1-1.5-1.37Z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/>
          <path d="M7.25 8.5V5.75a2.75 2.75 0 0 1 5.5 0V8.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
        </svg>
        <span
          class="fl-header__cart-count{% if cart.item_count == 0 %} is-empty{% endif %}"
          data-cart-count
          aria-hidden="true"
        >{{ cart.item_count }}</span>
      </a>
      <span class="visually-hidden" role="status" aria-live="polite" data-cart-live></span>
    </div>
  </div>

  <dialog
    class="fl-header__drawer fl-drawer"
    id="FlMenuDrawer"
    data-menu-drawer
    scroll-lock
    aria-label="{{ 'accessibility.main_menu' | t }}"
  >
    <div class="fl-header__drawer-inner">
      <div class="fl-header__drawer-head">
        <span class="fl-header__drawer-title">{{ shop.name }}</span>
        <button type="button" class="fl-header__icon-btn" data-menu-close>
          <svg width="20" height="20" viewBox="0 0 20 20" fill="none" aria-hidden="true" focusable="false">
            <path d="m5 5 10 10M15 5 5 15" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
          </svg>
          <span class="visually-hidden">{{ 'accessibility.close_menu' | t }}</span>
        </button>
      </div>

      {%- if menu.links.size > 0 -%}
        <nav class="fl-header__drawer-nav" aria-label="{{ 'accessibility.main_menu' | t }}">
          <ul class="fl-header__drawer-menu">
            {%- for link in menu.links -%}
              <li>
                {%- if link.links.size > 0 -%}
                  <details class="fl-header__drawer-details">
                    <summary class="fl-header__drawer-link fl-header__drawer-summary">
                      <span>{{ link.title | escape }}</span>
                      <svg class="fl-header__caret" width="10" height="10" viewBox="0 0 10 10" fill="none" aria-hidden="true" focusable="false">
                        <path d="m2 3.5 3 3 3-3" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                      </svg>
                    </summary>
                    <ul class="fl-header__drawer-sub">
                      {%- for child in link.links -%}
                        <li>
                          <a
                            class="fl-header__drawer-sublink"
                            href="{{ child.url }}"
                            {% if child.current %}
                              aria-current="page"
                            {% endif %}
                          >{{ child.title | escape }}</a>
                          {%- if child.links.size > 0 -%}
                            <ul class="fl-header__drawer-sub fl-header__drawer-sub--nested">
                              {%- for grand in child.links -%}
                                <li>
                                  <a
                                    class="fl-header__drawer-sublink fl-header__drawer-sublink--nested"
                                    href="{{ grand.url }}"
                                    {% if grand.current %}
                                      aria-current="page"
                                    {% endif %}
                                  >{{ grand.title | escape }}</a>
                                </li>
                              {%- endfor -%}
                            </ul>
                          {%- endif -%}
                        </li>
                      {%- endfor -%}
                    </ul>
                  </details>
                {%- else -%}
                  <a
                    class="fl-header__drawer-link"
                    href="{{ link.url }}"
                    {% if link.current %}
                      aria-current="page"
                    {% endif %}
                  >{{ link.title | escape }}</a>
                {%- endif -%}
              </li>
            {%- endfor -%}
          </ul>
        </nav>
      {%- endif -%}

      {%- if shop.customer_accounts_enabled -%}
        <div class="fl-header__drawer-foot">
          <a class="fl-header__drawer-account" href="{{ routes.account_login_url }}">
            <svg width="20" height="20" viewBox="0 0 20 20" fill="none" aria-hidden="true" focusable="false">
              <circle cx="10" cy="6.5" r="3.25" stroke="currentColor" stroke-width="1.5"/>
              <path d="M3.75 17c.9-3 3.3-4.75 6.25-4.75S15.35 14 16.25 17" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
            </svg>
            {{ 'customer.account.title' | t }}
          </a>
        </div>
      {%- endif -%}
    </div>
  </dialog>

  {%- if section.settings.show_search -%}
    {% render 'search-overlay' %}
  {%- endif -%}
</fl-header>

{% stylesheet %}
  .fl-header-section:has([data-sticky]) {
    position: sticky;
    top: 0;
    z-index: 50;
  }

  /* Sticky columns elsewhere read this so they don't slide under the header.
     88px fits the 64px wordmark bar; when an image logo makes the bar taller,
     the style block at the top of this section overrides it with the value
     computed from logo_width / aspect_ratio. */
  :root:has(.fl-header-section [data-sticky]) {
    --sticky-offset: 88px;
  }

  .fl-header {
    display: block;
    background: var(--color-bg);
    border-bottom: 1px solid var(--color-line);
  }

  .fl-header__bar {
    display: flex;
    align-items: center;
    gap: 28px;
    max-width: var(--page-width);
    margin-inline: auto;
    padding: 10px var(--page-margin);
    min-height: 64px;
  }

  .fl-header__logo {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    color: var(--color-ink);
    text-decoration: none;
  }

  .fl-header__wordmark {
    font-family: var(--font-heading-family);
    font-weight: 600;
    font-size: 1.125em;
    letter-spacing: 0.01em;
    white-space: nowrap;
  }

  .fl-header__nav {
    display: flex;
    min-width: 0;
  }

  .fl-header__menu {
    display: flex;
    flex-wrap: wrap;
    gap: 4px 24px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .fl-header__item {
    position: relative;
  }

  .fl-header__link {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    min-height: 44px;
    padding: 10px 2px;
    color: var(--color-ink);
    font-size: 0.9375em;
    text-decoration: none;
  }

  .fl-header__link::after {
    content: '';
    position: absolute;
    inset: auto 2px 9px 2px;
    height: 1px;
    background: var(--color-ink);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.2s ease;
  }

  .fl-header__link:hover::after,
  .fl-header__link.is-active::after,
  .fl-header__dropdown[open] > .fl-header__summary::after {
    transform: scaleX(1);
  }

  .fl-header__summary {
    cursor: pointer;
    list-style: none;
  }

  .fl-header__summary::-webkit-details-marker {
    display: none;
  }

  .fl-header__summary::marker {
    content: none;
  }

  .fl-header__caret {
    flex: 0 0 auto;
    color: var(--color-muted);
    transition: transform 0.2s ease;
  }

  .fl-header__dropdown[open] > .fl-header__summary .fl-header__caret {
    transform: rotate(180deg);
  }

  .fl-header__panel {
    position: absolute;
    top: 100%;
    left: -20px;
    z-index: 5;
    min-width: 240px;
    /* A single unbreakable submenu word (min-content > 220px) would otherwise
       push the panel past the viewport edge and scroll the whole page. */
    max-width: min(320px, calc(100vw - var(--page-margin) * 2));
    overflow-wrap: anywhere;
    margin: 0;
    padding: 14px 0;
    list-style: none;
    background: var(--color-bg);
    border: 1px solid var(--color-line);
    border-radius: 0;
    box-shadow: 0 18px 50px rgb(0 0 0 / 8%);
  }

  /* Long submenus read as a column of links; past six they go two-up. */
  .fl-header__panel--wide {
    display: grid;
    grid-template-columns: repeat(2, minmax(150px, 1fr));
    column-gap: 8px;
    min-width: 380px;
  }

  .fl-header__dropdown[open] .fl-header__panel {
    animation: fl-header-fade 0.15s ease;
  }

  @keyframes fl-header-fade {
    from {
      opacity: 0;
      transform: translateY(-4px);
    }
  }

  .fl-header__sublink {
    position: relative;
    display: flex;
    align-items: center;
    min-height: 44px;
    padding: 6px 20px;
    color: var(--color-ink);
    font-size: 0.9375em;
    text-decoration: none;
  }

  /* Same rule that underlines the top-level links, inset to the panel padding:
     a grey fill block was the one un-editorial thing left in the header. */
  .fl-header__sublink::after {
    content: '';
    position: absolute;
    inset: auto 20px 9px 20px;
    height: 1px;
    background: var(--color-ink);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.2s ease;
  }

  .fl-header__sublink:hover::after,
  .fl-header__sublink:focus-visible::after {
    transform: scaleX(1);
  }

  .fl-header__sublink.is-active {
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  .fl-header__subgroup {
    margin: 0;
    padding: 0 0 4px;
    list-style: none;
  }

  .fl-header__sublink--nested {
    padding-left: 32px;
    color: var(--color-muted);
    font-size: 0.875em;
  }

  .fl-header__icons {
    display: flex;
    align-items: center;
    gap: 2px;
    margin-left: auto;
  }

  .fl-header__icon-btn {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    padding: 0;
    border: 0;
    border-radius: var(--radius-btn);
    background: none;
    color: var(--color-ink);
    cursor: pointer;
    text-decoration: none;
    transition: background 0.15s ease;
  }

  .fl-header__icon-btn:hover {
    background: var(--color-surface);
  }

  .fl-header__cart-count {
    position: absolute;
    top: 4px;
    right: 3px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 16px;
    height: 16px;
    padding: 0 4px;
    background: var(--color-accent);
    color: var(--color-on-accent);
    font-size: 10px;
    font-weight: 600;
    line-height: 1;
    border-radius: 999px;
  }

  .fl-header__cart-count.is-empty {
    display: none;
  }

  .fl-header__burger {
    display: none;
  }

  /* Background, start border and shadow come from the shared .fl-drawer class
     (Drawers theme settings), applied on the dialog in the markup. Only the
     three remaining UA dialog borders are reset here. */
  .fl-header__drawer {
    position: fixed;
    inset: 0 auto 0 0;
    width: min(360px, 86vw);
    height: 100dvh;
    max-height: none;
    max-width: none;
    margin: 0;
    padding: 0;
    border-block: 0;
    border-inline-end: 0;
  }

  .fl-header__drawer[open] {
    animation: fl-header-slide 0.25s ease;
  }

  @keyframes fl-header-slide {
    from {
      transform: translateX(-100%);
    }
  }

  .fl-header__drawer::backdrop {
    background: rgb(0 0 0 / 40%);
  }

  .fl-header__drawer-inner {
    display: flex;
    flex-direction: column;
    height: 100%;
  }

  .fl-header__drawer-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    min-height: 64px;
    padding: 10px var(--page-margin);
    border-bottom: 1px solid var(--color-line);
  }

  .fl-header__drawer-title {
    font-family: var(--font-heading-family);
    font-weight: 600;
  }

  .fl-header__drawer-nav {
    flex: 1 1 auto;
    overflow-y: auto;
    padding: 8px 0;
  }

  .fl-header__drawer-menu,
  .fl-header__drawer-sub {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .fl-header__drawer-sub {
    padding-bottom: 8px;
  }

  .fl-header__drawer-link {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    width: 100%;
    min-height: 56px;
    padding: 12px var(--page-margin);
    color: var(--color-ink);
    font-family: var(--font-heading-family);
    font-size: 1.0625em;
    letter-spacing: -0.01em;
    text-decoration: none;
  }

  /* Hairlines between top-level entries; nested lists keep the body font. */
  .fl-header__drawer-menu > li + li {
    border-top: 1px solid var(--color-line);
  }

  .fl-header__drawer-sub .fl-header__drawer-link {
    min-height: 44px;
    font-family: inherit;
    font-size: 0.9375em;
    color: var(--color-muted);
  }

  .fl-header__drawer-summary {
    cursor: pointer;
    list-style: none;
  }

  .fl-header__drawer-summary::-webkit-details-marker {
    display: none;
  }

  .fl-header__drawer-summary::marker {
    content: none;
  }

  .fl-header__drawer-details[open] > .fl-header__drawer-summary .fl-header__caret {
    transform: rotate(180deg);
  }

  .fl-header__drawer-sublink {
    display: flex;
    align-items: center;
    min-height: 44px;
    padding: 8px var(--page-margin) 8px 40px;
    color: var(--color-muted);
    text-decoration: none;
  }

  .fl-header__drawer-sublink:hover,
  .fl-header__drawer-sublink[aria-current='page'] {
    color: var(--color-ink);
  }

  .fl-header__drawer-sublink--nested {
    padding-left: 56px;
    font-size: 0.875em;
  }

  .fl-header__drawer-foot {
    padding: 12px var(--page-margin);
    border-top: 1px solid var(--color-line);
  }

  .fl-header__drawer-account {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    min-height: 44px;
    color: var(--color-ink);
    text-decoration: none;
  }

  .fl-header__drawer-account:hover {
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  @media (max-width: 989px) {
    .fl-header__nav,
    .fl-header__account {
      display: none;
    }

    .fl-header__burger {
      display: inline-flex;
    }

    .fl-header__bar {
      gap: 12px;
      min-height: 56px;
    }
  }

  /* Country / language selector (Shopify Markets) */
  .fl-header__loc {
    position: relative;
  }
  .fl-header__loc-toggle {
    list-style: none;
    cursor: pointer;
    gap: 4px;
  }
  .fl-header__loc-toggle::-webkit-details-marker {
    display: none;
  }
  .fl-header__loc-code {
    font-size: 0.6875em;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }
  .fl-header__loc-panel {
    position: absolute;
    top: calc(100% + 8px);
    right: 0;
    z-index: 30;
    display: grid;
    gap: 12px;
    width: min(280px, calc(100vw - var(--page-margin) * 2));
    padding: 16px;
    background: var(--color-bg);
  }
  .fl-header__loc-form {
    display: grid;
    gap: 8px;
  }
  .fl-header__loc-select {
    width: 100%;
  }
{% endstylesheet %}

{% javascript %}
  class FlHeader extends HTMLElement {
    connectedCallback() {
      this.drawer = this.querySelector('[data-menu-drawer]');
      this.burger = this.querySelector('[data-menu-open]');
      this.cartLink = this.querySelector('[data-cart-link]');
      this.cartLive = this.querySelector('[data-cart-live]');
      this.dropdowns = Array.from(this.querySelectorAll('[data-dropdown]'));

      if (this.burger && this.drawer) {
        this.burger.addEventListener('click', () => this.openDrawer());
        this.drawer.addEventListener('click', (event) => {
          if (event.target === this.drawer) this.drawer.close();
        });
        this.drawer.addEventListener('close', () => {
          this.burger.setAttribute('aria-expanded', 'false');
        });
        this.querySelectorAll('[data-menu-close]').forEach((btn) => {
          btn.addEventListener('click', () => this.drawer.close());
        });
      }

      this.dropdowns.forEach((dropdown) => {
        const summary = dropdown.querySelector('summary');
        if (summary) summary.setAttribute('aria-expanded', String(dropdown.open));
        dropdown.addEventListener('toggle', () => {
          if (summary) summary.setAttribute('aria-expanded', String(dropdown.open));
          if (dropdown.open) this.closeDropdowns(dropdown);
        });
        dropdown.addEventListener('focusout', (event) => {
          if (!dropdown.open) return;
          if (event.relatedTarget && !dropdown.contains(event.relatedTarget)) dropdown.open = false;
        });
        dropdown.addEventListener('keydown', (event) => {
          if (event.key === 'Escape' && dropdown.open) {
            event.preventDefault();
            dropdown.open = false;
            if (summary) summary.focus();
          }
        });
      });

      this._onDocClick = (event) => {
        this.dropdowns.forEach((dropdown) => {
          if (dropdown.open && !dropdown.contains(event.target)) dropdown.open = false;
        });
      };
      document.addEventListener('click', this._onDocClick);

      this._onCartChange = (event) => this.updateCartCount(event);
      document.addEventListener('fl:cart:change', this._onCartChange);
    }

    disconnectedCallback() {
      document.removeEventListener('click', this._onDocClick);
      document.removeEventListener('fl:cart:change', this._onCartChange);
    }

    openDrawer() {
      if (typeof this.drawer.showModal === 'function') {
        this.drawer.showModal();
      } else {
        this.drawer.setAttribute('open', '');
      }
      this.burger.setAttribute('aria-expanded', 'true');
    }

    closeDropdowns(except) {
      this.dropdowns.forEach((dropdown) => {
        if (dropdown !== except) dropdown.open = false;
      });
    }

    updateCartCount(event) {
      if (!event.detail || typeof event.detail.itemCount !== 'number') return;
      const count = event.detail.itemCount;
      this.querySelectorAll('[data-cart-count]').forEach((el) => {
        el.textContent = count;
        el.classList.toggle('is-empty', count === 0);
      });
      const template = count === 1 ? this.dataset.cartLabelOne : this.dataset.cartLabelOther;
      if (!template) return;
      const label = template.replace('%COUNT%', count);
      if (this.cartLink) this.cartLink.setAttribute('aria-label', label);
      if (this.cartLive) this.cartLive.textContent = label;
    }
  }

  if (!customElements.get('fl-header')) customElements.define('fl-header', FlHeader);
{% endjavascript %}

{% schema %}
{
  "name": "Header",
  "tag": "header",
  "class": "fl-header-section",
  "settings": [
    {
      "type": "link_list",
      "id": "menu",
      "label": "Menu",
      "default": "main-menu"
    },
    {
      "type": "checkbox",
      "id": "sticky_header",
      "label": "Sticky header",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_search",
      "label": "Show search",
      "default": true
    },
    {
      "type": "header",
      "content": "Country and language"
    },
    {
      "type": "checkbox",
      "id": "show_country_selector",
      "label": "Show country/region selector",
      "info": "Shown when the store sells in more than one country (Shopify Markets).",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "show_language_selector",
      "label": "Show language selector",
      "info": "Shown when the store has more than one published language.",
      "default": false
    }
  ],
  "enabled_on": {
    "groups": [
      "header"
    ]
  }
}
{% endschema %}
