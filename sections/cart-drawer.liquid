{% comment %}
  FLYER — Cart drawer. The global AJAX cart system.
  Rendered statically from theme.liquid when settings.cart_type == 'drawer'.
  - Intercepts submits of [data-quick-add] and [data-product-form] forms.
  - Re-renders itself through the Section Rendering API (?sections=cart-drawer).
  - Dispatches document event 'fl:cart:change' with detail: { itemCount }.
  - [data-cart-open] elements open it; everything degrades to /cart without JS.
  Theme settings: Cart > Colour scheme, Show vendor, Enable order note,
  Collection shown in an empty cart. Drawer border/shadow come from the
  Drawers settings through the shared .fl-drawer class.
{% endcomment %}

{%- liquid
  # Theme setting: Currency format > Show currency codes. Liquid has no dynamic
  # filter name, so the cart total is resolved once here.
  if settings.currency_code_enabled
    assign cart_total = cart.total_price | money_with_currency
  else
    assign cart_total = cart.total_price | money
  endif
-%}

<fl-cart-drawer
  class="fl-cart"
  data-add-url="{{ routes.cart_add_url }}"
  data-change-url="{{ routes.cart_change_url }}"
  data-update-url="{{ routes.cart_update_url }}"
  data-cart-url="{{ routes.cart_url }}"
  data-root-url="{{ routes.root_url }}"
  data-error-text="{{ 'cart.item_error' | t }}"
  data-adding-text="{{ 'products.product.adding' | t }}"
  data-added-text="{{ 'products.product.added_to_cart' | t }}"
>
  <div class="fl-overlay" data-cart-close aria-hidden="true"></div>

  <div
    class="fl-cart__panel fl-drawer color-{{ settings.cart_color_scheme }}"
    role="dialog"
    aria-modal="true"
    {% comment %}
      aria-labelledby points at the title TEXT only, not at the whole <h2>: the
      heading also carries the item count twice (visible badge + spoken count),
      which made the dialog announce itself as "Your cart 4 4 items".
      aria-label is the fallback for the frame in which the Section Rendering
      API has just replaced [data-cart-inner] and the referenced node does not
      exist yet; aria-labelledby wins over it again as soon as it is back. Both
      resolve through the same translation key, so the name is never English on
      a French storefront.
    {% endcomment %}
    aria-labelledby="FlCartDrawerHeading"
    aria-label="{{ 'cart.drawer_title' | t }}"
    tabindex="-1"
    data-cart-panel
  >
    <div class="fl-cart__inner" data-cart-inner>
      <header class="fl-cart__head">
        <h2 class="fl-cart__title">
          <span id="FlCartDrawerHeading">{{ 'cart.drawer_title' | t }}</span>
          <span class="fl-cart__count" aria-hidden="true">{{ cart.item_count }}</span>
          <span class="visually-hidden">{{ 'cart.item_count' | t: count: cart.item_count }}</span>
        </h2>
        <button
          type="button"
          class="fl-cart__close"
          data-cart-close
          aria-label="{{ 'accessibility.close' | t }}"
        >
          <svg width="18" height="18" viewBox="0 0 18 18" fill="none" aria-hidden="true" focusable="false">
            <path d="M3 3l12 12M15 3 3 15" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
          </svg>
        </button>
      </header>

      <div class="fl-cart__body">
        {%- if cart.item_count == 0 -%}
          <div class="fl-cart__empty">
            <p class="fl-cart__empty-text">{{ 'cart.empty' | t }}</p>
            <a href="{{ routes.all_products_collection_url }}" class="fl-btn fl-btn--secondary">
              {{ 'cart.continue_shopping' | t }}
            </a>
          </div>

          {%- comment -%}
            Theme setting: Cart > Collection shown in an empty cart.
          {%- endcomment -%}
          {%- liquid
            assign empty_collection = settings.cart_drawer_collection
            # default: 0 keeps the comparison an integer one when no collection
            # is picked, where products.size is nil.
            assign rec_count = empty_collection.products.size | default: 0
          -%}
          {%- if rec_count > 0 -%}
            <div class="fl-cart__recs">
              <h3 class="fl-eyebrow">{{ empty_collection.title | escape }}</h3>
              <div class="fl-product-grid fl-cart__recs-grid">
                {%- for recommendation in empty_collection.products limit: 4 -%}
                  {% render 'product-card',
                    product: recommendation,
                    show_quick_add: false,
                    heading_level: 'h4',
                    sizes: '(max-width: 480px) 45vw, 180px'
                  %}
                {%- endfor -%}
              </div>
            </div>
          {%- endif -%}
        {%- else -%}
          <ul class="fl-cart__items" role="list">
            {%- for item in cart.items -%}
              {%- liquid
                assign item_title = item.product.title | escape
                if settings.currency_code_enabled
                  assign line_price = item.final_line_price | money_with_currency
                  assign line_compare = item.original_line_price | money_with_currency
                else
                  assign line_price = item.final_line_price | money
                  assign line_compare = item.original_line_price | money
                endif
              -%}
              <li class="fl-cart__item">
                <a class="fl-cart__thumb" href="{{ item.url }}" tabindex="-1" aria-hidden="true">
                  {%- if item.image -%}
                    {{
                      item.image
                      | image_url: width: 144
                      | image_tag: widths: '72, 144', sizes: '72px', loading: 'lazy', alt: ''
                    }}
                  {%- endif -%}
                </a>

                <div class="fl-cart__details">
                  {%- comment -%}Theme setting: Cart > Show vendor.{%- endcomment -%}
                  {%- if settings.cart_show_vendor and item.product.vendor != blank -%}
                    <span class="fl-cart__item-vendor">{{ item.product.vendor | escape }}</span>
                  {%- endif -%}

                  <a class="fl-cart__item-title" href="{{ item.url }}">{{ item_title }}</a>

                  {%- unless item.product.has_only_default_variant -%}
                    <span class="fl-cart__item-options">
                      {%- for option in item.options_with_values -%}
                        {{ option.name | escape }}: {{ option.value | escape }}
                        {%- unless forloop.last %} · {% endunless -%}
                      {%- endfor -%}
                    </span>
                  {%- endunless -%}

                  <span class="fl-cart__item-price">
                    {%- if item.original_line_price != item.final_line_price -%}
                      <s class="fl-cart__item-compare">{{ line_compare }}</s>
                    {%- endif -%}
                    <span>{{ line_price }}</span>
                  </span>

                  <div class="fl-cart__item-row">
                    <div class="fl-cart__qty">
                      <button
                        type="button"
                        class="fl-cart__qty-btn"
                        data-cart-minus
                        data-key="{{ item.key }}"
                        data-qty="{{ item.quantity }}"
                        aria-label="{{ 'products.product.decrease_quantity' | t: title: item_title }}"
                      >
                        <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true" focusable="false">
                          <path d="M2.5 7h9" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
                        </svg>
                      </button>
                      <input
                        class="fl-cart__qty-input"
                        type="number"
                        inputmode="numeric"
                        min="0"
                        value="{{ item.quantity }}"
                        data-cart-qty
                        data-key="{{ item.key }}"
                        aria-label="{{ 'cart.quantity' | t }} — {{ item_title }}"
                      >
                      <button
                        type="button"
                        class="fl-cart__qty-btn"
                        data-cart-plus
                        data-key="{{ item.key }}"
                        data-qty="{{ item.quantity }}"
                        aria-label="{{ 'products.product.increase_quantity' | t: title: item_title }}"
                      >
                        <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true" focusable="false">
                          <path d="M2.5 7h9M7 2.5v9" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
                        </svg>
                      </button>
                    </div>

                    <a
                      class="fl-cart__remove"
                      href="{{ item.url_to_remove }}"
                      data-cart-remove
                      data-key="{{ item.key }}"
                      aria-label="{{ 'cart.remove_title' | t: title: item_title }}"
                    >
                      {{- 'cart.remove' | t -}}
                    </a>
                  </div>
                </div>
              </li>
            {%- endfor -%}
          </ul>
        {%- endif -%}
      </div>

      {%- if cart.item_count > 0 -%}
        <div class="fl-cart__foot">
          <div class="fl-cart__subtotal">
            <span>{{ 'cart.subtotal' | t }}</span>
            <span>{{ cart_total }}</span>
          </div>
          <p class="fl-cart__taxes">{{ 'cart.taxes_note' | t }}</p>

          {% form 'cart', cart, class: 'fl-cart__form' %}
            {%- if settings.cart_show_note -%}
              <details
                class="fl-cart__note"
                {% if cart.note != blank %}
                  open
                {% endif %}
              >
                <summary class="fl-cart__note-toggle">{{ 'cart.note_label' | t }}</summary>
                <textarea
                  class="fl-textarea fl-cart__note-field"
                  name="note"
                  rows="2"
                  placeholder="{{ 'cart.note_placeholder' | t }}"
                  aria-label="{{ 'cart.note_label' | t }}"
                  data-cart-note
                >{{ cart.note | escape }}</textarea>
              </details>
            {%- endif -%}
            <button type="submit" name="checkout" class="fl-btn fl-cart__checkout">
              {{ 'cart.checkout' | t }}
            </button>
          {% endform %}
        </div>
      {%- endif -%}
    </div>

    <p class="fl-cart__status" role="status" aria-live="polite" data-cart-status></p>
  </div>
</fl-cart-drawer>

{% stylesheet %}
  .fl-cart {
    display: block;
  }

  html[data-fl-cart-lock] {
    overflow: hidden;
  }

  .fl-cart.is-open .fl-overlay {
    opacity: 1;
    pointer-events: auto;
  }

  /* Colour, border and shadow come from the cart colour scheme and the shared
     .fl-drawer class, both applied on the panel in the markup. */
  .fl-cart__panel {
    position: fixed;
    top: 0;
    bottom: 0;
    right: 0;
    z-index: 70;
    display: flex;
    flex-direction: column;
    width: min(420px, 100%);
    transform: translateX(100%);
    visibility: hidden;
    transition: transform 0.3s ease, visibility 0s linear 0.3s;
  }

  .fl-cart.is-open .fl-cart__panel {
    transform: none;
    visibility: visible;
    transition: transform 0.3s ease;
  }

  .fl-cart__inner {
    display: flex;
    flex: 1 1 auto;
    flex-direction: column;
    min-height: 0;
  }

  .fl-cart__head {
    display: flex;
    flex: 0 0 auto;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding: 16px 24px;
    border-bottom: 1px solid var(--color-line);
  }

  .fl-cart__title {
    display: flex;
    align-items: baseline;
    gap: 8px;
    font-size: 1.125em;
  }

  .fl-cart__count {
    font-size: 0.8125em;
    font-weight: 400;
    color: var(--color-muted);
  }

  .fl-cart__close {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex: 0 0 auto;
    width: 44px;
    height: 44px;
    margin-right: -12px;
    padding: 0;
    background: none;
    border: 0;
    border-radius: var(--radius-btn);
    color: var(--color-ink);
    cursor: pointer;
    transition: color 0.15s ease;
  }

  .fl-cart__close:hover {
    color: var(--color-muted);
  }

  .fl-cart__body {
    flex: 1 1 auto;
    min-height: 0;
    padding: 24px;
    overflow-y: auto;
  }

  /* Very short viewports (300-400% browser zoom, landscape phones): the footer
     does not shrink, so Checkout was pushed below the fold with nothing to
     scroll. The whole panel scrolls here instead of just the item list. */
  @media (max-height: 520px) {
    .fl-cart__inner {
      overflow-y: auto;
      overscroll-behavior: contain;
    }

    .fl-cart__body {
      overflow: visible;
    }
  }

  .fl-cart__empty {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 20px;
    padding: 40px 0;
    text-align: center;
  }

  .fl-cart__empty-text {
    color: var(--color-muted);
  }

  .fl-cart__recs {
    padding-top: 24px;
    border-top: 1px solid var(--color-line);
  }

  /* The drawer is 420px wide whatever the viewport, so the shared grid is
     pinned to two columns instead of following the page breakpoints. The
     compound selector outranks .fl-product-grid’s own media queries. */
  .fl-cart__recs-grid.fl-product-grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 20px 12px;
  }

  .fl-cart__items {
    display: flex;
    flex-direction: column;
    gap: 24px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .fl-cart__item {
    display: flex;
    gap: 16px;
  }

  .fl-cart__thumb {
    flex: 0 0 72px;
    width: 72px;
    aspect-ratio: var(--card-ratio);
    overflow: hidden;
    border-radius: var(--radius-card);
    background: var(--color-surface);
  }

  .fl-cart__thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .fl-cart__details {
    display: flex;
    flex: 1 1 auto;
    flex-direction: column;
    gap: 4px;
    min-width: 0;
  }

  .fl-cart__item-title {
    font-size: 0.9375em;
    font-weight: 500;
    text-decoration: none;
  }

  .fl-cart__item-title:hover {
    text-decoration: underline;
  }

  .fl-cart__item-vendor {
    font-size: 0.75em;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-muted);
  }

  .fl-cart__item-options {
    font-size: 0.8125em;
    color: var(--color-muted);
  }

  .fl-cart__item-price {
    display: flex;
    align-items: baseline;
    gap: 8px;
    font-size: 0.9375em;
  }

  .fl-cart__item-compare {
    color: var(--color-muted);
  }

  .fl-cart__item-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    margin-top: 8px;
  }

  .fl-cart__qty {
    display: inline-flex;
    align-items: center;
    border: 1px solid var(--color-control-border);
    border-radius: var(--radius-btn);
  }

  .fl-cart__qty-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    padding: 0;
    background: none;
    border: 0;
    color: var(--color-ink);
    cursor: pointer;
    transition: color 0.15s ease;
  }

  .fl-cart__qty-btn:hover {
    color: var(--color-muted);
  }

  .fl-cart__qty-input {
    width: 40px;
    height: 44px;
    padding: 0;
    text-align: center;
    background: transparent;
    border: 0;
    color: var(--color-ink);
    appearance: textfield;
  }

  .fl-cart__qty-input::-webkit-outer-spin-button,
  .fl-cart__qty-input::-webkit-inner-spin-button {
    margin: 0;
    appearance: none;
  }

  .fl-cart__remove {
    display: inline-flex;
    align-items: center;
    /* 44px minimum touch target, absorbed by negative margin so the visual
       rhythm is unchanged. */
    min-height: 44px;
    padding-block: 0;
    margin-block: -12px;
    font-size: 0.8125em;
    color: var(--color-muted);
    transition: color 0.15s ease;
  }

  .fl-cart__remove:hover {
    color: var(--color-ink);
  }

  .fl-cart__foot {
    display: flex;
    flex: 0 0 auto;
    flex-direction: column;
    gap: 12px;
    padding: 16px 24px 20px;
    border-top: 1px solid var(--color-line);
  }

  .fl-cart__subtotal {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 12px;
    font-weight: 600;
  }

  .fl-cart__taxes {
    margin: 0;
    font-size: 0.8125em;
    color: var(--color-muted);
  }

  .fl-cart__form {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .fl-cart__note-toggle {
    display: flex;
    align-items: center;
    min-height: 44px;
    font-size: 0.875em;
    color: var(--color-muted);
    cursor: pointer;
  }

  .fl-cart__note[open] .fl-cart__note-toggle {
    color: var(--color-ink);
  }

  .fl-cart__note-field {
    margin-top: 4px;
  }

  .fl-cart__checkout {
    width: 100%;
  }

  .fl-cart__status {
    margin: 12px 24px 16px;
    padding: 12px 14px;
    border: 1px solid currentcolor;
    border-radius: var(--radius-input);
    background: var(--color-surface);
    font-size: 0.875em;
  }

  .fl-cart__status:empty {
    display: none;
  }

  /* Errors keep the same neutral surface as the confirmation — the wording
     carries the meaning — but sit on the scheme's ink rather than the muted
     border, so the two states are still distinguishable without colour alone.
     Both use --color-ink on --color-surface, which every shipped scheme keeps
     above 4.5:1. */
  .fl-cart__status--error {
    border-width: 2px;
    font-weight: 500;
  }

  .fl-cart.is-busy .fl-cart__body,
  .fl-cart.is-busy .fl-cart__foot {
    opacity: 0.6;
    pointer-events: none;
    transition: opacity 0.15s ease;
  }

  @media (prefers-reduced-motion: reduce) {
    .fl-cart__panel,
    .fl-cart.is-open .fl-cart__panel {
      transition: none;
    }
  }
{% endstylesheet %}

{% javascript %}
  class FlCartDrawer extends HTMLElement {
    connectedCallback() {
      this.sectionId = 'cart-drawer';
      this.panel = this.querySelector('[data-cart-panel]');
      this.statusEl = this.querySelector('[data-cart-status]');
      this.openerEl = null;
      this.isBusy = false;

      this.onDocClick = this.handleDocClick.bind(this);
      this.onDocSubmit = this.handleDocSubmit.bind(this);
      this.onKeydown = this.handleKeydown.bind(this);
      this.onFieldChange = this.handleFieldChange.bind(this);
      this.onFocusIn = this.handleFocusIn.bind(this);

      document.addEventListener('click', this.onDocClick);
      document.addEventListener('submit', this.onDocSubmit);
      // Last line of defence for the focus trap: whatever moves focus out of an
      // open drawer — a Tab the page swallowed, a script, the cookie-consent
      // banner Shopify injects at the top of <body> — it comes straight back.
      document.addEventListener('focusin', this.onFocusIn, true);
      // Escape / Tab are bound on the document, not on the element: after a
      // re-render the browser can park focus on <body>, and a listener scoped
      // to the drawer would then never see the key.
      // Capture phase: a third-party widget (consent banner, app embed) that
      // stops propagation on keydown must not be able to disarm the trap.
      document.addEventListener('keydown', this.onKeydown, true);
      this.addEventListener('change', this.onFieldChange);

      if (window.Shopify && window.Shopify.designMode) {
        this.onSectionSelect = (event) => {
          if (event.target.contains(this)) this.open();
        };
        this.onSectionDeselect = (event) => {
          if (event.target.contains(this)) this.close();
        };
        document.addEventListener('shopify:section:select', this.onSectionSelect);
        document.addEventListener('shopify:section:deselect', this.onSectionDeselect);
      }
    }

    disconnectedCallback() {
      document.removeEventListener('click', this.onDocClick);
      document.removeEventListener('submit', this.onDocSubmit);
      document.removeEventListener('keydown', this.onKeydown, true);
      document.removeEventListener('focusin', this.onFocusIn, true);
      if (this.onSectionSelect) {
        document.removeEventListener('shopify:section:select', this.onSectionSelect);
        document.removeEventListener('shopify:section:deselect', this.onSectionDeselect);
      }
      document.documentElement.removeAttribute('data-fl-cart-lock');
      if (this.focusTimer) window.clearTimeout(this.focusTimer);
      if (this.statusTimer) window.clearTimeout(this.statusTimer);
    }

    handleDocClick(event) {
      const opener = event.target.closest('[data-cart-open]');
      if (opener) {
        event.preventDefault();
        this.open(opener);
        return;
      }
      if (!this.contains(event.target)) return;
      if (event.target.closest('[data-cart-close]')) {
        this.close();
        return;
      }
      const control = event.target.closest('[data-cart-minus], [data-cart-plus], [data-cart-remove]');
      if (!control) return;
      event.preventDefault();
      const key = control.getAttribute('data-key');
      if (!key) return;
      const current = parseInt(control.getAttribute('data-qty'), 10) || 0;
      let quantity = 0;
      if (control.hasAttribute('data-cart-minus')) quantity = Math.max(0, current - 1);
      if (control.hasAttribute('data-cart-plus')) quantity = current + 1;
      this.changeLine(key, quantity);
    }

    handleDocSubmit(event) {
      const form = event.target.closest('[data-quick-add], [data-product-form]');
      if (!form) return;
      // While a previous add is still in flight, let the browser submit natively
      // instead of swallowing the event: preventing it and then bailing on the
      // isBusy guard lost the second add entirely on a fast double click.
      if (this.isBusy) return;
      event.preventDefault();
      this.addToCart(form, event.submitter);
    }

    handleFieldChange(event) {
      const qty = event.target.closest('[data-cart-qty]');
      if (qty) {
        const value = Math.max(0, parseInt(qty.value, 10) || 0);
        this.changeLine(qty.getAttribute('data-key'), value);
        return;
      }
      const note = event.target.closest('[data-cart-note]');
      if (note) this.saveNote(note.value);
    }

    handleKeydown(event) {
      if (!this.classList.contains('is-open') || !this.panel) return;
      if (event.key === 'Escape' || event.key === 'Esc') {
        event.preventDefault();
        event.stopPropagation();
        this.close();
        return;
      }
      if (event.key !== 'Tab') return;
      const focusable = this.getFocusable();
      if (focusable.length === 0) {
        event.preventDefault();
        this.panel.focus();
        return;
      }
      const first = focusable[0];
      const last = focusable[focusable.length - 1];
      const active = document.activeElement;
      // Anything that is not one of the panel's own focusable controls — the
      // bare panel (tabindex="-1"), the scrim, <body> after a re-render, or an
      // element the page moved focus to — is treated as "outside": the next Tab
      // is redirected to an end of the ring instead of walking the document.
      const index = focusable.indexOf(active);
      if (index === -1) {
        event.preventDefault();
        (event.shiftKey ? last : first).focus();
        return;
      }
      if (event.shiftKey) {
        if (index === 0) {
          event.preventDefault();
          last.focus();
        }
        return;
      }
      if (index === focusable.length - 1) {
        event.preventDefault();
        first.focus();
      }
    }

    handleFocusIn(event) {
      if (!this.classList.contains('is-open')) return;
      if (this.isRestoringFocus) return;
      if (!this.panel) return;
      const target = event.target;
      if (target === this.panel || this.panel.contains(target)) return;
      this.isRestoringFocus = true;
      const focusable = this.getFocusable();
      const fallback = focusable[0] || this.panel;
      if (fallback) fallback.focus();
      this.isRestoringFocus = false;
    }

    getFocusable() {
      const selector =
        'a[href], button:not([disabled]), input:not([disabled]), textarea:not([disabled]), select:not([disabled]), summary, [tabindex]:not([tabindex="-1"])';
      const nodes = Array.prototype.slice.call(this.panel.querySelectorAll(selector));
      const candidates = nodes.filter((el) => {
        if (el.hasAttribute('aria-hidden') || el.closest('[aria-hidden="true"], [hidden]')) return false;
        return true;
      });
      const visible = candidates.filter((el) => {
        return el.offsetWidth > 0 || el.offsetHeight > 0 || el === document.activeElement;
      });
      // While the panel is still sliding in, offset sizes can read 0 for every
      // control. Falling back to the unmeasured list keeps the trap armed on
      // the very first Tab instead of collapsing to "no focusable element".
      return visible.length > 0 ? visible : candidates;
    }

    focusPanel() {
      // Move focus to the first control the shopper can actually act on —
      // never the scrim, never the bare panel — on EVERY opening path (click,
      // Enter on the cart link, automatic open after an add to cart).
      // The panel is visibility:hidden until the open class has been painted,
      // and a freshly re-rendered panel can take a frame more, so the attempt
      // is repeated across frames AND timers until focus really landed inside.
      if (this.focusTimer) {
        window.clearTimeout(this.focusTimer);
        this.focusTimer = null;
      }
      const delays = [0, 0, 16, 50, 120, 250, 400];
      let step = 0;
      // Focus resting on the bare panel does NOT count as done: that is exactly
      // the state where the first Tab used to walk out of the drawer.
      const landed = () => {
        const active = document.activeElement;
        return !!active && active !== this.panel && this.panel.contains(active);
      };
      const attempt = () => {
        this.focusTimer = null;
        if (!this.classList.contains('is-open') || !this.panel) return;
        if (landed()) return;
        const focusable = this.getFocusable();
        const target = focusable[0] || this.panel;
        try {
          target.focus({ preventScroll: true });
        } catch (error) {
          target.focus();
        }
        if (landed() || target === this.panel) return;
        if (step < delays.length) {
          const delay = delays[step];
          step += 1;
          if (delay === 0) {
            window.requestAnimationFrame(attempt);
          } else {
            this.focusTimer = window.setTimeout(attempt, delay);
          }
        }
      };
      attempt();
    }

    open(trigger) {
      // Re-entrant on purpose: an add to cart re-renders the panel while it is
      // already open, and focus must be (re)placed inside it on every path —
      // click, keyboard, cart link, automatic open after an add.
      if (trigger) this.openerEl = trigger;
      const wasOpen = this.classList.contains('is-open');
      // Already open with focus on one of its controls (quantity change, note
      // field): leave the caret where the shopper put it. Focus resting on the
      // bare panel is NOT "inside" for this purpose — it has to be moved on to
      // a real control, otherwise the first Tab walks out of the drawer.
      const active = document.activeElement;
      const focusHeld =
        wasOpen && this.panel && active && active !== this.panel && this.panel.contains(active);
      if (focusHeld) return;
      if (!wasOpen) {
        if (!this.openerEl) this.openerEl = document.activeElement;
        this.classList.add('is-open');
        document.documentElement.setAttribute('data-fl-cart-lock', '');
      }
      this.focusPanel();
    }

    close() {
      if (!this.classList.contains('is-open')) return;
      if (this.focusTimer) {
        window.clearTimeout(this.focusTimer);
        this.focusTimer = null;
      }
      this.classList.remove('is-open');
      document.documentElement.removeAttribute('data-fl-cart-lock');
      if (this.openerEl && document.contains(this.openerEl) && typeof this.openerEl.focus === 'function') {
        this.openerEl.focus();
      }
      this.openerEl = null;
    }

    findLabelTextNode(button) {
      // First non-blank text node of a button: the visible wording of the
      // quick-add buttons. Text.textContent reads and writes like an element's.
      for (const node of button.childNodes) {
        if (node.nodeType === Node.TEXT_NODE && node.textContent.trim() !== '') return node;
      }
      return null;
    }

    setLoading(button) {
      if (!button) return function () {};
      // Only the label's text is swapped. Overwriting the button's innerHTML
      // detached the [data-add-label] node that <fl-product> holds a reference
      // to, so the product button stayed stuck on "Adding…" after the first add.
      // Quick-add buttons have no [data-add-label]: their visible wording is a
      // bare text node beside a visually-hidden product name, and writing
      // textContent on the whole button flattened that span into visible text
      // on restore. Swapping only the text node leaves the span untouched.
      const label = button.querySelector('[data-add-label]') || this.findLabelTextNode(button) || button;
      const addingText = this.dataset.addingText;
      const addedText = this.dataset.addedText;
      // A confirmation from a previous add may still be on screen: cancel its
      // pending revert and reuse the wording it captured, otherwise "Added to
      // cart" would be recorded as this button's original label.
      window.clearTimeout(button.flRevertTimer);
      let original = label.textContent;
      if (typeof button.flOriginalLabel === 'string') original = button.flOriginalLabel;
      // <fl-product>'s form-level submit listener runs before this document-
      // level one and has already relabelled the button "Adding…": recover the
      // real wording from the host element instead of recording the loading
      // text, which kept a FAILED add reading "Adding…" until <fl-product>'s
      // 8 s fallback timer finally reset it.
      if (original === addingText) {
        const host = button.closest('[data-text-add]');
        if (host && host.dataset.textAdd) original = host.dataset.textAdd;
      }
      button.flOriginalLabel = original;
      button.disabled = true;
      button.setAttribute('aria-busy', 'true');
      label.textContent = addingText;
      // The button is freed as soon as the request settles, but the label only
      // goes back to its original wording after the confirmation has had time
      // on screen: restoring it in the same tick as the add succeeded painted
      // over "Added to cart" before it was ever visible.
      return function (added) {
        button.disabled = false;
        button.removeAttribute('aria-busy');
        if (!added) {
          if (label.textContent === addingText) label.textContent = original;
          button.flOriginalLabel = null;
          return;
        }
        label.textContent = addedText;
        button.flRevertTimer = window.setTimeout(function () {
          // <fl-product> relabels the same button on fl:cart:change and on
          // variant changes, so only take back a label that is still ours.
          if (label.textContent === addedText) label.textContent = original;
          button.flOriginalLabel = null;
        }, 2000);
      };
    }

    async addToCart(form, submitter) {
      if (this.isBusy) return;
      this.isBusy = true;
      const button = submitter || form.querySelector('[type="submit"]');
      const restore = this.setLoading(button);
      const body = new FormData(form);
      // Quick-add forms carry the variant id on the submit button itself
      // (name="id"), and FormData(form) never includes the submitter. Rely on
      // the resolved fallback so script-triggered submits and browsers without
      // SubmitEvent.submitter still post the id.
      if (button && button.name) body.append(button.name, button.value);
      let added = false;
      try {
        const response = await fetch(this.dataset.addUrl, {
          method: 'POST',
          headers: { Accept: 'application/javascript', 'X-Requested-With': 'XMLHttpRequest' },
          body: body
        });
        if (!response.ok) {
          let message = this.dataset.errorText;
          try {
            const data = await response.json();
            if (data && data.description) message = data.description;
          } catch (error) {
            // keep the generic fallback message
          }
          this.showError(message);
          this.open(button);
          return;
        }
        this.clearError();
        await this.refresh();
        added = true;
        this.open(button);
        // Announced AFTER refresh(): renderContents() replaces the drawer's
        // contents and can move focus, and an announcement written before that
        // was swallowed. The wording comes from products.product.added_to_cart
        // through data-added-text, so it follows the storefront locale.
        this.announce(this.dataset.addedText, false);
      } catch (error) {
        this.showError(this.dataset.errorText);
        this.open(button);
      } finally {
        restore(added);
        this.isBusy = false;
      }
    }

    async changeLine(key, quantity) {
      if (this.isBusy || !key) return;
      this.isBusy = true;
      this.classList.add('is-busy');
      try {
        const response = await fetch(this.dataset.changeUrl, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
          body: JSON.stringify({ id: key, quantity: quantity })
        });
        if (response.ok) {
          this.clearError();
        } else {
          let message = this.dataset.errorText;
          try {
            const data = await response.json();
            if (data && data.description) message = data.description;
          } catch (error) {
            // keep the generic fallback message
          }
          this.showError(message);
        }
        await this.refresh();
      } catch (error) {
        this.showError(this.dataset.errorText);
      } finally {
        this.classList.remove('is-busy');
        this.isBusy = false;
      }
    }

    async saveNote(note) {
      try {
        await fetch(this.dataset.updateUrl, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
          body: JSON.stringify({ note: note })
        });
      } catch (error) {
        // note saving is best effort
      }
    }

    async refresh() {
      const sectionUrl = this.dataset.rootUrl + '?sections=' + this.sectionId;
      const cartUrl = this.dataset.cartUrl + '.js';
      const results = await Promise.all([
        fetch(sectionUrl).then((response) => response.json()),
        fetch(cartUrl, { headers: { Accept: 'application/json' } }).then((response) => response.json())
      ]);
      const sections = results[0];
      const cart = results[1];
      if (sections && sections[this.sectionId]) this.renderContents(sections[this.sectionId]);
      let itemCount = 0;
      if (cart && typeof cart.item_count === 'number') itemCount = cart.item_count;
      document.dispatchEvent(
        new CustomEvent('fl:cart:change', { bubbles: true, detail: { itemCount: itemCount } })
      );
    }

    renderContents(html) {
      const doc = new DOMParser().parseFromString(html, 'text/html');
      const fresh = doc.querySelector('[data-cart-inner]');
      const current = this.querySelector('[data-cart-inner]');
      if (!fresh || !current) return;
      const active = document.activeElement;
      const hadFocus = this.contains(active);
      let focusSelector = null;
      if (hadFocus && active.hasAttribute('data-key')) {
        const kinds = ['data-cart-minus', 'data-cart-plus', 'data-cart-qty', 'data-cart-remove'];
        for (const kind of kinds) {
          if (active.hasAttribute(kind)) {
            focusSelector = '[' + kind + '][data-key="' + active.getAttribute('data-key') + '"]';
            break;
          }
        }
      }
      current.innerHTML = fresh.innerHTML;
      if (!hadFocus || !this.classList.contains('is-open')) return;
      let target = null;
      if (focusSelector) target = this.querySelector(focusSelector);
      if (target) {
        target.focus();
        return;
      }
      // The control that had focus is gone (line removed, cart emptied):
      // re-arm the trap on the first focusable control rather than leaving
      // focus on <body>, where the next Tab would walk out of the drawer.
      this.focusPanel();
    }

    // The live region is re-read on every use instead of being trusted from
    // connectedCallback: it sits outside [data-cart-inner] today, but a stale
    // reference is exactly how an announcement ends up written to a detached
    // node and the region stays empty for the screen reader.
    liveRegion() {
      if (!this.statusEl || !this.contains(this.statusEl)) {
        this.statusEl = this.querySelector('[data-cart-status]');
      }
      return this.statusEl;
    }

    // Clear-then-set: assistive technology only announces a CHANGE inside a
    // live region, so writing the same wording twice in a row (two adds of the
    // same product) is silent unless the region is emptied first.
    announce(message, isError) {
      const region = this.liveRegion();
      if (!region || !message) return;
      window.clearTimeout(this.statusTimer);
      region.textContent = '';
      region.classList.toggle('fl-cart__status--error', isError === true);
      // Written from BOTH a frame callback and a timer, whichever lands first:
      // requestAnimationFrame alone is throttled to a standstill in a hidden or
      // backgrounded tab, which left the region measurably empty for a full
      // second after an add — long enough for the shopper to hear nothing.
      const write = () => {
        if (region.textContent === message) return;
        region.textContent = message;
        // An error stays on screen until the next cart action resolves it; a
        // confirmation is transient and takes itself back down.
        if (isError) return;
        window.clearTimeout(this.statusTimer);
        this.statusTimer = window.setTimeout(() => {
          if (region.textContent === message) region.textContent = '';
        }, 5000);
      };
      window.requestAnimationFrame(write);
      window.setTimeout(write, 50);
    }

    showError(message) {
      this.announce(message || this.dataset.errorText, true);
    }

    clearError() {
      const region = this.liveRegion();
      if (!region) return;
      if (!region.classList.contains('fl-cart__status--error')) return;
      window.clearTimeout(this.statusTimer);
      region.classList.remove('fl-cart__status--error');
      region.textContent = '';
    }
  }

  if (!customElements.get('fl-cart-drawer')) {
    customElements.define('fl-cart-drawer', FlCartDrawer);
  }
{% endjavascript %}

