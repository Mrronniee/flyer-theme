<section
  class="fl-richtext full-width color-{{ section.settings.color_scheme }}"
  {% render 'reveal' %}
  style="padding-block: {{ section.settings.padding_top }}px {{ section.settings.padding_bottom }}px;"
>
  <div class="fl-richtext__inner">
    {%- for block in section.blocks -%}
      {%- case block.type -%}
        {%- when 'eyebrow' -%}
          {%- if block.settings.text != blank -%}
            <span class="fl-eyebrow" {{ block.shopify_attributes }}>{{ block.settings.text | escape }}</span>
          {%- endif -%}

        {%- when 'heading' -%}
          {%- if block.settings.heading != blank -%}
            <h2 class="fl-richtext__heading" {{ block.shopify_attributes }}>{{ block.settings.heading | escape }}</h2>
          {%- endif -%}

        {%- when 'text' -%}
          {%- if block.settings.text != blank -%}
            <div class="fl-richtext__text" {{ block.shopify_attributes }}>{{ block.settings.text }}</div>
          {%- endif -%}

        {%- when 'button' -%}
          {%- if block.settings.label != blank and block.settings.link != blank -%}
            <div class="fl-richtext__cta" {{ block.shopify_attributes }}>
              <a
                class="fl-btn{% if block.settings.style == 'secondary' %} fl-btn--secondary{% endif %}"
                href="{{ block.settings.link }}"
              >{{ block.settings.label | escape }}</a>
            </div>
          {%- endif -%}
      {%- endcase -%}
    {%- endfor -%}
  </div>
</section>

{% stylesheet %}
  .fl-richtext__inner {
    width: min(720px, calc(100% - var(--page-margin) * 2));
    margin-inline: auto;
    text-align: center;
  }

  .fl-richtext__heading {
    margin-bottom: 16px;
  }

  .fl-richtext__text > p + p {
    margin-top: 1em;
  }

  .fl-richtext__cta {
    margin-top: 28px;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:names.rich_text",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:labels.color_scheme",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "t:content.spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "t:labels.top_padding",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "t:labels.bottom_padding",
      "default": 48
    }
  ],
  "blocks": [
    {
      "type": "eyebrow",
      "name": "t:names.eyebrow",
      "limit": 1,
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "t:labels.eyebrow",
          "default": "Our story"
        }
      ]
    },
    {
      "type": "heading",
      "name": "t:names.heading",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "t:labels.heading",
          "default": "Talk about your brand"
        }
      ]
    },
    {
      "type": "text",
      "name": "t:names.text",
      "settings": [
        {
          "type": "richtext",
          "id": "text",
          "label": "t:labels.text",
          "default": "<p>Share information about your brand with your customers. Describe a product, make announcements, or welcome customers to your store.</p>"
        }
      ]
    },
    {
      "type": "button",
      "name": "t:names.button",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "t:labels.button_label",
          "default": "Learn more"
        },
        {
          "type": "url",
          "id": "link",
          "label": "t:labels.button_link"
        },
        {
          "type": "select",
          "id": "style",
          "label": "t:labels.button_style",
          "options": [
            {
              "value": "primary",
              "label": "t:labels.primary"
            },
            {
              "value": "secondary",
              "label": "t:labels.secondary"
            }
          ],
          "default": "primary"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:names.rich_text",
      "blocks": [
        {
          "type": "heading"
        },
        {
          "type": "text"
        },
        {
          "type": "button"
        }
      ]
    }
  ]
}
{% endschema %}
