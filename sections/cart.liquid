{% comment %}
  FLYER — Cart page (/cart template).
  Native {% form 'cart' %}: quantity inputs (updates[]) + Update button work
  with zero JS. The <fl-cart-page> element adds +/- stepper buttons and updates
  the cart in place (Ajax Cart API + Section Rendering API), keeping focus.
  Line-level and cart-level discounts are displayed when present.
{% endcomment %}

{%- liquid
  # Theme setting: Currency format > Show currency codes. Liquid has no dynamic
  # filter name, so every amount on this page is resolved through an if, the
  # same way the cart drawer does it.
  if settings.currency_code_enabled
    assign cart_total = cart.total_price | money_with_currency
  else
    assign cart_total = cart.total_price | money
  endif
-%}

<fl-cart-page
  class="fl-cart-page"
  data-section-id="{{ section.id }}"
  data-update-url="{{ routes.cart_update_url }}"
  data-cart-url="{{ routes.cart_url }}"
  data-error-text="{{ 'cart.item_error' | t }}"
>
  {%- comment -%}
    With JS, a quantity change updates the cart in place: this wrapper is
    re-rendered through the Section Rendering API and focus returns to the
    same control. The live region below stays outside it, so it is never
    replaced while it speaks.
  {%- endcomment -%}
  <div class="fl-cart-page__inner" data-cart-page-inner>
  <header class="fl-cart-page__head">
    <h1 class="fl-cart-page__title" tabindex="-1">{{ 'cart.title' | t }}</h1>
    {%- if cart.item_count > 0 -%}
      <p class="fl-cart-page__count">{{ 'cart.item_count' | t: count: cart.item_count }}</p>
    {%- endif -%}
  </header>

  {%- if cart.item_count == 0 -%}
    <div class="fl-cart-page__empty">
      <p class="fl-cart-page__empty-text">{{ 'cart.empty' | t }}</p>
      <a href="{{ routes.all_products_collection_url }}" class="fl-btn">
        {{ 'cart.continue_shopping' | t }}
      </a>
    </div>
  {%- else -%}
    {% form 'cart', cart, class: 'fl-cart-page__form' %}
      <div class="fl-cart-page__main">
        <ul class="fl-cart-page__items" role="list">
          {%- for item in cart.items -%}
            {%- liquid
              assign item_title = item.product.title | escape
              if settings.currency_code_enabled
                assign unit_compare = item.original_price | money_with_currency
                assign unit_price = item.final_price | money_with_currency
                assign unit_measure = item.unit_price | money_with_currency
                assign line_compare = item.original_line_price | money_with_currency
                assign line_price = item.final_line_price | money_with_currency
              else
                assign unit_compare = item.original_price | money
                assign unit_price = item.final_price | money
                assign unit_measure = item.unit_price | money
                assign line_compare = item.original_line_price | money
                assign line_price = item.final_line_price | money
              endif
            -%}
            <li class="fl-cart-page__item" data-line-key="{{ item.key }}">
              <a class="fl-cart-page__thumb" href="{{ item.url }}" tabindex="-1" aria-hidden="true">
                {%- if item.image -%}
                  {{
                    item.image
                    | image_url: width: 192
                    | image_tag: widths: '96, 192', sizes: '96px', loading: 'lazy', alt: ''
                  }}
                {%- endif -%}
              </a>

              <div class="fl-cart-page__info">
                <a class="fl-cart-page__item-title" href="{{ item.url }}">{{ item_title }}</a>

                {%- unless item.product.has_only_default_variant -%}
                  <span class="fl-cart-page__item-options">
                    {%- for option in item.options_with_values -%}
                      {{ option.name | escape }}{{ 'general.colon' | t }} {{ option.value | escape }}
                      {%- unless forloop.last %} · {% endunless -%}
                    {%- endfor -%}
                  </span>
                {%- endunless -%}

                <span class="fl-cart-page__unit-price">
                  {%- if item.original_price != item.final_price -%}
                    <s class="fl-cart-page__compare">
                      <span class="visually-hidden">{{ 'products.card.regular_price' | t }}</span>
                      {{- unit_compare -}}
                    </s>
                  {%- endif -%}
                  <span>{{ unit_price }}</span>
                </span>

                {%- if item.unit_price_measurement -%}
                  <span class="fl-cart-page__unit-measure">
                    {{ unit_measure }}
                    /
                    {%- if item.unit_price_measurement.reference_value != 1 -%}
                      {{ item.unit_price_measurement.reference_value }}
                    {%- endif -%}
                    {{ item.unit_price_measurement.reference_unit }}
                  </span>
                {%- endif -%}

                {%- if item.line_level_discount_allocations.size > 0 -%}
                  <ul class="fl-cart-page__discounts" role="list">
                    {%- for allocation in item.line_level_discount_allocations -%}
                      {%- liquid
                        if settings.currency_code_enabled
                          assign allocation_amount = allocation.amount | money_with_currency
                        else
                          assign allocation_amount = allocation.amount | money
                        endif
                      -%}
                      <li class="fl-cart-page__discount">
                        <span class="visually-hidden">{{ 'cart.discount' | t }}{{ 'general.colon' | t }} </span>
                        {{- allocation.discount_application.title | escape }}
                        (−{{ allocation_amount }})
                      </li>
                    {%- endfor -%}
                  </ul>
                {%- endif -%}
              </div>

              <div class="fl-cart-page__controls">
                <div class="fl-cart-page__qty" data-qty-wrap>
                  <button
                    type="button"
                    class="fl-cart-page__qty-btn"
                    data-qty-minus
                    aria-label="{{ 'products.product.decrease_quantity' | t: title: item_title }}"
                  >
                    <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true" focusable="false">
                      <path d="M2.5 7h9" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
                    </svg>
                  </button>
                  <label class="visually-hidden" for="FlCartQty-{{ section.id }}-{{ forloop.index }}">
                    {{- 'cart.quantity' | t }} — {{ item_title -}}
                  </label>
                  <input
                    id="FlCartQty-{{ section.id }}-{{ forloop.index }}"
                    class="fl-cart-page__qty-input"
                    type="number"
                    inputmode="numeric"
                    min="0"
                    name="updates[]"
                    value="{{ item.quantity }}"
                    data-qty-input
                  >
                  <button
                    type="button"
                    class="fl-cart-page__qty-btn"
                    data-qty-plus
                    aria-label="{{ 'products.product.increase_quantity' | t: title: item_title }}"
                  >
                    <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true" focusable="false">
                      <path d="M2.5 7h9M7 2.5v9" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
                    </svg>
                  </button>
                </div>

                <a
                  class="fl-cart-page__remove"
                  href="{{ item.url_to_remove }}"
                  data-qty-remove
                  aria-label="{{ 'cart.remove_title' | t: title: item_title }}"
                >
                  {{- 'cart.remove' | t -}}
                </a>
              </div>

              <div class="fl-cart-page__line-price">
                {%- if item.original_line_price != item.final_line_price -%}
                  <s class="fl-cart-page__compare">
                    <span class="visually-hidden">{{ 'products.card.regular_price' | t }}</span>
                    {{- line_compare -}}
                  </s>
                {%- endif -%}
                <span>{{ line_price }}</span>
              </div>
            </li>
          {%- endfor -%}
        </ul>

        {%- if settings.cart_show_note -%}
          <div class="fl-cart-page__note">
            <label class="fl-label" for="FlCartNote-{{ section.id }}">{{ 'cart.note_label' | t }}</label>
            <textarea
              id="FlCartNote-{{ section.id }}"
              class="fl-textarea"
              name="note"
              rows="3"
              placeholder="{{ 'cart.note_placeholder' | t }}"
            >{{ cart.note | escape }}</textarea>
          </div>
        {%- endif -%}
      </div>

      <aside class="fl-cart-page__summary">
        {%- if cart.cart_level_discount_applications.size > 0 -%}
          <ul class="fl-cart-page__discount-rows" role="list">
            {%- for application in cart.cart_level_discount_applications -%}
              {%- liquid
                if settings.currency_code_enabled
                  assign discount_amount = application.total_allocated_amount | money_with_currency
                else
                  assign discount_amount = application.total_allocated_amount | money
                endif
              -%}
              <li class="fl-cart-page__discount-row">
                <span>
                  <span class="visually-hidden">{{ 'cart.discount' | t }}{{ 'general.colon' | t }} </span>
                  {{- application.title | escape -}}
                </span>
                <span>−{{ discount_amount }}</span>
              </li>
            {%- endfor -%}
          </ul>
        {%- endif -%}

        <div class="fl-cart-page__subtotal">
          <span>{{ 'cart.subtotal' | t }}</span>
          <span>{{ cart_total }}</span>
        </div>

        <p class="fl-cart-page__taxes">
          {%- if cart.taxes_included -%}
            {{ 'cart.taxes_included_note' | t }}
          {%- else -%}
            {{ 'cart.taxes_note' | t }}
          {%- endif -%}
        </p>

        <button type="submit" name="update" class="fl-btn fl-btn--secondary fl-cart-page__update">
          {{ 'cart.update' | t }}
        </button>

        <button type="submit" name="checkout" class="fl-btn fl-cart-page__checkout">
          {{ 'cart.checkout' | t }}
        </button>

        <a class="fl-cart-page__continue" href="{{ routes.all_products_collection_url }}">
          {{ 'cart.continue_shopping' | t }}
        </a>

        <p class="fl-cart-page__status" data-cart-page-status></p>
      </aside>
    {% endform %}
  {%- endif -%}
  </div>
  <p class="visually-hidden" role="status" aria-live="polite" data-cart-page-live></p>
</fl-cart-page>

{% stylesheet %}
  .fl-cart-page {
    display: block;
    padding-block: 48px 80px;
  }

  .fl-cart-page__head {
    display: flex;
    align-items: baseline;
    gap: 12px;
    margin-bottom: 32px;
  }

  .fl-cart-page__count {
    color: var(--color-muted);
  }

  .fl-cart-page__empty {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 20px;
    padding: 56px 0 64px;
    text-align: center;
  }

  .fl-cart-page__empty-text {
    color: var(--color-muted);
  }

  .fl-cart-page__form {
    display: grid;
    gap: 40px;
    align-items: start;
  }

  .fl-cart-page__items {
    margin: 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--color-line);
  }

  .fl-cart-page__item {
    display: grid;
    grid-template-columns: 96px minmax(0, 1fr) auto;
    grid-template-areas:
      'thumb info price'
      'thumb controls controls';
    gap: 8px 16px;
    align-items: start;
    padding: 20px 0;
    border-bottom: 1px solid var(--color-line);
  }

  .fl-cart-page__thumb {
    grid-area: thumb;
    display: block;
    width: 96px;
    aspect-ratio: var(--card-ratio);
    overflow: hidden;
    border-radius: var(--radius-card);
    background: var(--color-surface);
  }

  .fl-cart-page__thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .fl-cart-page__info {
    grid-area: info;
    display: flex;
    flex-direction: column;
    gap: 4px;
    min-width: 0;
  }

  .fl-cart-page__item-title {
    font-weight: 500;
    text-decoration: none;
  }

  .fl-cart-page__item-title:hover {
    text-decoration: underline;
  }

  .fl-cart-page__item-options,
  .fl-cart-page__unit-measure {
    font-size: 0.8125em;
    color: var(--color-muted);
  }

  .fl-cart-page__unit-price {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 8px;
    font-size: 0.875em;
  }

  .fl-cart-page__compare {
    color: var(--color-muted);
    font-weight: 400;
  }

  .fl-cart-page__discounts {
    display: flex;
    flex-direction: column;
    gap: 2px;
    margin: 4px 0 0;
    padding: 0;
    list-style: none;
    font-size: 0.8125em;
    color: var(--color-muted);
  }

  .fl-cart-page__controls {
    grid-area: controls;
    display: flex;
    align-items: center;
    gap: 16px;
    margin-top: 8px;
  }

  .fl-cart-page__qty {
    display: inline-flex;
    align-items: center;
    border: 1px solid var(--color-control-border);
    border-radius: var(--radius-btn);
  }

  .fl-cart-page__qty-btn {
    display: none;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    padding: 0;
    background: none;
    border: 0;
    color: var(--color-ink);
    cursor: pointer;
    transition: color 0.15s ease;
  }

  .fl-cart-page__qty-btn:hover {
    color: var(--color-muted);
  }

  .fl-cart-page.is-enhanced .fl-cart-page__qty-btn {
    display: inline-flex;
  }

  .fl-cart-page__qty-input {
    width: 56px;
    height: 44px;
    padding: 0 8px;
    text-align: center;
    background: transparent;
    border: 0;
    color: var(--color-ink);
    appearance: textfield;
  }

  .fl-cart-page.is-enhanced .fl-cart-page__qty-input {
    width: 40px;
    padding: 0;
  }

  .fl-cart-page__qty-input::-webkit-outer-spin-button,
  .fl-cart-page__qty-input::-webkit-inner-spin-button {
    margin: 0;
    appearance: none;
  }

  .fl-cart-page__remove {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding-block: 0;
    margin-block: -12px;
    font-size: 0.8125em;
    color: var(--color-muted);
    transition: color 0.15s ease;
  }

  .fl-cart-page__remove:hover {
    color: var(--color-ink);
  }

  .fl-cart-page__line-price {
    grid-area: price;
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 2px;
    font-weight: 500;
    white-space: nowrap;
  }

  .fl-cart-page__note {
    max-width: 480px;
    margin-top: 28px;
  }

  .fl-cart-page__summary {
    display: flex;
    flex-direction: column;
    gap: 12px;
    padding: 24px;
    background: var(--color-surface);
    border-radius: var(--radius-card);
  }

  .fl-cart-page__discount-rows {
    display: flex;
    flex-direction: column;
    gap: 6px;
    margin: 0;
    padding: 0;
    list-style: none;
    font-size: 0.875em;
    color: var(--color-muted);
  }

  .fl-cart-page__discount-row {
    display: flex;
    justify-content: space-between;
    gap: 12px;
  }

  .fl-cart-page__subtotal {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 12px;
    font-weight: 600;
  }

  .fl-cart-page__taxes {
    margin: 0;
    font-size: 0.8125em;
    color: var(--color-muted);
  }

  .fl-cart-page__update,
  .fl-cart-page__checkout {
    width: 100%;
  }

  .fl-cart-page.is-enhanced .fl-cart-page__update {
    display: none;
  }

  .fl-cart-page__continue {
    display: inline-flex;
    align-items: center;
    align-self: center;
    min-height: 44px;
    font-size: 0.875em;
    color: var(--color-muted);
    transition: color 0.15s ease;
  }

  .fl-cart-page__continue:hover {
    color: var(--color-ink);
  }

  .fl-cart-page__status {
    margin: 0;
    font-size: 0.875em;
    color: var(--color-muted);
    text-align: center;
  }

  .fl-cart-page__status:empty {
    display: none;
  }

  .fl-cart-page.is-busy .fl-cart-page__form {
    opacity: 0.6;
    pointer-events: none;
    transition: opacity 0.15s ease;
  }

  /* Below 360px the stepper and Remove no longer fit beside the thumbnail
     (the page scrolled sideways at 320px): they take the full width under it. */
  @media (max-width: 359px) {
    .fl-cart-page__item {
      grid-template-areas:
        'thumb info price'
        'controls controls controls';
    }
  }

  @media (min-width: 990px) {
    .fl-cart-page__form {
      grid-template-columns: minmax(0, 1fr) 360px;
      gap: 64px;
    }

    .fl-cart-page__summary {
      position: sticky;
      top: var(--sticky-offset);
    }

    .fl-cart-page__item {
      grid-template-columns: 96px minmax(0, 1fr) auto auto;
      grid-template-areas: 'thumb info controls price';
      gap: 24px;
      align-items: center;
    }

    .fl-cart-page__controls {
      margin-top: 0;
    }

    .fl-cart-page__line-price {
      min-width: 90px;
    }
  }
{% endstylesheet %}

{% javascript %}
  // Quantity changes update the cart in place (Ajax Cart API + Section
  // Rendering API): no page reload, focus stays on the same control, every
  // line and the totals are re-rendered, and the header's live region reads
  // the new count. Checkout, and the Update button without JS, still submit
  // the form natively.
  class FlCartPage extends HTMLElement {
    connectedCallback() {
      this.pending = {};
      this.timer = null;
      this.busy = false;
      this.again = false;
      if (!this.querySelector('form') || !this.dataset.sectionId || !window.fetch) return;
      this.classList.add('is-enhanced');
      this.onClick = this.handleClick.bind(this);
      this.onChange = this.handleChange.bind(this);
      this.onSubmit = this.handleSubmit.bind(this);
      this.addEventListener('click', this.onClick);
      this.addEventListener('change', this.onChange);
      // submit bubbles: one listener on the element survives every re-render.
      this.addEventListener('submit', this.onSubmit);
      // Back/forward from the browser's cache: re-read the cart.
      this.onPageShow = (event) => {
        if (event.persisted) this.resync();
      };
      window.addEventListener('pageshow', this.onPageShow);
      const nav = window.performance && performance.getEntriesByType ? performance.getEntriesByType('navigation')[0] : null;
      if (nav && nav.type === 'back_forward') this.resync();
    }

    disconnectedCallback() {
      window.clearTimeout(this.timer);
      this.removeEventListener('click', this.onClick);
      this.removeEventListener('change', this.onChange);
      this.removeEventListener('submit', this.onSubmit);
      window.removeEventListener('pageshow', this.onPageShow);
    }

    async resync() {
      try {
        const fresh = await fetch(this.dataset.cartUrl + '?section_id=' + encodeURIComponent(this.dataset.sectionId));
        if (fresh.ok) this.render(await fresh.text(), null, null);
      } catch (e) {
        // the page keeps what it shows
      }
    }

    lineKey(el) {
      const line = el.closest('[data-line-key]');
      return line ? line.getAttribute('data-line-key') : null;
    }

    handleClick(event) {
      const remove = event.target.closest('[data-qty-remove]');
      if (remove) {
        const key = this.lineKey(remove);
        if (!key) return;
        event.preventDefault();
        this.queue(key, 0, true);
        return;
      }
      const button = event.target.closest('[data-qty-minus], [data-qty-plus]');
      if (!button) return;
      const wrap = button.closest('[data-qty-wrap]');
      const input = wrap && wrap.querySelector('[data-qty-input]');
      const key = this.lineKey(button);
      if (!input || !key) return;
      let value = parseInt(input.value, 10);
      if (Number.isNaN(value)) value = 0;
      value = button.hasAttribute('data-qty-minus') ? Math.max(0, value - 1) : value + 1;
      input.value = value;
      this.queue(key, value, false);
    }

    handleChange(event) {
      // The order note is saved when the field is left, as in the cart drawer.
      if (event.target.matches('[name="note"]')) {
        fetch(this.dataset.updateUrl + '.js', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
          body: JSON.stringify({ note: event.target.value })
        }).catch(() => {});
        return;
      }
      const input = event.target.closest('[data-qty-input]');
      if (!input) return;
      const key = this.lineKey(input);
      if (!key) return;
      this.queue(key, Math.max(0, parseInt(input.value, 10) || 0), false);
    }

    handleSubmit() {
      window.clearTimeout(this.timer);
      this.classList.add('is-busy');
    }

    queue(key, quantity, now) {
      this.pending[key] = quantity;
      window.clearTimeout(this.timer);
      this.timer = window.setTimeout(() => this.flush(), now ? 0 : 400);
    }

    // Which control had focus, so it can be found again in the new markup.
    focusTarget() {
      const active = document.activeElement;
      if (!active || !this.contains(active)) return null;
      const key = this.lineKey(active);
      const kind = ['data-qty-minus', 'data-qty-plus', 'data-qty-input', 'data-qty-remove'].find((k) =>
        active.hasAttribute(k)
      );
      if (!key || !kind) return null;
      const keys = Array.from(this.querySelectorAll('[data-line-key]')).map((l) => l.getAttribute('data-line-key'));
      return { key, kind, index: keys.indexOf(key) };
    }

    async flush() {
      if (this.busy) {
        this.again = true;
        return;
      }
      const updates = this.pending;
      this.pending = {};
      if (!Object.keys(updates).length) return;
      this.busy = true;
      this.classList.add('is-busy');
      const focus = this.focusTarget();
      const note = this.querySelector('[name="note"]');
      const noteValue = note ? note.value : null;
      let html = null;
      let error = null;
      let cart = null;
      try {
        const response = await fetch(this.dataset.updateUrl + '.js', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
          body: JSON.stringify({ updates, sections: this.dataset.sectionId, sections_url: window.location.pathname })
        });
        const data = await response.json().catch(() => null);
        if (response.ok && data) {
          cart = data;
          html = data.sections ? data.sections[this.dataset.sectionId] : null;
        } else {
          error = (data && data.description) || this.dataset.errorText;
        }
        if (!html) {
          // Error, or no rendered section in the answer: re-read the cart so
          // the quantities on screen are the real ones.
          const fresh = await fetch(this.dataset.cartUrl + '?section_id=' + encodeURIComponent(this.dataset.sectionId));
          if (fresh.ok) html = await fresh.text();
        }
      } catch (e) {
        error = this.dataset.errorText;
      }
      if (html) this.render(html, focus, noteValue);
      if (cart && typeof cart.item_count === 'number') {
        document.dispatchEvent(new CustomEvent('fl:cart:change', { bubbles: true, detail: { itemCount: cart.item_count } }));
      }
      this.showError(error);
      this.classList.remove('is-busy');
      this.busy = false;
      if (this.again || Object.keys(this.pending).length) {
        this.again = false;
        this.flush();
      }
    }

    render(html, focus, noteValue) {
      const doc = new DOMParser().parseFromString(html, 'text/html');
      const fresh = doc.querySelector('[data-cart-page-inner]');
      const current = this.querySelector('[data-cart-page-inner]');
      if (!fresh || !current) return;
      current.innerHTML = fresh.innerHTML;
      // A note being typed is not saved by a quantity change: keep it.
      const note = this.querySelector('[name="note"]');
      if (note && noteValue !== null) note.value = noteValue;
      if (!focus) return;
      let target = null;
      const line = this.querySelector('[data-line-key="' + CSS.escape(focus.key) + '"]');
      if (line) target = line.querySelector('[' + focus.kind + ']');
      if (!target) {
        // The line is gone: the next one takes focus, or the empty state.
        const lines = this.querySelectorAll('[data-line-key]');
        const next = lines[Math.min(Math.max(focus.index, 0), lines.length - 1)];
        if (next) target = next.querySelector('[data-qty-input]');
      }
      if (!target) target = this.querySelector('.fl-cart-page__empty a') || this.querySelector('.fl-cart-page__title');
      if (target) target.focus();
    }

    // Errors are shown in the summary and read by the live region, which
    // stays outside the re-rendered markup.
    showError(message) {
      const status = this.querySelector('[data-cart-page-status]');
      const live = this.querySelector('[data-cart-page-live]');
      if (status) status.textContent = message || '';
      if (!live) return;
      live.textContent = '';
      if (message) {
        window.setTimeout(() => {
          live.textContent = message;
        }, 60);
      }
    }
  }

  if (!customElements.get('fl-cart-page')) {
    customElements.define('fl-cart-page', FlCartPage);
  }
{% endjavascript %}

