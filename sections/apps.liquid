{% comment %}
  Apps.
  Bare container for app blocks: merchants drop an app block in and the theme
  only supplies the colour scheme, the vertical rhythm and the page gutters.
  Turn “Add side margins” off to let an app run edge to edge.
{% endcomment %}

<section
  class="fl-apps full-width color-{{ section.settings.color_scheme }}"
  style="padding-block: {{ section.settings.padding_top }}px {{ section.settings.padding_bottom }}px"
>
  <div class="fl-apps__inner{% unless section.settings.include_margins %} fl-apps__inner--flush{% endunless %}">
    {%- for block in section.blocks -%}
      {% render block %}
    {%- else -%}
      {%- if request.design_mode -%}
        <p class="fl-editor-empty">{{ 'general.editor.empty_section' | t }}</p>
      {%- endif -%}
    {%- endfor -%}
  </div>
</section>

{% stylesheet %}
  .fl-apps__inner {
    width: min(calc(var(--page-width) - var(--page-margin) * 2), calc(100% - var(--page-margin) * 2));
    margin-inline: auto;
    min-width: 0;
  }

  .fl-apps__inner--flush {
    width: 100%;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:names.apps",
  "settings": [
    {
      "type": "checkbox",
      "id": "include_margins",
      "label": "t:labels.add_side_margins",
      "info": "t:info.turn_off_to_let_the_app_span",
      "default": true
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:labels.color_scheme",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "t:content.spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "t:labels.top_padding",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "t:labels.bottom_padding",
      "default": 48
    }
  ],
  "blocks": [
    {
      "type": "@app"
    }
  ],
  "presets": [
    {
      "name": "t:names.apps"
    }
  ]
}
{% endschema %}
