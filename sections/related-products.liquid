{% comment %}
  Related products (product template).
  <fl-related> lazily fetches Shopify recommendations via the Section
  Rendering API (routes.product_recommendations_url) when the section nears
  the viewport, then swaps in the returned grid.
  Until the answer arrives, the server renders a placeholder of the same shape
  (heading + four cards at the card ratio), so the footer no longer jumps when
  the grid lands: the empty section measured a CLS of 0.622 on a direct jump to
  the bottom of the page on mobile. The placeholder is aria-hidden and holds no
  link; the script replaces it with the grid, or empties the section when the
  product has no recommendation.
{% endcomment %}

{%- liquid
  assign heading = section.settings.heading | escape
  if heading == blank
    assign heading = 'products.related.heading' | t
  endif
-%}

<fl-related
  class="fl-related"
  {% if product %}
    data-url="{{ routes.product_recommendations_url }}?section_id={{ section.id }}&product_id={{ product.id }}&limit=4&intent={{ section.settings.intent | default: 'related' }}"
  {% endif %}
>
  {%- if recommendations.performed? -%}
    {%- if recommendations.products_count > 0 -%}
      <div
        class="fl-related__inner"
        style="padding-block: {{ section.settings.padding_top }}px {{ section.settings.padding_bottom }}px"
      >
        <div class="fl-section-head">
          <h2>{{ heading }}</h2>
        </div>
        <div class="fl-product-grid" style="--grid-cols: 4; --grid-cols-tablet: 3; --grid-cols-mobile: 2">
          {%- for rec in recommendations.products -%}
            {% render 'product-card', product: rec %}
          {%- endfor -%}
        </div>
      </div>
    {%- endif -%}
  {%- else -%}
    {%- comment -%}
      First render, inside the product page: the recommendations are not known
      yet. The placeholder carries the same classes as a real card, so the
      reserved height follows the card style, the image ratio, the vendor line
      and the quick-view button of the theme settings.
    {%- endcomment -%}
    {%- assign ghost_classes = 'fl-card fl-related__ghost' -%}
    {%- if settings.card_style == 'card' -%}
      {%- assign ghost_classes = ghost_classes | append: ' fl-card--boxed color-' | append: settings.card_color_scheme -%}
    {%- endif -%}
    <div
      class="fl-related__inner fl-related__skeleton"
      style="padding-block: {{ section.settings.padding_top }}px {{ section.settings.padding_bottom }}px"
      aria-hidden="true"
    >
      <div class="fl-section-head">
        <h2>{{ heading }}</h2>
      </div>
      <div class="fl-product-grid" style="--grid-cols: 4; --grid-cols-tablet: 3; --grid-cols-mobile: 2">
        {%- for i in (1..4) -%}
          <article class="{{ ghost_classes }}">
            <div class="fl-card__media">
              <div class="fl-related__ghost-media"></div>
            </div>
            <div class="fl-card__info">
              {%- if settings.card_show_vendor -%}
                <span class="fl-related__ghost-line fl-related__ghost-line--vendor"></span>
              {%- endif -%}
              <span class="fl-related__ghost-line"></span>
              <span class="fl-related__ghost-line fl-related__ghost-line--price"></span>
              {%- if settings.quick_view_enabled -%}
                <span class="fl-related__ghost-btn"></span>
              {%- endif -%}
            </div>
          </article>
        {%- endfor -%}
      </div>
    </div>
  {%- endif -%}
</fl-related>

{% stylesheet %}
  .fl-related {
    display: block;
  }

  /* Shown only once <fl-related> is defined, which takes the section's own
     JavaScript: with scripts off the recommendations never arrive, and a grey
     grid left in place for good would be worse than no section at all. */
  .fl-related__skeleton {
    display: none;
  }

  fl-related:defined .fl-related__skeleton {
    display: block;
  }

  /* Placeholder. Each bar takes the height of the text it stands in for, so the
     card is exactly as tall as the real one; the tint is the surface colour of
     the scheme, never a flashing animation. */
  .fl-related__ghost-media {
    width: 100%;
    aspect-ratio: var(--card-ratio);
    border-radius: var(--radius-card);
    background: var(--color-surface);
  }

  /* 1.5em is the height a line of this text really takes (font size times the
     normal line height), so the placeholder card is as tall as a real one. */
  .fl-related__ghost-line {
    height: 1.5em;
    width: 70%;
    border-radius: 2px;
    background: var(--color-surface);
  }

  .fl-related__ghost-line--vendor {
    width: 40%;
    font-size: 0.8125em;
  }

  .fl-related__ghost-line--price {
    width: 30%;
  }

  .fl-related__ghost-btn {
    margin-top: auto;
    min-height: 44px;
    border-radius: var(--radius-btn);
    background: var(--color-surface);
  }
{% endstylesheet %}

{% javascript %}
  if (!customElements.get('fl-related')) {
    customElements.define(
      'fl-related',
      class extends HTMLElement {
        connectedCallback() {
          if (this.dataset.loaded) return;
          const url = this.dataset.url;
          if (!url) return;
          const load = () => {
            if (this.dataset.loaded) return;
            this.dataset.loaded = 'true';
            fetch(url)
              .then((response) => {
                if (!response.ok) throw new Error(String(response.status));
                return response.text();
              })
              .then((text) => {
                const doc = new DOMParser().parseFromString(text, 'text/html');
                const fresh = doc.querySelector('fl-related');
                // The placeholder is always replaced, including by an empty
                // answer: left in place it would keep standing in for cards
                // that are never going to come.
                this.innerHTML = fresh ? fresh.innerHTML : '';
              })
              .catch(() => {
                this.innerHTML = '';
              });
          };
          if ('IntersectionObserver' in window) {
            this.observer = new IntersectionObserver(
              (entries) => {
                entries.forEach((entry) => {
                  if (entry.isIntersecting) {
                    this.observer.disconnect();
                    load();
                  }
                });
              },
              // Fetched about a screen ahead: content arriving while the
              // section is already in view pushed the footer down (layout
              // shift) on a quick scroll.
              { rootMargin: '1000px 0px' }
            );
            this.observer.observe(this);
          } else {
            load();
          }
        }

        disconnectedCallback() {
          if (this.observer) this.observer.disconnect();
        }
      }
    );
  }
{% endjavascript %}

{% schema %}
{
  "name": "Related products",
  "settings": [
    {
      "type": "select",
      "id": "intent",
      "label": "Recommendation type",
      "info": "Complementary products are the ones you pair by hand in the free Shopify Search & Discovery app. Add this section a second time to show both.",
      "options": [
        {
          "value": "related",
          "label": "Related products (automatic)"
        },
        {
          "value": "complementary",
          "label": "Complementary products (Search & Discovery)"
        }
      ],
      "default": "related"
    },
    {
      "type": "paragraph",
      "content": "Automatic recommendations based on the current product. Use on the product template."
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "info": "Leave blank to use the default heading."
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 48
    }
  ],
  "enabled_on": { "templates": ["product"] },
  "presets": [
    { "name": "Related products" },
    { "name": "Complementary products", "settings": { "intent": "complementary", "heading": "Goes well with" } }
  ]
}
{% endschema %}
