{% comment %}
  Related products (product template).
  <fl-related> lazily fetches Shopify recommendations via the Section
  Rendering API (routes.product_recommendations_url) when the section nears
  the viewport, then swaps in the returned grid.
  Until the answer arrives, the server renders a placeholder of the same shape
  (heading + four cards at the card ratio), so the footer no longer jumps when
  the grid lands: the empty section measured a CLS of 0.622 on a direct jump to
  the bottom of the page on mobile. The placeholder is aria-hidden and holds no
  link; the script replaces it with the grid. When the product has no
  recommendation, the emptied section keeps its height while it is on screen
  and folds away once out of view, so the footer never jumps in sight.
{% endcomment %}

{%- liquid
  assign heading = section.settings.heading | escape
  if heading == blank
    assign heading = 'products.related.heading' | t
  endif
-%}

<fl-related
  class="fl-related"
  data-error-text="{{ 'products.related.error' | t }}"
  {% if product %}
    data-url="{{ routes.product_recommendations_url }}?section_id={{ section.id }}&product_id={{ product.id }}&limit=4&intent={{ section.settings.intent | default: 'related' }}"
  {% endif %}
>
  {%- if recommendations.performed? -%}
    {%- if recommendations.products_count > 0 -%}
      <div
        class="fl-related__inner"
        style="padding-block: {{ section.settings.padding_top }}px {{ section.settings.padding_bottom }}px"
      >
        <div class="fl-section-head">
          <h2>{{ heading }}</h2>
        </div>
        <div class="fl-product-grid" style="--grid-cols: 4; --grid-cols-tablet: 3; --grid-cols-mobile: 2">
          {%- for rec in recommendations.products -%}
            {% render 'product-card', product: rec %}
          {%- endfor -%}
        </div>
      </div>
    {%- endif -%}
  {%- else -%}
    {%- comment -%}
      First render, inside the product page: the recommendations are not known
      yet. The placeholder carries the same classes as a real card, so the
      reserved height follows the card style, the image ratio, the vendor line
      and the quick-view button of the theme settings.
    {%- endcomment -%}
    {%- assign ghost_classes = 'fl-card fl-related__ghost' -%}
    {%- if settings.card_style == 'card' -%}
      {%- assign ghost_classes = ghost_classes | append: ' fl-card--boxed color-' | append: settings.card_color_scheme -%}
    {%- endif -%}
    <div
      class="fl-related__inner fl-related__skeleton"
      style="padding-block: {{ section.settings.padding_top }}px {{ section.settings.padding_bottom }}px"
      aria-hidden="true"
    >
      <div class="fl-section-head">
        <h2>{{ heading }}</h2>
      </div>
      <div class="fl-product-grid" style="--grid-cols: 4; --grid-cols-tablet: 3; --grid-cols-mobile: 2">
        {%- for i in (1..4) -%}
          <article class="{{ ghost_classes }}">
            <div class="fl-card__media">
              <div class="fl-related__ghost-media"></div>
            </div>
            <div class="fl-card__info">
              {%- if settings.card_show_vendor -%}
                <span class="fl-related__ghost-line fl-related__ghost-line--vendor"></span>
              {%- endif -%}
              <span class="fl-related__ghost-line fl-related__ghost-line--title"></span>
              <span class="fl-related__ghost-line fl-related__ghost-line--price"></span>
              {%- if settings.card_quick_add or settings.quick_view_enabled -%}
                <span class="fl-related__ghost-quick">
                  {%- if settings.card_quick_add -%}
                    <span class="fl-related__ghost-btn"></span>
                  {%- endif -%}
                  {%- if settings.quick_view_enabled -%}
                    <span class="fl-related__ghost-btn"></span>
                  {%- endif -%}
                </span>
              {%- endif -%}
            </div>
          </article>
        {%- endfor -%}
      </div>
    </div>
  {%- endif -%}
</fl-related>

{% stylesheet %}
  .fl-related {
    display: block;
  }

  .fl-related__error {
    width: var(--content-width);
    margin: 24px auto;
    color: var(--color-muted);
  }

  /* Shown only once <fl-related> is defined, which takes the section's own
     JavaScript: with scripts off the recommendations never arrive, and a grey
     grid left in place for good would be worse than no section at all. */
  .fl-related__skeleton {
    display: none;
  }

  fl-related:defined .fl-related__skeleton {
    display: block;
  }

  /* Placeholder. Each bar takes the height of the text it stands in for, so the
     card is exactly as tall as the real one; the tint is the surface colour of
     the scheme, never a flashing animation. */
  .fl-related__ghost-media {
    width: 100%;
    aspect-ratio: var(--card-ratio);
    border-radius: var(--radius-card);
    background: var(--color-surface);
  }

  /* Heights taken from a real card measured on the demo, so the reserved block
     is the height of the one that replaces it: vendor 21 px, title 18, price
     26, buttons 102 (10 px of padding, two 44 px buttons, a 4 px gap), plus the
     three 4 px gaps of .fl-card__info = 179 px. The shorter bars of 1.8.17 left
     the footer moving when the grid landed (+56 px at 1440, +162 px at 390).
     A title that wraps to two lines on a narrow screen still moves it a little:
     the theme cannot know the merchant's product names in advance. */
  .fl-related__ghost-line {
    height: 1.15em;
    width: 70%;
    border-radius: 2px;
    background: var(--color-surface);
  }

  .fl-related__ghost-line--vendor {
    width: 40%;
    height: 1.6em;
    font-size: 0.8125em;
  }

  .fl-related__ghost-line--title {
    width: 70%;
  }

  .fl-related__ghost-line--price {
    width: 30%;
    height: 1.6em;
  }

  /* Same box as .fl-card__quick: pushed to the bottom, one column, 4 px apart. */
  .fl-related__ghost-quick {
    display: flex;
    flex-direction: column;
    gap: 4px;
    margin-top: auto;
    padding-top: 10px;
  }

  .fl-related__ghost-btn {
    min-height: 44px;
    border-radius: var(--radius-btn);
    background: var(--color-surface);
  }

  /* Two columns on a phone: the card is 165px wide, where a product name wraps
     to a second line and a sale price drops its compare price below the
     current one (measured at 390 on the demo: title 18.4 -> 36.8px, price
     25.6 -> 59.2px, so the row grew 52px when the grid landed). The
     placeholder cannot know which product will wrap, so inside this grid both
     lines are reserved on the real cards too: every card is then exactly as
     tall as the block it replaces, and the footer does not move. Above 749px
     the card is wide enough that nothing wraps, and nothing is reserved. */
  @media screen and (max-width: 749px) {
    .fl-related .fl-card__title {
      min-height: 2.3em;
    }

    .fl-related .fl-price {
      min-height: 3.7em;
    }

    .fl-related__ghost-line--title {
      height: 2.3em;
    }

    .fl-related__ghost-line--price {
      height: 3.7em;
    }
  }
{% endstylesheet %}

{% javascript %}
  if (!customElements.get('fl-related')) {
    customElements.define(
      'fl-related',
      class extends HTMLElement {
        connectedCallback() {
          if (this.dataset.loaded) return;
          const url = this.dataset.url;
          if (!url) return;
          const load = () => {
            if (this.dataset.loaded) return;
            this.dataset.loaded = 'true';
            fetch(url)
              .then((response) => {
                if (!response.ok) throw new Error(String(response.status));
                return response.text();
              })
              .then((text) => {
                const doc = new DOMParser().parseFromString(text, 'text/html');
                const fresh = doc.querySelector('fl-related');
                const html = fresh ? fresh.innerHTML.trim() : '';
                // The placeholder is always replaced, including by an empty
                // answer: left in place it would keep standing in for cards
                // that are never going to come.
                if (html) {
                  this.innerHTML = html;
                } else {
                  this.release();
                }
              })
              .catch(() => {
                // Optional content: the reserved space is released and a
                // short status line says the suggestions could not load.
                this.release(this.dataset.errorText || '');
              });
          };
          if ('IntersectionObserver' in window) {
            this.observer = new IntersectionObserver(
              (entries) => {
                entries.forEach((entry) => {
                  if (entry.isIntersecting) {
                    this.observer.disconnect();
                    load();
                  }
                });
              },
              // Fetched about a screen ahead: content arriving while the
              // section is already in view pushed the footer down (layout
              // shift) on a quick scroll.
              { rootMargin: '1000px 0px' }
            );
            this.observer.observe(this);
          } else {
            load();
          }
        }

        /* No grid to show (empty answer or error). Removing the placeholder
           while it is on screen pulls the footer up (layout shift): the
           space is kept, emptied, and given back only once the section is
           out of view, where the change moves nothing the visitor sees
           (scroll anchoring keeps the page still when it is above). */
        release(message) {
          const rect = this.getBoundingClientRect();
          const inView = rect.bottom > 0 && rect.top < window.innerHeight;
          if (inView && 'IntersectionObserver' in window) {
            this.style.minHeight = rect.height + 'px';
            this.releaseObserver = new IntersectionObserver((entries) => {
              entries.forEach((entry) => {
                if (entry.isIntersecting) return;
                this.releaseObserver.disconnect();
                this.style.minHeight = '';
              });
            });
            this.releaseObserver.observe(this);
          }
          this.innerHTML = '';
          if (!message) return;
          const status = document.createElement('p');
          status.className = 'fl-related__error';
          status.setAttribute('role', 'status');
          status.textContent = message;
          this.appendChild(status);
        }

        disconnectedCallback() {
          if (this.observer) this.observer.disconnect();
          if (this.releaseObserver) this.releaseObserver.disconnect();
        }
      }
    );
  }
{% endjavascript %}

{% schema %}
{
  "name": "t:names.related_products",
  "settings": [
    {
      "type": "select",
      "id": "intent",
      "label": "t:labels.recommendation_type",
      "info": "t:info.complementary_products_are_the_ones_you_pair",
      "options": [
        {
          "value": "related",
          "label": "t:labels.related_products_automatic"
        },
        {
          "value": "complementary",
          "label": "t:labels.complementary_products_search_discovery"
        }
      ],
      "default": "related"
    },
    {
      "type": "paragraph",
      "content": "t:content.automatic_recommendations_based_on_the_current_produ"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:labels.heading",
      "info": "t:info.leave_blank_to_use_the_default_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "t:labels.top_padding",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "t:labels.bottom_padding",
      "default": 48
    }
  ],
  "enabled_on": {
    "templates": [
      "product"
    ]
  },
  "presets": [
    {
      "name": "t:names.related_products"
    },
    {
      "name": "t:names.complementary_products",
      "settings": {
        "intent": "complementary",
        "heading": "Goes well with"
      }
    }
  ]
}
{% endschema %}
