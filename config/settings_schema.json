[
  {
    "name": "theme_info",
    "theme_name": "FLYER",
    "theme_version": "1.10.2",
    "theme_author": "KIOSK",
    "theme_documentation_url": "https://kioskthemes.com/docs/flyer/",
    "theme_support_url": "https://kioskthemes.com/support/"
  },
  {
    "name": "t:names.logo",
    "settings": [
      {
        "type": "image_picker",
        "id": "logo",
        "label": "t:labels.logo_image"
      },
      {
        "type": "range",
        "id": "logo_width",
        "min": 50,
        "max": 300,
        "step": 10,
        "unit": "px",
        "label": "t:labels.logo_width",
        "default": 120
      },
      {
        "type": "image_picker",
        "id": "favicon",
        "label": "t:labels.favicon",
        "info": "t:info.displayed_at_32_32_px"
      }
    ]
  },
  {
    "name": "t:names.colors",
    "settings": [
      {
        "type": "color_scheme_group",
        "id": "color_schemes",
        "definition": [
          {
            "type": "color",
            "id": "background",
            "label": "t:labels.background",
            "default": "#FFFFFF"
          },
          {
            "type": "color_background",
            "id": "background_gradient",
            "label": "t:labels.background_gradient",
            "info": "t:info.replaces_the_background_color_where_supported"
          },
          {
            "type": "color",
            "id": "text",
            "label": "t:labels.text",
            "default": "#1A1A1A"
          },
          {
            "type": "color",
            "id": "button",
            "label": "t:labels.solid_button_background",
            "default": "#1A1A1A"
          },
          {
            "type": "color",
            "id": "button_label",
            "label": "t:labels.solid_button_label",
            "default": "#FFFFFF"
          },
          {
            "type": "color",
            "id": "secondary_button_label",
            "label": "t:labels.outline_button_label",
            "default": "#1A1A1A"
          },
          {
            "type": "color",
            "id": "shadow",
            "label": "t:labels.shadow",
            "default": "#1A1A1A"
          }
        ],
        "role": {
          "text": "text",
          "background": {
            "solid": "background",
            "gradient": "background_gradient"
          },
          "links": "secondary_button_label",
          "icons": "text",
          "primary_button": "button",
          "on_primary_button": "button_label",
          "primary_button_border": "button",
          "secondary_button": "background",
          "on_secondary_button": "secondary_button_label",
          "secondary_button_border": "secondary_button_label"
        }
      }
    ]
  },
  {
    "name": "t:names.typography",
    "settings": [
      {
        "type": "header",
        "content": "t:content.headings"
      },
      {
        "type": "font_picker",
        "id": "type_heading_font",
        "default": "work_sans_n5",
        "label": "t:labels.heading_font"
      },
      {
        "type": "range",
        "id": "type_heading_scale",
        "min": 100,
        "max": 160,
        "step": 5,
        "unit": "%",
        "label": "t:labels.heading_scale",
        "default": 135
      },
      {
        "type": "select",
        "id": "type_heading_case",
        "label": "t:labels.heading_capitalization",
        "options": [
          {
            "value": "none",
            "label": "t:labels.sentence_case"
          },
          {
            "value": "uppercase",
            "label": "t:labels.uppercase"
          }
        ],
        "default": "none"
      },
      {
        "type": "header",
        "content": "t:content.body"
      },
      {
        "type": "font_picker",
        "id": "type_body_font",
        "default": "work_sans_n4",
        "label": "t:labels.body_font"
      },
      {
        "type": "range",
        "id": "type_base_size",
        "min": 14,
        "max": 18,
        "step": 1,
        "unit": "px",
        "label": "t:labels.base_font_size",
        "default": 16
      },
      {
        "type": "range",
        "id": "type_body_scale",
        "min": 100,
        "max": 130,
        "step": 5,
        "unit": "%",
        "label": "t:labels.body_scale",
        "default": 100
      }
    ]
  },
  {
    "name": "t:names.layout",
    "settings": [
      {
        "type": "range",
        "id": "max_page_width",
        "min": 1000,
        "max": 1800,
        "step": 20,
        "unit": "px",
        "label": "t:labels.page_width",
        "default": 1280,
        "info": "t:info.up_to_1800px_for_very_large_screens"
      },
      {
        "type": "range",
        "id": "min_page_margin",
        "min": 12,
        "max": 60,
        "step": 2,
        "unit": "px",
        "label": "t:labels.page_margin",
        "default": 24
      },
      {
        "type": "range",
        "id": "section_spacing",
        "min": 0,
        "max": 100,
        "step": 4,
        "unit": "px",
        "label": "t:labels.space_between_sections",
        "default": 0
      },
      {
        "type": "range",
        "id": "spacing_grid_horizontal",
        "min": 4,
        "max": 40,
        "step": 4,
        "unit": "px",
        "label": "t:labels.horizontal_grid_spacing",
        "default": 20
      },
      {
        "type": "range",
        "id": "spacing_grid_vertical",
        "min": 4,
        "max": 40,
        "step": 4,
        "unit": "px",
        "label": "t:labels.vertical_grid_spacing",
        "default": 28
      },
      {
        "type": "checkbox",
        "id": "section_numbering",
        "label": "t:labels.number_section_headings",
        "info": "t:info.adds_01_02_03_in_front_of",
        "default": true
      }
    ]
  },
  {
    "name": "t:names.animations",
